@model Symphony.Portal.Web.Models.ViewModels.LoginVM
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Welcome Back</h2>
            <p>Vui lòng đăng nhập để tiếp tục</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group-icon">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" placeholder="Email hoặc Tên đăng nhập" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" placeholder="Mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            
            <div class="d-flex justify-content-between mb-3" style="font-size: 0.9em;">
                <div class="form-check">
                   <input class="form-check-input" asp-for="RememberMe" />
                   <label class="form-check-label" asp-for="RememberMe">Ghi nhớ đăng nhập</label>
                </div>
                <a href="#" class="text-decoration-none">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-primary-auth">Đăng nhập</button>
        </form>

        <div class="auth-footer">
            Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
