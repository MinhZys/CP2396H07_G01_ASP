@model Symphony.Portal.Web.Models.ViewModels.RegisterVM
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Tạo tài khoản mới</h2>
            <p>Chào mừng bạn đến với Symphony Training</p>
        </div>

        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group-icon">
                <i class="bi bi-person"></i>
                <input asp-for="FullName" placeholder="Họ và tên" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group-icon">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" placeholder="Email công ty" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" placeholder="Mật khẩu (Tối thiểu 8 ký tự)" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group-icon">
                <i class="bi bi-shield-lock"></i>
                <input asp-for="ConfirmPassword" placeholder="Xác nhận mật khẩu" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary-auth">Đăng ký -></button>
        </form>

        <div class="auth-footer">
            Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng nhập ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
