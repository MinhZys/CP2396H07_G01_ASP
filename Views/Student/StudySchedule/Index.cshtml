@model List<Symphony.Portal.Web.Models.ClassSession>

@{
    ViewData["Title"] = "Study Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var from = (DateTime)(ViewBag.From ?? DateTime.Today);
    var to = (DateTime)(ViewBag.To ?? DateTime.Today.AddDays(6));

    var totalSessions = Model?.Count ?? 0;

    var totalMinutes = 0;
    if (Model != null)
    {
        foreach (var s in Model)
        {
            totalMinutes += (int)(s.EndTime - s.StartTime).TotalMinutes;
        }
    }

    var totalHoursText = totalMinutes <= 0
        ? "—"
        : $"{totalMinutes / 60}h {totalMinutes % 60}m";

    var groups = (Model ?? new List<Symphony.Portal.Web.Models.ClassSession>())
        .OrderBy(x => x.SessionDate)
        .ThenBy(x => x.StartTime)
        .GroupBy(x => x.SessionDate.Date)
        .ToList();
}

<div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="mb-6">
        <div class="text-sm text-slate-500 dark:text-slate-400 mb-2">
            Student / Study Schedule
        </div>

        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
            <div>
                <h1 class="font-display text-2xl md:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                    Study Schedule
                </h1>
                <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                    @from.ToString("yyyy-MM-dd") → @to.ToString("yyyy-MM-dd")
                </div>

                @if (ViewBag.ClassId != null)
                {
                    <div class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                        Class: <span class="font-semibold text-slate-700 dark:text-slate-200">@ViewBag.ClassId</span>
                    </div>
                }
            </div>

            <!-- Filter -->
            <form method="get" class="w-full md:w-auto">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
                            From
                        </label>
                        <input type="date"
                               name="from"
                               value="@from.ToString("yyyy-MM-dd")"
                               class="w-full rounded-lg bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-primary" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
                            To
                        </label>
                        <input type="date"
                               name="to"
                               value="@to.ToString("yyyy-MM-dd")"
                               class="w-full rounded-lg bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-1 focus:ring-primary" />
                    </div>

                    <div class="flex items-end">
                        <button type="submit"
                                class="w-full rounded-lg bg-primary text-background-dark font-bold px-4 py-2 hover:opacity-90 transition-opacity">
                            Apply
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="mb-6 rounded-xl border border-amber-200/60 dark:border-amber-400/20 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 text-amber-900 dark:text-amber-200">
            @ViewBag.Message
        </div>
    }

    <!-- Summary cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 shadow-sm">
            <div class="p-5">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Total sessions
                </div>
                <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white">
                    @totalSessions
                </div>
            </div>
        </div>

        <div class="rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 shadow-sm">
            <div class="p-5">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                    Total study time
                </div>
                <div class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white">
                    @totalHoursText
                </div>
            </div>
        </div>
    </div>

    <!-- Table card (giống style admin form) -->
    <div class="rounded-xl bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">

        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
            <h2 class="font-display text-xl font-bold text-primary">
                Sessions
            </h2>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Your study sessions in the selected date range.
            </p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="px-6 py-10 text-center text-slate-500 dark:text-slate-400">
                No sessions in this range.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50 dark:bg-white/5 border-b border-slate-200 dark:border-slate-700">
                        <tr class="text-left">
                            <th class="px-6 py-3 font-bold text-slate-600 dark:text-slate-300">Date</th>
                            <th class="px-6 py-3 font-bold text-slate-600 dark:text-slate-300">Time</th>
                            <th class="px-6 py-3 font-bold text-slate-600 dark:text-slate-300">Room</th>
                            <th class="px-6 py-3 font-bold text-slate-600 dark:text-slate-300">Type</th>
                            <th class="px-6 py-3 font-bold text-slate-600 dark:text-slate-300">Note</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                        @foreach (var g in groups)
                        {
                            var isToday = g.Key == DateTime.Today;

                            <tr class="bg-slate-50/70 dark:bg-white/5">
                                <td colspan="5" class="px-6 py-3">
                                    <div class="flex items-center gap-3">
                                        <span class="font-bold text-slate-800 dark:text-slate-100">
                                            @g.Key.ToString("yyyy-MM-dd")
                                        </span>

                                        @if (isToday)
                                        {
                                            <span class="text-xs font-bold px-2 py-1 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-200 border border-emerald-500/25">
                                                Today
                                            </span>
                                        }

                                        <span class="text-xs text-slate-500 dark:text-slate-400">
                                            @g.Count() session(s)
                                        </span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var s in g)
                            {
                                <tr class="@(s.IsCancelled ? "opacity-60 line-through" : "") hover:bg-slate-50 dark:hover:bg-white/5 transition-colors">
                                    <td class="px-6 py-4 text-slate-700 dark:text-slate-200">
                                        @s.SessionDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="px-6 py-4 text-slate-700 dark:text-slate-200">
                                        <span class="font-semibold">@s.StartTime.ToString(@"hh\:mm")</span>
                                        <span class="text-slate-400 mx-1">→</span>
                                        <span class="font-semibold">@s.EndTime.ToString(@"hh\:mm")</span>
                                    </td>

                                    <td class="px-6 py-4 text-slate-700 dark:text-slate-200">
                                        @(s.Room?.Name ?? "—")
                                    </td>

                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold border @SessionTypeBadge(s.SessionType)">
                                            @SessionTypeLabel(s.SessionType)
                                        </span>
                                    </td>

                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-300">
                                        @if (s.IsCancelled)
                                        {
                                            <span class="text-red-600 dark:text-red-300 font-semibold">
                                                Cancelled
                                                @if (!string.IsNullOrWhiteSpace(s.CancelReason))
                                                {
                                                    <span class="font-normal">— @s.CancelReason</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(s.Note) ? "—" : s.Note)
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    // Tailwind badge class (bg + text + border)
    public string SessionTypeBadge(Symphony.Portal.Web.Models.SessionType type)
    {
        return type switch
        {
            Symphony.Portal.Web.Models.SessionType.Theory =>
                "bg-slate-100 text-slate-700 border-slate-200 dark:bg-white/10 dark:text-slate-200 dark:border-white/10",

            Symphony.Portal.Web.Models.SessionType.Lab =>
                "bg-sky-100 text-sky-700 border-sky-200 dark:bg-sky-500/15 dark:text-sky-200 dark:border-sky-500/20",

            Symphony.Portal.Web.Models.SessionType.Revision =>
                "bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-500/15 dark:text-amber-200 dark:border-amber-500/20",

            Symphony.Portal.Web.Models.SessionType.MockTest =>
                "bg-rose-100 text-rose-700 border-rose-200 dark:bg-rose-500/15 dark:text-rose-200 dark:border-rose-500/20",

            Symphony.Portal.Web.Models.SessionType.Other =>
                "bg-zinc-100 text-zinc-700 border-zinc-200 dark:bg-white/10 dark:text-slate-200 dark:border-white/10",

            _ =>
                "bg-slate-100 text-slate-700 border-slate-200 dark:bg-white/10 dark:text-slate-200 dark:border-white/10"
        };
    }

    // label đẹp hơn thay vì MockTest/Revision
    public string SessionTypeLabel(Symphony.Portal.Web.Models.SessionType type)
    {
        return type switch
        {
            Symphony.Portal.Web.Models.SessionType.Theory => "Theory",
            Symphony.Portal.Web.Models.SessionType.Lab => "Lab",
            Symphony.Portal.Web.Models.SessionType.Revision => "Revision",
            Symphony.Portal.Web.Models.SessionType.MockTest => "Mock Test",
            Symphony.Portal.Web.Models.SessionType.Other => "Other",
            _ => type.ToString()
        };
    }
}
