@model Symphony.Portal.Web.Models.Lesson

@{
    ViewData["Title"] = "Lesson Details";
}

<h2>@Model.Title</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Course:</strong> @Model.Course?.Title</p>
        <p><strong>Subject:</strong> @Model.Subject?.Name</p>
        <p><strong>Duration:</strong> @Model.DurationMinutes minutes</p>
      


        @if (!string.IsNullOrEmpty(Model.ContentLink))
        {
            <p>
                <strong>Content:</strong>
                <a href="@Model.ContentLink" target="_blank">Open Lesson</a>
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="@Model.Image" class="img-fluid mt-2" />
        }
        @if (!string.IsNullOrEmpty(Model.ContentLink))
        {
            <div class="alert alert-info mt-4">
                <h5 class="alert-heading"><i class="fas fa-file-download me-2"></i>Lesson Material</h5>
                <a href="@Model.ContentLink" target="_blank" class="btn btn-primary">
                    Download / View File
                </a>
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>
