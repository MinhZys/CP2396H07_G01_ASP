@model IEnumerable<Symphony.Portal.Web.Models.Material>

@{
    ViewData["Title"] = "Materials - " + ViewData["ClassName"];
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="fas fa-folder-open me-2"></i>Materials for @ViewData["ClassName"]
        </h2>
        <a asp-controller="Student" asp-action="ViewClasses" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to My Classes
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> No materials uploaded for this class yet.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                // Xử lý icon dựa trên loại file
                var iconClass = "fa-file-alt"; // Mặc định
                if (!string.IsNullOrEmpty(item.FileType))
                {
                    if (item.FileType.Contains("PDF", StringComparison.OrdinalIgnoreCase)) { iconClass = "fa-file-pdf"; }
                    else if (item.FileType.Contains("Word", StringComparison.OrdinalIgnoreCase)) { iconClass = "fa-file-word"; }
                    else if (item.FileType.Contains("Excel", StringComparison.OrdinalIgnoreCase)) { iconClass = "fa-file-excel"; }
                    else if (item.FileType.Contains("Video", StringComparison.OrdinalIgnoreCase) || item.FileType.Contains("MP4", StringComparison.OrdinalIgnoreCase)) { iconClass = "fa-video"; }
                }

                <div class="alert alert-info shadow-sm border-0 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4">

                    <div class="flex-grow-1 mb-3 mb-md-0 pe-md-4">
                        <h4 class="alert-heading fw-bold text-dark">
                            <i class="fas @iconClass me-2 text-primary"></i>@item.Title
                        </h4>

                        <p class="mb-2 text-secondary">
                            @(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)
                        </p>

                        <div class="d-flex align-items-center gap-3 text-muted small">
                            <span><i class="far fa-calendar-alt me-1"></i> Uploaded: @item.UploadDate.ToString("dd/MM/yyyy")</span>
                            <span class="badge bg-light text-dark border">@item.FileType</span>
                        </div>
                    </div>

                    <div class="flex-shrink-0">
                        <a asp-controller="Student"
                           asp-action="DownloadMaterialFile"
                           asp-route-id="@item.Id"
                           class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                            <i class="fas fa-download me-2"></i>Download / View File
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>