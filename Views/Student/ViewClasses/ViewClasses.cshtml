@model IEnumerable<Symphony.Portal.Web.Models.ClassAssignment>

@{
    ViewData["Title"] = "My Classroom";
}

<h2 class="text-2xl font-bold mb-6 text-white">My Classroom</h2>

@if (Model == null || !Model.Any())
{
    <div class="bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 px-4 py-3 rounded-xl">
        You have not been assigned to any class yet.
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-surface-dark border border-slate-700 rounded-xl p-5 shadow flex flex-col h-full">
                <div class="flex-grow">
                    <h3 class="text-lg font-bold text-primary mb-2">
                        @item.Class?.ClassName
                    </h3>
                    <p class="text-sm text-slate-400">
                        Category: <span class="text-white">@item.Class?.ClassCategory?.Name</span>
                    </p>
                    <p class="text-sm text-slate-400">
                        Seats: <span class="text-white">@item.Class?.NumberOfSeats</span>
                    </p>
                    <p class="text-xs text-slate-500 mt-2">
                        Assigned at: @item.AssignedAt.ToString("dd/MM/yyyy")
                    </p>
                </div>

                <div class="mt-4 pt-4 border-t border-slate-700">
                    <a asp-controller="Student"
                       asp-action="ViewLessons"
                       asp-route-classId="@item.ClassId"
                       class="block w-full text-center bg-primary hover:bg-primary-dark text-white font-medium py-2 px-4 rounded-lg transition-colors duration-200">
                        View Lessons
                    </a>
                </div>
            </div>
        }
    </div>
}