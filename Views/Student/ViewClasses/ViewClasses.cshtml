@model IEnumerable<Symphony.Portal.Web.Models.ClassAssignment>

@{
    ViewData["Title"] = "My Classroom";
}

<h2 class="text-2xl font-bold mb-6">My Classroom</h2>

@if (Model == null || !Model.Any())
{
    <div class="bg-yellow-500/10 border border-yellow-500/30 text-yellow-400 px-4 py-3 rounded-xl">
        You have not been assigned to any class yet.
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-surface-dark border border-slate-700 rounded-xl p-5 shadow">
                <h3 class="text-lg font-bold text-primary mb-2">
                    @item.Class?.ClassName
                </h3>
                <p class="text-sm text-slate-400">
                    Category: @item.Class?.ClassCategory?.Name
                </p>
                <p class="text-sm text-slate-400">
                    Seats: @item.Class?.NumberOfSeats
                </p>
                <p class="text-xs text-slate-500 mt-2">
                    Assigned at: @item.AssignedAt.ToString("dd/MM/yyyy")
                </p>
                <button class="bg-white/5 border border-white/10 dark:bg-surface-dark px-8 py-4 rounded-lg font-bold font-display hover:bg-white/10 transition-all"
                        onclick="location.href='@Url.Action("Index", "Lessons", new { area = "Student" })'">
                    <span data-i18n="View Lessons">View Lessons</span>
                </button>
            </div>

        }
    </div>
}
