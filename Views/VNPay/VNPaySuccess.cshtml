@model Symphony.Portal.Web.Models.VNPayTransaction

@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="min-h-screen flex items-center justify-center bg-background-dark">
    <div class="bg-surface-dark border border-slate-800 rounded-xl p-8 text-center max-w-lg w-full">
        <h2 class="text-2xl font-bold text-green-500 mb-4">
            🎉 Thanh toán thành công
        </h2>

        <div class="text-slate-300 space-y-2 mb-6">
            <p>
                <strong>Mã giao dịch:</strong>
                <span class="text-slate-100">@Model.VnpTxnRef</span>
            </p>

            <p>
                <strong>Số tiền:</strong>
                <span class="text-slate-100">
                    @Model.Payment.Amount.ToString("N0") đ
                </span>
            </p>

        </div>

        <a href="/" class="btn btn-primary">
            Về trang chủ
        </a>
    </div>
</div>
