@model Symphony.Portal.Web.Models.VNPayTransaction
@{
    ViewData["Title"] = "Payment Success";
}

<div class="container py-5 text-center">
    <div class="alert alert-success shadow-lg rounded-3 p-5">
        <h2 class="mb-3">🎉 Payment Successful</h2>
        <p class="text-muted">Transaction ID: <strong>@Model.VnpTransactionNo</strong></p>
        <p>Amount: <strong>@(Model.VnpAmount / 100).ToString("N0") đ</strong></p>
        <p>Bank: <strong>@Model.VnpBankCode</strong></p>

        <hr />

        <p>Your examination application is <b>awaiting administrator approval</b>.</p>

        <a href="/" class="btn btn-primary mt-3">
            Back to Home
        </a>
    </div>
</div>
