@model Symphony.Portal.Web.Models.VNPayTransaction
@{
    ViewData["Title"] = "Payment Failed";
}

<div class="container py-5 text-center">
    <div class="alert alert-danger shadow-lg rounded-3 p-5">
        <h2 class="mb-3">❌ Payment Failed</h2>
        <p>VNPay Error Code: <strong>@Model.VnpResponseCode</strong></p>

        <hr />

        <a href="/Guests/Payment/@Model.Payment.GuestId"
           class="btn btn-warning mt-3">
            Retry Payment
        </a>
    </div>
</div>
