@model IEnumerable<Symphony.Portal.Web.Models.StudentExamSession>

@{
    ViewData["Title"] = "My Exam Results";
}

<div class="container py-4">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h1><i class="fas fa-graduation-cap text-success"></i> My Exam Results</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="fas fa-info-circle"></i> You haven't taken any exams yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var isClassExam = item.ClassExam != null;
                var isPublished = !isClassExam || (item.ClassExam?.IsScorePublished ?? false);
                // var isPublished = (isClassExam && (item.ClassExam?.IsScorePublished ?? false)) || 
                //                   (!isClassExam && (item.EntranceExam?.IsScorePublished ?? false));

                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow border-0 overflow-hidden">
                        <div class="p-1 @(item.GradeLevel == "Level A" ? "bg-success" : (item.GradeLevel == "Level B" ? "bg-info" : "bg-warning"))"></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title fw-bold mb-1">
                                        @(item.EntranceExam?.Title ?? item.ClassExam?.Course?.Title + " (Final Exam)")
                                    </h5>
                                    <span class="badge bg-light text-dark border">@item.ExamPaper?.Title</span>
                                </div>
                                <div class="text-end">
                                    @if (isPublished)
                                    {
                                        <div class="h4 mb-0 text-primary">@item.TotalScore.ToString("0.##")</div>
                                        <small class="text-muted d-block">Score</small>
                                    }
                                    else
                                    {
                                         <div class="h4 mb-0 text-muted"><i class="fas fa-hourglass-half"></i></div>
                                         <small class="text-muted d-block">Pending</small>
                                    }
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6 border-end">
                                    <div class="small text-muted mb-1">Exam Date</div>
                                    <div class="fw-bold">@item.StartTime?.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6 ps-3">
                                    <div class="small text-muted mb-1">Result</div>
                                    <div class="fw-bold">
                                        @if (isPublished)
                                        {
                                            @if (!string.IsNullOrEmpty(item.GradeLevel))
                                            {
                                                <span class="badge @(item.GradeLevel == "Level A" ? "bg-success" : (item.GradeLevel == "Level B" ? "bg-info" : "bg-danger"))">
                                                    @item.GradeLevel
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Graded</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">
                                                Waiting for Results
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid mt-3">
                                @if (isPublished)
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary shadow-sm">
                                        View Details & Feedback
                                    </a>
                                }
                                else
                                {
                                    <button disabled class="btn btn-light text-muted border">
                                        <i class="fas fa-lock me-2"></i> Results not yet published
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
