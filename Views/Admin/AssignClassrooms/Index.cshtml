@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.ClassAssignment>

@{
    ViewData["Title"] = "Assign Classrooms";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-primary">Assign Classrooms</h6>

        <div>
            <a asp-action="Create" class="btn btn-sm btn-primary me-2">
                Manual Assign
            </a>

            <a asp-action="AssignByScore" class="btn btn-sm btn-success">
                Assign By Score
            </a>
        </div>
    </div>

    <div class="card-body">

        <!-- ========================= -->
        <!-- INFO -->
        <!-- ========================= -->
        <div class="alert alert-info mb-3">
            <b>Tip:</b> Use <i>Assign By Score</i> to automatically assign students
            based on their entrance exam scores (high → low).
        </div>

        <!-- ========================= -->
        <!-- TABLE -->
        <!-- ========================= -->
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Class</th>
                    <th>Category</th>
                    <th>Assigned At</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No class assignments found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Student?.FullName</td>
                            <td>@item.Class?.ClassName</td>
                            <td>@item.Class?.ClassCategory?.Name</td>
                            <td>@item.AssignedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning me-1">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    <partial name="_Pagination" model="Model" />
</div>
