@using Symphony.Portal.Web.Models
@{
    ViewData["Title"] = "Assign By Score";
    var students = ViewBag.Students as List<ExamResult>;
    var classes = ViewBag.Classes as List<Class>;
    decimal? minScore = ViewBag.MinScore;
}

<h2>Assign Students By Score</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- ========================= -->
<!-- FILTER FORM -->
<!-- ========================= -->
<form asp-action="AssignByScore" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Minimum Score</label>
            <input type="number"
                   step="0.1"
                   name="minScore"
                   value="@(minScore?.ToString() ?? "")"
                   class="form-control"
                   placeholder="Enter minimum score" />
        </div>
        <div class="col-md-3 align-self-end">
            <button type="submit" class="btn btn-primary">
                Filter Students
            </button>
        </div>
    </div>
</form>

@if (students != null && students.Any())
{
    <form asp-action="AssignByScoreConfirm" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="minScore" value="@minScore" />

        <!-- ========================= -->
        <!-- CLASS SELECTION -->
        <!-- ========================= -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Select Class</label>
                <select name="classId" class="form-select" required>
                    <option value="">-- Select Class --</option>
                    @foreach (var c in classes)
                    {
                        <option value="@c.Id">
                            @c.ClassName (@c.NumberOfSeats seats left)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3 align-self-end">
                <button type="submit" class="btn btn-success">
                    Assign All
                </button>
            </div>
        </div>

        <!-- ========================= -->
        <!-- STUDENT TABLE -->
        <!-- ========================= -->
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Student Name</th>
                    <th>Score</th>
                    <th>Exam</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }

                @foreach (var s in students)
                {
                    <tr>
                        <td>@index</td>
                        <td>@s.Student?.FullName</td>
                        <td>@s.Score</td>
                        <td>@s.EntranceExamId</td>
                    </tr>

                    index++;
                }
            </tbody>
        </table>
    </form>
}
else if (minScore != null)
{
    <div class="alert alert-warning">
        No students found with score ≥ @minScore
    </div>
}
