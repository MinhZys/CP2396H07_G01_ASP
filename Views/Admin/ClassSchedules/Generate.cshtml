@model Symphony.Portal.Web.ViewModels.Schedule.GenerateScheduleVM

@{
    ViewData["Title"] = "Generate Sessions";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Generate Sessions</h2>
        <div class="text-muted small">Sinh buổi học theo template (skip Holiday + check conflict)</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ScheduleId">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Generate" asp-route-id="@Model.ScheduleId" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input asp-for="ScheduleId" type="hidden" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">FromDate</label>
                    <input asp-for="FromDate" class="form-control" type="date" />
                    <span asp-validation-for="FromDate" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">ToDate</label>
                    <input asp-for="ToDate" class="form-control" type="date" />
                    <span asp-validation-for="ToDate" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">StartTime</label>
                    <input asp-for="StartTime" class="form-control" type="time" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">EndTime</label>
                    <input asp-for="EndTime" class="form-control" type="time" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Days of week (ISO)</label>
                    <div class="d-flex flex-wrap gap-3">
                        @{
                            // ISO: 1..7 (Mon..Sun)
                            var days = new (int val, string text)[] {
                        (1,"Mon"), (2,"Tue"), (3,"Wed"), (4,"Thu"), (5,"Fri"), (6,"Sat"), (7,"Sun")
                                        };
                        }
                        @foreach (var d in days)
                        {
                            var isChecked = Model.DaysOfWeek != null && Model.DaysOfWeek.Contains(d.val);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="DaysOfWeek" value="@d.val" id="dow_@d.val"
                                @(isChecked ? "checked" : "") />
                                <label class="form-check-label" for="dow_@d.val">@d.text</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="DaysOfWeek" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Room</label>
                    <select asp-for="RoomId" class="form-select">
                        <option value="">-- None --</option>
                        @if (ViewBag.Rooms != null)
                        {
                            foreach (var r in ViewBag.Rooms)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Instructor</label>
                    <select asp-for="InstructorId" class="form-select">
                        <option value="">-- None --</option>
                        @if (ViewBag.Instructors != null)
                        {
                            foreach (var u in ViewBag.Instructors)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">SessionType</label>
                    <select asp-for="SessionType" class="form-select"
                            asp-items="Html.GetEnumSelectList<Symphony.Portal.Web.Models.SessionType>()">
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Note</label>
                    <textarea asp-for="Note" class="form-control" rows="2" placeholder="Optional note..."></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Generate</button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ScheduleId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
