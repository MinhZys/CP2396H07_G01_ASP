@model Symphony.Portal.Web.Models.ClassSchedule

@{
    ViewData["Title"] = "Schedule Details";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">Schedule #@Model.Id</h2>
        <div class="text-muted small">
            Class: <span class="fw-semibold">@Model.ClassId</span> — @Model.Class?.ClassName
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-outline-info" asp-action="Sessions" asp-route-id="@Model.Id">Sessions</a>

        @if (!Model.IsLocked)
        {
            <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-primary" asp-action="Generate" asp-route-id="@Model.Id">Generate</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-2">
                    <span class="text-muted">Range</span>
                    <div class="fw-semibold">
                        @Model.StartDate.ToString("yyyy-MM-dd")
                        →
                        @(Model.EndDate?.ToString("yyyy-MM-dd") ?? "—")
                    </div>
                </div>

                <div class="mb-2">
                    <span class="text-muted">Status</span>
                    <div><span class="badge bg-info text-dark">@Model.Status</span></div>
                </div>

                <div class="mb-2">
                    <span class="text-muted">Published</span>
                    <div>
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">Yes</span>
                            <div class="small text-muted">@Model.PublishedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <span class="text-muted">Lock</span>
                    <div>
                        @if (Model.IsLocked)
                        {
                            <span class="badge bg-danger">Locked</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Open</span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (!Model.IsPublished && !Model.IsLocked)
                    {
                        <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Publish schedule #@Model.Id ?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-success" type="submit">Publish</button>
                        </form>
                    }

                    @if (!Model.IsLocked)
                    {
                        <form asp-action="Lock" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Lock schedule #@Model.Id ? After lock, cannot edit/generate.');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger" type="submit">Lock</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Unlock" asp-route-id="@Model.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Unlock schedule #@Model.Id ?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-warning" type="submit">Unlock</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="fw-semibold">Sessions (preview)</div>
                <div class="text-muted small">Top 20 upcoming / earliest</div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Room</th>
                                <th>Type</th>
                                <th>Cancelled</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sessions = Model.Sessions?
                                .OrderBy(s => s.SessionDate).ThenBy(s => s.StartTime)
                                .Take(20).ToList() ?? new List<Symphony.Portal.Web.Models.ClassSession>();
                            }

                            @if (!sessions.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">No sessions yet.</td></tr>
                            }
                            else
                            {
                                foreach (var s in sessions)
                                {
                                    <tr>
                                        <td>@s.SessionDate.ToString("yyyy-MM-dd")</td>
                                        <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                                        <td>@(s.Room?.Name ?? "—")</td>
                                        <td><span class="badge bg-secondary">@s.SessionType</span></td>
                                        <td>
                                            @if (s.IsCancelled)
                                            {
                                                <span class="badge bg-warning text-dark">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end">
                <a class="btn btn-outline-info" asp-action="Sessions" asp-route-id="@Model.Id">Manage all sessions</a>
            </div>
        </div>
    </div>
</div>
