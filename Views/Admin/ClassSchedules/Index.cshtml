@model List<Symphony.Portal.Web.Models.ClassSchedule>

@{
    ViewData["Title"] = "Class Schedules";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Class Schedules</h2>
        <div class="text-muted small">Quản lý lịch theo lớp (Draft/Published/Locked)</div>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Create Schedule</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="classId" value="@Context.Request.Query["classId"]" class="form-control" placeholder="Filter by ClassId..." />
    </div>
    <div class="col-md-8 d-flex gap-2">
        <button class="btn btn-outline-light" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Class</th>
                        <th>Range</th>
                        <th>Status</th>
                        <th>Published</th>
                        <th>Locked</th>
                        <th style="width:210px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No schedules found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Id</td>
                                <td>
                                    <div class="fw-semibold">@s.ClassId</div>
                                    <div class="small text-muted">@s.Class?.ClassName</div>
                                </td>
                                <td>
                                    <div>@s.StartDate.ToString("yyyy-MM-dd")</div>
                                    <div class="small text-muted">
                                        @(s.EndDate.HasValue ? s.EndDate.Value.ToString("yyyy-MM-dd") : "—")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@s.Status</span>
                                </td>
                                <td>
                                    @if (s.IsPublished)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                        <div class="small text-muted">@((s.PublishedAt?.ToString("yyyy-MM-dd HH:mm")) ?? "")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (s.IsLocked)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Open</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@s.Id">Details</a>
                                    <a class="btn btn-sm btn-outline-info" asp-action="Sessions" asp-route-id="@s.Id">Sessions</a>

                                    @if (!s.IsLocked)
                                    {
                                        <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                                    }

                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete schedule #' + @s.Id + '? This will remove all sessions too if cascade is enabled.');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
