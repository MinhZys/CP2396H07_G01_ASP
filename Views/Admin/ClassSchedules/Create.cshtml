@model Symphony.Portal.Web.ViewModels.Schedule.CreateScheduleVM

@{
    ViewData["Title"] = "Create Schedule";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Create Schedule</h2>
        <div class="text-muted small">Tạo lịch mới cho 1 lớp</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- ✅ FIX: ClassId → Dropdown chọn Class -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Class</label>
                    <select asp-for="ClassId" class="form-select">
                        <option value="">-- Select class --</option>
                        @if (ViewBag.Classes != null)
                        {
                            foreach (var c in ViewBag.Classes)
                            {
                                <option value="@c.Id">@c.ClassName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Start Date</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Date</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">
                    <i class="fas fa-plus me-1"></i>
                    Create
                </button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
