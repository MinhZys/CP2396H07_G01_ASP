@model List<Symphony.Portal.Web.Models.ClassSession>

@{
    ViewData["Title"] = "Schedule Sessions";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    var schedule = ViewBag.Schedule as Symphony.Portal.Web.Models.ClassSchedule;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">Sessions</h2>
        @if (schedule != null)
        {
            <div class="text-muted small">
                Schedule #@schedule.Id — Class: <span class="fw-semibold">@schedule.ClassId</span> (@schedule.Class?.ClassName)
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        @if (schedule != null)
        {
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@schedule.Id">Back</a>
            @if (!schedule.IsLocked)
            {
                <a class="btn btn-primary" asp-action="Generate" asp-route-id="@schedule.Id">Generate</a>
            }
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Room</th>
                        <th>Instructor</th>
                        <th>Type</th>
                        <th>Note</th>
                        <th>Cancelled</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No sessions.</td></tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.SessionDate.ToString("yyyy-MM-dd")</td>
                                <td>@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</td>
                                <td>@(s.Room?.Name ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(s.InstructorId) ? "—" : s.InstructorId)</td>
                                <td><span class="badge bg-secondary">@s.SessionType</span></td>
                                <td class="text-muted small">@s.Note</td>
                                <td>
                                    @if (s.IsCancelled)
                                    {
                                        <span class="badge bg-warning text-dark">Yes</span>
                                        <div class="small text-muted">@s.CancelReason</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
