@model Symphony.Portal.Web.ViewModels.Schedule.CreateScheduleVM

@{
    ViewData["Title"] = "Edit Schedule";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    var scheduleId = (int)(ViewBag.ScheduleId ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Edit Schedule #@scheduleId</h2>
        <div class="text-muted small">Chỉ sửa thời gian (Class sẽ được khóa, không cho thay đổi)</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@scheduleId">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@scheduleId" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- ✅ Show Class Name (readonly) -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Class</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-users"></i>
                        </span>
                        <input class="form-control" value="@(Model.ClassName ?? "(Unknown)")" readonly />
                    </div>

                    <div class="form-text">
                        ClassId: <span class="fw-semibold">@Model.ClassId</span>
                    </div>

                    <!-- ✅ Keep ClassId posted but locked -->
                    <input asp-for="ClassId" type="hidden" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Start Date</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Date</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-warning" type="submit">
                    <i class="fas fa-save me-1"></i>
                    Save
                </button>
                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@scheduleId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
