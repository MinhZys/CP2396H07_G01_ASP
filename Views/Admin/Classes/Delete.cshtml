@model Symphony.Portal.Web.Models.Class

@{
    ViewData["Title"] = "Delete Class";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-danger">Delete Class</h6>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
             <i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this class? This action cannot be undone.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Class Name</dt>
            <dd class="col-sm-9">@Model.ClassName</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.ClassCategory?.Name</dd>

            <dt class="col-sm-3">Number of Seats</dt>
            <dd class="col-sm-9">@Model.NumberOfSeats</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
