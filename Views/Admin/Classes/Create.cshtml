@model Symphony.Portal.Web.Models.Class

@{
    ViewData["Title"] = "Create Class";
}

<h2>Create Class</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ClassName" class="control-label"></label>
                <input asp-for="ClassName" class="form-control" />
                <span asp-validation-for="ClassName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NumberOfSeats" class="control-label"></label>
                <input asp-for="NumberOfSeats" class="form-control" />
                <span asp-validation-for="NumberOfSeats" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Fee" class="control-label">Fee (VND)</label>
                <input asp-for="Fee" class="form-control" type="number" step="0.01" min="0" placeholder="Enter class fee" />
                <span asp-validation-for="Fee" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ClassCategoryId" class="control-label">Category (Required)</label>
                <select asp-for="ClassCategoryId" class="form-control" asp-items="ViewBag.ClassCategories">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="ClassCategoryId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CourseId" class="control-label">Course (Optional)</label>
                <select asp-for="CourseId" class="form-control" asp-items="ViewBag.Courses">
                    <option value="">-- Select Course (NULL) --</option>
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<Symphony.Portal.Web.Models.Enums.ClassStatus>()"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <!-- Room removed from here. Use Assign Classroom page. -->
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
