@model Symphony.Portal.Web.Models.Class

@{
    ViewData["Title"] = "Class Details";
}

<h2>Class Details: @Model.Name</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Course?.Title</dd>
        
        <dt class="col-sm-2">Instructor</dt>
        <dd class="col-sm-10">@(Model.Instructor?.FullName ?? "Unassigned")</dd>
        
        <dt class="col-sm-2">Duration</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</dd>
        
        <dt class="col-sm-2">Type</dt>
        <dd class="col-sm-10">@(Model.IsOnline ? "Online" : "Offline")</dd>
        
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Room</dd>
        
        <dt class="col-sm-2">Total Students</dt>
        <dd class="col-sm-10">@Model.Enrollments.Count(e => e.IsApproved)</dd>
    </dl>
</div>

<h3>Enrolled Students</h3>
<table class="table table-sm">
    <thead>
        <tr>
             <th>Student Name</th>
             <th>Email</th>
             <th>Joined Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var e in Model.Enrollments.Where(x => x.IsApproved))
        {
            <tr>
                <td>@e.Student?.FullName</td>
                <td>@e.Student?.Email</td>
                <td>@e.EnrolledDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
