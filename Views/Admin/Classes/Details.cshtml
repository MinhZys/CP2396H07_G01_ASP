@model Symphony.Portal.Web.Models.Class

@{
    ViewData["Title"] = "Class Details";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Class Details: @Model.ClassName</h6>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Class Name</dt>
            <dd class="col-sm-9">@Model.ClassName</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.ClassCategory?.Name</dd>

            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">@(Model.Course?.Title ?? "N/A")</dd>

            <dt class="col-sm-3">Number of Seats</dt>
            <dd class="col-sm-9">@Model.NumberOfSeats</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status == Symphony.Portal.Web.Models.Enums.ClassStatus.Active ? "bg-success" : "bg-secondary")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToShortDateString()</dd>
        </dl>
        
        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
