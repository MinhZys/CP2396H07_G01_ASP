@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.Guest>
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "Manage Guest Registrations";
    string currentStatus = ViewBag.CurrentStatus as string;
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Guest Registrations</h6>
        <div>
            <a href="@Url.Action("Index", new { status = "PendingPayment", pageNumber = 1 })" class="btn btn-sm btn-secondary">Pending Payment</a>
            <a href="@Url.Action("Index", new { status = "PaidPendingApproval", pageNumber = 1 })" class="btn btn-sm btn-warning">Needs Approval</a>
            <a href="@Url.Action("Index", new { status = "Approved", pageNumber = 1 })" class="btn btn-sm btn-success">Approved</a>
            <a href="@Url.Action("Index", new { pageNumber = 1 })" class="btn btn-sm btn-outline-secondary">All</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
         @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Exam Info</th>
                        <th>Account Info</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.CreatedAt.ToShortDateString()</td>
                            <td>
                                @item.FullName
                            </td>
                            <td>@item.Email</td>
                            <td>
                                <strong>@item.SelectedEntranceExam?.Title</strong>
                                @{
                                    var roomDisplay = item.ExamRoom ?? item.Class?.ClassName;
                                }
                                @if(!string.IsNullOrEmpty(roomDisplay)) {
                                    <br/><small class="text-info">Room: @roomDisplay</small>
                                }
                            </td>
                            <td>
                                @if (item.Status == GuestRegistrationStatus.Approved && item.User != null)
                                {
                                    <div>
                                        <strong>Account:</strong> @item.User.Email<br/>
                                        <strong>Pass:</strong> 
                                        <span class="text-danger fw-bold password-masked">********</span>
                                        <span class="text-danger fw-bold password-actual d-none">@item.User.Password</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-decoration-none toggle-password-btn" onclick="togglePersonalPass(this)">
                                            <i class="fas fa-eye text-muted"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">---</span>
                                }
                            </td>
                            <td>
                                @if(item.Status == GuestRegistrationStatus.PaidPendingApproval) {
                                    <span class="badge bg-warning text-dark">Paid - Pending Approval</span>
                                } else if (item.Status == GuestRegistrationStatus.Approved) {
                                    <span class="badge bg-success">Approved</span>
                                } else if (item.Status == GuestRegistrationStatus.Rejected) {
                                    <span class="badge bg-danger">Rejected</span>
                                } else {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == GuestRegistrationStatus.PaidPendingApproval)
                                {
                                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal" 
                                            data-id="@item.Id" 
                                            data-name="@item.FullName" 
                                            data-exam="@item.SelectedEntranceExam?.Title"
                                            data-exam-date="@item.SelectedEntranceExam?.ExamDate.ToString("dd/MM/yyyy")">
                                        Approve
                                    </button>
                                    
                                    <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reject this registration?');">Reject</button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this record?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
</div>

<!-- Approval Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="Approve" method="post">
          <div class="modal-header">
            <h5 class="modal-title" id="approveModalLabel">Approve Registration</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="id" id="approveGuestId" />
            
            <div class="mb-3">
                <label class="form-label">Guest Name</label>
                <input type="text" class="form-control" id="approveGuestName" readonly>
            </div>
            <div class="mb-3">
                <label class="form-label">Registered Exam</label>
                <div class="input-group">
                    <input type="text" class="form-control" id="approveGuestExam" readonly>
                    <span class="input-group-text" id="approveGuestExamDate"></span>
                </div>
            </div>
            
            <hr/>
            <h6 class="text-primary">Assign Details</h6>
            
            <h6 class="text-primary">Assign Details</h6>
            
            <!-- Exam Room input removed as per request, will use Class Name -->

            <div class="mb-3">
                <label for="classId" class="form-label">Assign to Class (Optional)</label>
                <select name="classId" id="classId" class="form-select" asp-items="ViewBag.Classes">
                    <option value="">-- No Class Assignment --</option>
                </select>
                <div id="classDetails" class="alert alert-info mt-2 d-none"></div>
            </div>

            <div class="mb-3">
                <label for="examTime" class="form-label">Exam Time</label>
                <input type="time" class="form-control" name="examTime" id="examTime">
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Notes / Description</label>
                <textarea class="form-control" name="description" id="description" rows="3" placeholder="Enter any notes..."></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success">Confirm Approval</button>
          </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        var classesData = @Html.Raw(Json.Serialize(ViewBag.ClassesList));

        var approveModal = document.getElementById('approveModal');
        var classSelect = document.getElementById('classId');
        var classDetailsDiv = document.getElementById('classDetails');

        approveModal.addEventListener('show.bs.modal', function (event) {
            // Button that triggered the modal
            var button = event.relatedTarget;
            // Extract info from data-* attributes
            var guestId = button.getAttribute('data-id');
            var guestName = button.getAttribute('data-name');
            var guestExam = button.getAttribute('data-exam');
            var guestExamDate = button.getAttribute('data-exam-date');
            
            // Update the modal's content.
            var modalIdInput = approveModal.querySelector('#approveGuestId');
            var modalNameInput = approveModal.querySelector('#approveGuestName');
            var modalExamInput = approveModal.querySelector('#approveGuestExam');
            var modalExamDateSpan = approveModal.querySelector('#approveGuestExamDate');
            
            modalIdInput.value = guestId;
            modalNameInput.value = guestName;
            modalExamInput.value = guestExam;
            modalExamDateSpan.textContent = guestExamDate || 'N/A';
            
            // Reset fields
            document.getElementById('examTime').value = '';
            document.getElementById('description').value = '';
            classSelect.value = '';
            classDetailsDiv.classList.add('d-none');
        });

        classSelect.addEventListener('change', function() {
            var selectedId = this.value;
            if (selectedId) {
                var selectedClass = classesData.find(c => c.id == selectedId);
                if (selectedClass) {
                    var categoryName = selectedClass.classCategory ? selectedClass.classCategory.name : 'N/A';
                    var remaining = selectedClass.remainingSeats;
                    var seatClass = remaining > 0 ? "text-success" : "text-danger";
                    
                    classDetailsDiv.innerHTML = `
                        <strong>Class Details:</strong><br/>
                        Category: ${categoryName}<br/>
                        Seats: ${selectedClass.numberOfSeats} <span class="${seatClass} fw-bold">(Remaining: ${remaining})</span><br/>
                        Status: ${selectedClass.status === 0 ? 'Active' : 'Inactive'}
                    `;
                    classDetailsDiv.classList.remove('d-none');
                }
            } else {
                classDetailsDiv.classList.add('d-none');
            }
        });

        function togglePersonalPass(btn) {
            const container = btn.closest('div');
            const masked = container.querySelector('.password-masked');
            const actual = container.querySelector('.password-actual');
            const icon = btn.querySelector('i');

            if (actual.classList.contains('d-none')) {
                actual.classList.remove('d-none');
                masked.classList.add('d-none');
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                actual.classList.add('d-none');
                masked.classList.remove('d-none');
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}
