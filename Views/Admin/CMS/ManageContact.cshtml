@model Symphony.Portal.Web.Models.ViewModels.ManageContactVM
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Manage Contact";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<style>
    /* Nhẹ thôi: chỉ chỉnh chút spacing, không “đè” Bootstrap */
    .page-header h2 {
        margin: 0;
    }

    .muted {
        color: #6c757d;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .msg-preview {
        max-width: 520px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start page-header mb-4">
        <div>
            <h2 class="fw-bold">Contact Management</h2>
            <div class="muted">Manage centers (map points) & inbox messages from the contact form.</div>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to CMS</a>
    </div>

    <div class="row g-4">

        <!-- ===================== PART 1: CENTERS ===================== -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Centers (Map Addresses)</div>
                    <small class="text-muted">Tip: Edit nên làm Modal (khỏi hidden inline)</small>
                </div>

                <div class="card-body">

                    <form asp-action="CreateCenter" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-md-4">
                            <label class="form-label">Center name <span class="text-danger">*</span></label>
                            <input name="Name" class="form-control" placeholder="Enter center name" required />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Address</label>
                            <input name="Address" class="form-control" placeholder="Enter address" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Phone</label>
                            <input name="Phone" class="form-control" placeholder="Enter phone" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Hours</label>
                            <input name="OpenHours" class="form-control" placeholder="Mon-Fri 08:30-17:30" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Display order</label>
                            <input name="DisplayOrder" class="form-control" type="number" value="0" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Latitude</label>
                            <input name="Latitude" class="form-control" placeholder="Lat" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Longitude</label>
                            <input name="Longitude" class="form-control" placeholder="Lng" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="IsActive" class="form-select">
                                <option value="true" selected>Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" type="submit">Add Center</button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:60px;">#</th>
                                    <th>Name</th>
                                    <th>Address</th>
                                    <th style="width:140px;">Phone</th>
                                    <th style="width:180px;">Hours</th>
                                    <th style="width:160px;">Lat / Lng</th>
                                    <th style="width:110px;">Active</th>
                                    <th style="width:240px;" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Centers == null || !Model.Centers.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            No centers yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in Model.Centers)
                                    {
                                        <tr>
                                            <td>@c.DisplayOrder</td>
                                            <td class="fw-semibold">@c.Name</td>
                                            <td>@c.Address</td>
                                            <td>@c.Phone</td>
                                            <td>@c.OpenHours</td>
                                            <td>@(c.Latitude?.ToString() ?? "-") / @(c.Longitude?.ToString() ?? "-")</td>
                                            <td>
                                                @if (c.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-2 flex-wrap justify-content-end">

                                                    <!-- Giữ nguyên logic hiện tại -->
                                                    <form asp-action="EditCenter" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Id" value="@c.Id" />
                                                        <input type="hidden" name="Name" value="@c.Name" />
                                                        <input type="hidden" name="Address" value="@c.Address" />
                                                        <input type="hidden" name="Phone" value="@c.Phone" />
                                                        <input type="hidden" name="OpenHours" value="@c.OpenHours" />
                                                        <input type="hidden" name="Latitude" value="@c.Latitude" />
                                                        <input type="hidden" name="Longitude" value="@c.Longitude" />
                                                        <input type="hidden" name="DisplayOrder" value="@c.DisplayOrder" />
                                                        <input type="hidden" name="IsActive" value="@c.IsActive" />
                                                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                                    </form>

                                                    <form asp-action="DeleteCenter" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@c.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger js-delete">Delete</button>
                                                    </form>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!-- ===================== PART 2: MESSAGES ===================== -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div class="fw-semibold">Contact Messages (Inbox)</div>
                    <small class="text-muted">Hàng vàng = tin mới chưa đọc</small>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:170px;">Time</th>
                                    <th style="width:220px;">From</th>
                                    <th style="width:180px;">Email</th>
                                    <th style="width:180px;">Center</th>
                                    <th>Message</th>
                                    <th style="width:240px;" class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Messages == null || !Model.Messages.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            No messages yet.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var m in Model.Messages)
                                    {
                                        <tr class="@(m.IsRead ? "" : "table-warning")">
                                            <td>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="fw-semibold">@m.FullName</span>
                                                @if (!m.IsRead)
                                                {
                                                    <span class="badge bg-danger ms-2">NEW</span>
                                                }
                                            </td>
                                            <td>@m.Email</td>
                                            <td>@(m.Center?.Name ?? "-")</td>
                                            <td>
                                                <div class="msg-preview" data-full="@HtmlEncoder.Default.Encode(m.Message ?? "")">
                                                    @m.Message
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary js-view-msg">
                                                        View
                                                    </button>

                                                    <form asp-action="MarkMessageRead" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@m.Id" />
                                                        <button class="btn btn-sm btn-outline-success" type="submit">Mark Read</button>
                                                    </form>

                                                    <form asp-action="DeleteMessage" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@m.Id" />
                                                        <button class="btn btn-sm btn-outline-danger js-delete" type="submit">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="msgModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="msgModalBody" style="white-space:pre-wrap; overflow-wrap:anywhere;"></div>
        </div>
    </div>
</div>

<script>
    // confirm delete
    document.addEventListener("click", function (e) {
        const btn = e.target.closest(".js-delete");
        if (!btn) return;
        if (!confirm("Delete this item?")) e.preventDefault();
    });

    // view message modal (Bootstrap)
    const modalEl = document.getElementById("msgModal");
    const modalBody = document.getElementById("msgModalBody");

    document.addEventListener("click", function (e) {
        const viewBtn = e.target.closest(".js-view-msg");
        if (!viewBtn) return;

        const row = viewBtn.closest("tr");
        const preview = row.querySelector(".msg-preview");
        const full = preview?.getAttribute("data-full") || "";

        modalBody.textContent = full; // safe XSS
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
    });
</script>
