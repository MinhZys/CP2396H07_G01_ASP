@model Symphony.Portal.Web.Models.PageContent

@{
    ViewData["Title"] = "Create Page";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Create Page</h2>
    <a asp-action="ManagePages" class="btn btn-secondary">Back</a>
</div>

<form asp-action="CreatePage" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">

        <div class="col-12 col-lg-6">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control" placeholder="about-us" />
            <span asp-validation-for="Slug" class="text-danger"></span>
            <div class="form-text">
                Slug nên là chữ thường, dùng dấu gạch ngang. Ví dụ: <code>about-us</code>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" placeholder="About Us" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <!-- CONTENT: plain text -->
        <div class="col-12">
            <label asp-for="Content" class="form-label">Content</label>

            <textarea asp-for="Content"
                      class="form-control"
                      rows="14"
                      placeholder="Nhập nội dung bình thường... (Enter để xuống dòng)"></textarea>

            <span asp-validation-for="Content" class="text-danger"></span>

            <div class="form-text">
                Bạn có thể nhập chữ bình thường, không cần HTML.
                (Nếu bạn vẫn nhập HTML, hệ thống có thể render HTML — tuỳ bạn cấu hình ở frontend.)
            </div>
        </div>

        <!-- MULTI IMAGES (1-10) -->
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <strong>Images</strong>
                        <div class="text-muted small">Chọn 1–10 ảnh. Preview + xoá từng ảnh trước khi submit.</div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearImages">Clear</button>
                </div>

                <div class="card-body">
                    <input type="file"
                           name="imageFiles"
                           id="imageFiles"
                           class="form-control"
                           accept="image/*"
                           multiple />

                    <div class="form-text mt-2">Tối đa <strong>10</strong> ảnh.</div>

                    <div class="alert alert-danger mt-3 d-none" id="imgError"></div>

                    <div class="mt-3">
                        <div class="small text-muted mb-2">
                            Selected: <strong><span id="imgCount">0</span></strong>/10
                        </div>
                        <div class="row g-3" id="previewGrid"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Publish this page</label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-success" id="btnSubmit">Create Page</button>
            <a asp-action="ManagePages" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const MAX = 10;

            const input = document.getElementById('imageFiles');
            const grid = document.getElementById('previewGrid');
            const imgCount = document.getElementById('imgCount');
            const imgError = document.getElementById('imgError');
            const btnClear = document.getElementById('btnClearImages');
            const btnSubmit = document.getElementById('btnSubmit');

            let selected = [];

            function showError(msg) {
                imgError.textContent = msg;
                imgError.classList.remove('d-none');
                btnSubmit.disabled = true;
            }

            function clearError() {
                imgError.textContent = '';
                imgError.classList.add('d-none');
                btnSubmit.disabled = false;
            }

            function syncInputFiles() {
                const dt = new DataTransfer();
                selected.forEach(f => dt.items.add(f));
                input.files = dt.files;
            }

            function formatBytes(bytes) {
                const units = ['B', 'KB', 'MB', 'GB'];
                let v = bytes;
                let i = 0;
                while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
                return `${v.toFixed(i === 0 ? 0 : 1)} ${units[i]}`;
            }

            function render() {
                grid.innerHTML = '';
                imgCount.textContent = String(selected.length);

                if (selected.length === 0) {
                    clearError();
                    return;
                }

                if (selected.length > MAX) {
                    showError(`Bạn đang chọn ${selected.length} ảnh. Tối đa cho phép ${MAX} ảnh.`);
                } else {
                    clearError();
                }

                selected.forEach((file, idx) => {
                    const col = document.createElement('div');
                    col.className = 'col-12 col-sm-6 col-md-4 col-lg-3';

                    const card = document.createElement('div');
                    card.className = 'border rounded p-2 h-100';

                    const img = document.createElement('img');
                    img.style.width = '100%';
                    img.style.height = '140px';
                    img.style.objectFit = 'cover';
                    img.style.borderRadius = '10px';
                    img.alt = file.name;

                    const url = URL.createObjectURL(file);
                    img.src = url;
                    img.onload = () => URL.revokeObjectURL(url);

                    const meta = document.createElement('div');
                    meta.className = 'mt-2 small';
                    meta.innerHTML = `
                        <div class="text-truncate" title="${file.name}">
                            <strong>${file.name}</strong>
                        </div>
                        <div class="text-muted">${formatBytes(file.size)}</div>
                    `;

                    const actions = document.createElement('div');
                    actions.className = 'mt-2 d-flex justify-content-end';

                    const btnRemove = document.createElement('button');
                    btnRemove.type = 'button';
                    btnRemove.className = 'btn btn-sm btn-outline-danger';
                    btnRemove.textContent = 'Remove';
                    btnRemove.addEventListener('click', () => {
                        selected.splice(idx, 1);
                        syncInputFiles();
                        render();
                    });

                    actions.appendChild(btnRemove);

                    card.appendChild(img);
                    card.appendChild(meta);
                    card.appendChild(actions);
                    col.appendChild(card);
                    grid.appendChild(col);
                });
            }

            input.addEventListener('change', function () {
                const files = Array.from(input.files || []);
                selected = selected.concat(files);

                // remove duplicates (name+size+lastModified)
                const seen = new Set();
                selected = selected.filter(f => {
                    const key = `${f.name}|${f.size}|${f.lastModified}`;
                    if (seen.has(key)) return false;
                    seen.add(key);
                    return true;
                });

                syncInputFiles();
                render();
            });

            btnClear.addEventListener('click', function () {
                selected = [];
                syncInputFiles();
                render();
            });

            document.querySelector('form').addEventListener('submit', function (e) {
                if (selected.length > MAX) {
                    e.preventDefault();
                    showError(`Không thể submit: bạn đang chọn ${selected.length} ảnh. Tối đa ${MAX} ảnh.`);
                }
            });

            render();
        })();
    </script>
}
