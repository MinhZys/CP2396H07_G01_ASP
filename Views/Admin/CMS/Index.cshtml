@{
    ViewData["Title"] = "CMS";
}

<h2>Content Management System</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage FAQs</h5>
                <p class="card-text">Add, edit, or remove Frequently Asked Questions.</p>
                <a asp-action="ManageFAQs" class="btn btn-primary">Go to FAQs</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Static Pages</h5>
                <p class="card-text">Update content for 'About Us', 'Why Join Us', etc.</p>
                <a asp-action="ManagePages" class="btn btn-primary">Go to Pages</a>
            </div>
        </div>
    </div>
</div>
