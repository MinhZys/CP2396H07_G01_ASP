@{
    ViewData["Title"] = "CMS";
}

<h2>Content Management System</h2>
<p class="text-muted mb-4">Manage content blocks, static pages, and contact settings/messages.</p>

<div class="row mt-4 g-3">

    <!-- FAQs -->
    <div class=" col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Manage FAQs</h5>
                <p class="card-text text-muted">
                    Add, edit, order, or disable Frequently Asked Questions.
                </p>
                <div class="mt-auto">
                    <a asp-action="ManageFAQs" class="btn btn-primary w-100">Go to FAQs</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Static Pages -->
    <div class=" col-md-6 ">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Manage Static Pages</h5>
                <p class="card-text text-muted">
                    Update content for 'About Us', 'Why Join Us', etc.
                </p>
                <div class="mt-auto">
                    <a asp-action="ManagePages" class="btn btn-primary w-100">Go to Pages</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Messages (User -> Admin Inbox) -->
    <div class=" col-md-6 ">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">Contact Messages</h5>
                <p class="card-text text-muted">
                    View messages submitted from the Contact page (Inbox).
                </p>
                <div class="mt-auto">
                    <a asp-action="ManageContact" class="btn btn-primary w-100">Go to Contact</a>
                </div>
            </div>
        </div>
    </div>

</div>
