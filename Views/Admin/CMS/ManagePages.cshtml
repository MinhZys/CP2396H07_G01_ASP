@model IEnumerable<Symphony.Portal.Web.Models.PageContent>

@{
    ViewData["Title"] = "Manage Pages";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Static Pages</h2>

    <div>
        <a asp-action="CreatePage" class="btn btn-success">
            + Add Page
        </a>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            Back to CMS
        </a>
    </div>
</div>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th style="width:140px;">Images</th>
            <th>Slug</th>
            <th>Title</th>
            <th>Status</th>
            <th>Last Updated</th>
            <th style="width:220px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No pages found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                var totalImages = item.Images?.Count ?? 0;
                var extraImages = totalImages > 1 ? (totalImages - 1) : 0;

                <tr>
                    <!-- Featured + Count -->
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrWhiteSpace(item.FeaturedImage))
                            {
                                <div class="position-relative" style="width:88px;height:44px;">
                                    <img src="@item.FeaturedImage"
                                         alt="@item.Title"
                                         style="height:44px;width:88px;object-fit:cover;border-radius:10px;" />

                                    @if (extraImages > 0)
                                    {
                                        <span class="badge bg-dark position-absolute"
                                              style="right:-6px;top:-6px;">
                                            +@extraImages
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                                @if (extraImages > 0)
                                {
                                    <span class="badge bg-dark">+@extraImages</span>
                                }
                            }

                            @if (totalImages > 0)
                            {
                                <span class="text-muted small">(@totalImages)</span>
                            }
                        </div>
                    </td>

                    <!-- Slug -->
                    <td>@item.Slug</td>

                    <!-- Title -->
                    <td>@item.Title</td>

                    <!-- Status -->
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <!-- Last Updated -->
                    <td>
                        @(item.LastUpdated == DateTime.MinValue
                            ? "-"
                            : item.LastUpdated.ToString("dd/MM/yyyy HH:mm"))
                    </td>

                    <!-- Actions -->
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="EditPage"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               asp-area=""
                               asp-controller="Page"
                               asp-action="View"
                               asp-route-slug="@item.Slug"
                               target="_blank">
                                View
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="CMS"
                                  asp-action="DeletePage"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger js-delete">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
