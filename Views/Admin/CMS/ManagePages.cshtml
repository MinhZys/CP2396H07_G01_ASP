@model IEnumerable<Symphony.Portal.Web.Models.PageContent>

@{
    ViewData["Title"] = "Manage Pages";
}

<h2>Manage Static Pages</h2>

<p>
    <a asp-action="Index" class="btn btn-secondary">Back to CMS</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Slug</th>
            <th>Title</th>
            <th>Last Updated</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Slug</td>
            <td>@item.Title</td>
            <td>@item.LastUpdated</td>
            <td>
                <a asp-action="EditPage" asp-route-id="@item.Id">Edit Content</a>
            </td>
        </tr>
}
    </tbody>
</table>
