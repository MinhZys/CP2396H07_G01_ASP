@* Views/Admin/Shared/_AdminLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Symphony Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Header -->
    <header class="main-header">
        <button class="mobile-menu-toggle" type="button" onclick="toggleMobileSidebar()">
            <i class="fas fa-bars fa-lg"></i>
        </button>

        <div class="brand-section">
            <i class="fas fa-music brand-icon"></i>
            <span class="brand-text">Symphony Admin</span>
        </div>

        <div class="header-actions">
            <!-- Language Toggle (Admin) -->
            <div class="dropdown">
                <button class="header-btn dropdown-toggle" type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-globe me-1"></i>
                    <span id="current-lang-text">EN</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                    <li><button class="dropdown-item" type="button" onclick="changeLanguage('en')">English</button></li>
                    <li><button class="dropdown-item" type="button" onclick="changeLanguage('vi')">Tiếng Việt</button></li>
                </ul>
            </div>

            <div class="user-info">
                <div class="user-avatar">
                    <i class="fas fa-user-shield"></i>
                </div>
                <span class="d-none d-md-inline">Welcome, Admin</span>
            </div>

            <a class="header-btn" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                <i class="fas fa-external-link-alt me-1"></i>
                <span class="d-none d-md-inline">Go to Site</span>
            </a>

            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                <button type="submit" class="header-btn">
                    <i class="fas fa-sign-out-alt me-1"></i>
                    <span class="d-none d-md-inline">Sign Out</span>
                </button>
            </form>
        </div>
    </header>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-toggle" onclick="toggleSidebar()">
            <i class="fas fa-chevron-left"></i>
        </div>

        <ul class="sidebar-nav nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.admin_dashboard">Dashboard</span>
                </a>
            </li>

            <h6 class="sidebar-heading">ACADEMIC</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="fas fa-list-alt nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.categories">Categories</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClassCategories" ? "active" : "")"
                   asp-area="Admin" asp-controller="ClassCategories" asp-action="Index">
                    <i class="fas fa-tags nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.class_categories">Class Categories</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")"
                   asp-area="Admin" asp-controller="Courses" asp-action="Index">
                    <i class="fas fa-graduation-cap nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.courses">Courses</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subjects" ? "active" : "")"
                   asp-area="Admin" asp-controller="Subjects" asp-action="Index">
                    <i class="fas fa-book nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.subjects">Subjects</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ManagePayments" ? "active" : "")"
                   asp-area="Admin" asp-controller="ManagePayments" asp-action="Index">
                    <i class="fa-solid fa-bag-shopping nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.manage_payments">Manage Payments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Classes" ? "active" : "")"
                   asp-area="Admin" asp-controller="Classes" asp-action="Index">
                    <i class="fas fa-chalkboard nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.classes">Classes</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assignments" ? "active" : "")"
                   asp-area="Admin" asp-controller="Assignments" asp-action="Index">
                    <i class="fas fa-tasks nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.task_assignments">Task Assignments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ExamPapers" ? "active" : "")"
                   asp-area="Admin" asp-controller="ExamPapers" asp-action="Index">
                    <i class="fas fa-file-alt nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.exam_papers">Manage Exam Papers</span>
                </a>
            </li>

            <h6 class="sidebar-heading">ADMISSIONS & USERS</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EntranceExams" ? "active" : "")"
                   asp-area="Admin" asp-controller="EntranceExams" asp-action="Index">
                    <i class="fas fa-file-signature nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.entrance_exams">Entrance Exams</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudentRegistration" ? "active" : "")"
                   asp-area="Admin" asp-controller="StudentRegistration" asp-action="Index">
                    <i class="fas fa-user-plus nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.registrations">Registrations</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Guests" ? "active" : "")"
                   asp-area="Admin" asp-controller="Guests" asp-action="Index">
                    <i class="fas fa-user-clock nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.guest_registrations">Guest Registrations</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users-cog nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.manage_users">Manage Users</span>
                </a>
            </li>

            <h6 class="sidebar-heading">SYSTEM</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CMS" ? "active" : "")"
                   asp-area="Admin" asp-controller="CMS" asp-action="Index">
                    <i class="fas fa-laptop-code nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.cms">CMS</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CourseReviews" ? "active" : "")"
                   asp-area="Admin" asp-controller="CourseReviews" asp-action="Index">
                    <i class="fas fa-star-half-alt nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.reviews">Reviews</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Certificates" ? "active" : "")"
                   asp-area="Admin" asp-controller="Certificates" asp-action="Index">
                    <i class="fas fa-certificate nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.certificates">Certificates</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Chat" ? "active" : "")"
                   asp-area="Admin" asp-controller="Chat" asp-action="Index">
                    <i class="fas fa-comments nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.chat_support">Chat Support</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminNotifications" ? "active" : "")"
                   asp-area="Admin" asp-controller="AdminNotifications" asp-action="Create">
                    <i class="fas fa-bullhorn nav-icon"></i>
                    <span class="nav-text" data-i18n="nav.system_notifications">System Notifications</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/system-notifications.js"></script>
    
    <!-- i18next -->
    <script src="https://unpkg.com/i18next@21.6.10/dist/umd/i18next.min.js"></script>
    <script src="https://unpkg.com/i18next-http-backend@1.3.1/i18nextHttpBackend.min.js"></script>
    <script src="https://unpkg.com/i18next-browser-languagedetector@6.1.3/i18nextBrowserLanguageDetector.min.js"></script>

    <script>
        // Show notifications
        document.addEventListener("DOMContentLoaded", function () {
            SystemNotification.showMessages(
                '@Html.Raw(TempData["Success"])',
                '@Html.Raw(TempData["Error"])'
            );
            SystemNotification.setupDeleteConfirmations();
        });

        // Toggle sidebar collapse
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');

            const icon = sidebar.querySelector('.sidebar-toggle i');
            icon.classList.toggle('fa-chevron-left');
            icon.classList.toggle('fa-chevron-right');

            localStorage.setItem('adminSidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        // Toggle mobile sidebar
        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('mobile-open');
        }

        // Close mobile sidebar when clicking outside
        document.addEventListener('click', function (event) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.querySelector('.mobile-menu-toggle');

            if (sidebar && toggle && window.innerWidth <= 768 &&
                !sidebar.contains(event.target) &&
                !toggle.contains(event.target) &&
                sidebar.classList.contains('mobile-open')) {
                sidebar.classList.remove('mobile-open');
            }
        });

        // Restore sidebar state
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById('sidebar');
            const isCollapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';

            if (sidebar && isCollapsed) {
                sidebar.classList.add('collapsed');
                const icon = sidebar.querySelector('.sidebar-toggle i');
                if (icon) {
                    icon.classList.remove('fa-chevron-left');
                    icon.classList.add('fa-chevron-right');
                }
            }
        });

        // i18next logic
        document.addEventListener("DOMContentLoaded", function () {
            i18next
                .use(i18nextHttpBackend)
                .use(i18nextBrowserLanguageDetector)
                .init({
                    backend: { loadPath: '/locales/{{lng}}/translation.json?v=1.0.3' },
                    fallbackLng: 'en',
                    debug: false,
                    detection: {
                        order: ['querystring', 'cookie', 'localStorage', 'navigator', 'htmlTag'],
                        caches: ['localStorage', 'cookie']
                    }
                }, function (err, t) {
                    if (err) return console.error('i18next init error:', err);
                    updateContent();
                });

            function updateContent() {
                document.querySelectorAll('[data-i18n]').forEach(function (element) {
                    const key = element.getAttribute('data-i18n');
                    const options = element.getAttribute('data-i18n-options');
                    const jsonOptions = options ? JSON.parse(options) : {};

                    const translatedText = i18next.t(key, jsonOptions);
                    
                    if (element.tagName === 'INPUT' && element.getAttribute('placeholder')) {
                        element.setAttribute('placeholder', translatedText);
                    } else {
                        // Preserve icons if they exist
                        const innerIcon = element.querySelector('i, span.material-symbols-outlined, span.fa');
                        if (innerIcon) {
                            const nodes = Array.from(element.childNodes);
                            nodes.forEach(node => {
                                if (node.nodeType === Node.TEXT_NODE) {
                                    element.removeChild(node);
                                }
                            });
                            element.appendChild(document.createTextNode(' ' + translatedText));
                        } else {
                            element.textContent = translatedText;
                        }
                    }
                });

                const currentLng = i18next.language ? i18next.language.substring(0, 2) : 'en';
                const langBtnText = document.getElementById('current-lang-text');
                if (langBtnText) langBtnText.textContent = currentLng.toUpperCase();
            }

            window.changeLanguage = function (lng) {
                i18next.changeLanguage(lng, function () {
                    updateContent();
                });
            };
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
