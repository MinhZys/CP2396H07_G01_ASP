@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.StudentExamSession>

@{
    ViewData["Title"] = "Final Exam Results";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Exam Results</h1>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link text-muted" asp-action="Index">
            <i class="fas fa-sign-in-alt me-1"></i> Entrance Exams
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-bold" asp-action="FinalExams">
            <i class="fas fa-graduation-cap me-1"></i> Final Exams (Class Exams)
        </a>
    </li>
</ul>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Filter by Class</label>
                <select name="classId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Classes</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <!option value="@cls.Id" @(ViewBag.SelectedClassId == cls.Id ? "selected" : "")>@cls.ClassName</!option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.SelectedClassId))
            {
                <div class="col-md-2 d-flex align-items-end">
                    <form asp-action="PublishAllScores" method="post" class="w-100">
                        <input type="hidden" name="classId" value="@ViewBag.SelectedClassId" />
                        <button type="submit" class="btn btn-warning w-100" onclick="return confirm('Publish all subject scores for this class?')">
                            <i class="fas fa-broadcast-tower me-1"></i> Publish All
                        </button>
                    </form>
                </div>
            }
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Class / Course</th>
                <th>Exam Title</th>
                <th>Date</th>
                <th>Score</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">No results found.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="fw-bold">@item.Student?.FullName</div>
                        <small class="text-muted">@item.Student?.Email</small>
                    </td>
                    <td>
                        <div class="fw-bold">@item.ClassExam?.Class?.ClassName</div>
                        <small class="text-info">@item.ClassExam?.Course?.Title</small>
                    </td>
                    <td>@item.ExamPaper?.Title</td>
                    <td>@item.StartTime?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="fw-bold text-primary">@item.TotalScore.ToString("0.##")</span>
                    </td>
                    <td>
                        @if (item.ClassExam != null && item.ClassExam.IsScorePublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hidden (Internal Only)</span>
                        }
                    </td>
                    <td>
                        @if (item.ClassExam != null)
                        {
                            @if (!item.ClassExam.IsScorePublished)
                            {
                                <form asp-action="PublishScore" method="post" class="d-inline">
                                    <input type="hidden" name="classExamId" value="@item.ClassExamId" />
                                    <button type="submit" class="btn btn-sm btn-warning fw-bold" title="Publish Scores" onclick="return confirm('Công bố điểm cho môn này?')">
                                        <i class="fas fa-broadcast-tower me-1"></i> Công bố
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-success shadow-sm mb-1 d-block py-2">
                                    <i class="fas fa-check-circle me-1"></i> Đã công bố
                                </span>

                                @* Manual Notify Certificate Button for Passing Students *@
                                @if (item.TotalScore >= (item.ClassExam?.Course?.PassingScore ?? 5.0))
                                {
                                    <form asp-action="NotifyCertificate" method="post" class="d-inline">
                                        <input type="hidden" name="sessionId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success fw-bold w-100" title="Thông báo nhận chứng chỉ" onclick="return confirm('Gửi thông báo nhận chứng chỉ cho học sinh này?')">
                                            <i class="fas fa-award me-1"></i> TB Nhận Chứng Chỉ
                                        </button>
                                    </form>
                                }
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
