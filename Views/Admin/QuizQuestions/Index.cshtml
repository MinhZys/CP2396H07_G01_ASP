@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.QuizQuestion>

@{
    ViewData["Title"] = "Quiz Questions";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Questions</h1>
    @if (ViewData["CurrentQuizId"] != null)
    {
         <a asp-controller="Quizzes" asp-action="Details" asp-route-id="@ViewData["CurrentQuizId"]" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Quiz
        </a>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Question</th>
                        <th>Quiz</th>
                        <th>Points</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>
                                <p class="mb-0 text-truncate" style="max-width: 400px;">@item.QuestionText</p>
                            </td>
                            <td>@item.Quiz?.Name</td>
                            <td><span class="badge bg-secondary">@item.Points</span></td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" class="d-inline form-delete">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model" />
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // System Notifications handled by global script system-notifications.js
    </script>
}
