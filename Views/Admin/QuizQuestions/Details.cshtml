@model Symphony.Portal.Web.Models.QuizQuestion

@{
    ViewData["Title"] = "Question Details";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Question Details</h1>
    <a asp-controller="Quizzes" asp-action="Details" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Quiz
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <strong>Question:</strong> @Model.QuestionText
    </div>
    <div class="card-body">
        <div class="row mb-3">
             <div class="col-md-6">
                <ul class="list-group">
                    <li class="list-group-item @(Model.CorrectOption == "A" ? "list-group-item-success" : "")">
                        <strong>A:</strong> @Model.OptionA
                        @if(Model.CorrectOption == "A") { <i class="fas fa-check float-end"></i> }
                    </li>
                    <li class="list-group-item @(Model.CorrectOption == "B" ? "list-group-item-success" : "")">
                        <strong>B:</strong> @Model.OptionB
                        @if(Model.CorrectOption == "B") { <i class="fas fa-check float-end"></i> }
                    </li>
                    <li class="list-group-item @(Model.CorrectOption == "C" ? "list-group-item-success" : "")">
                        <strong>C:</strong> @Model.OptionC
                        @if(Model.CorrectOption == "C") { <i class="fas fa-check float-end"></i> }
                    </li>
                    <li class="list-group-item @(Model.CorrectOption == "D" ? "list-group-item-success" : "")">
                        <strong>D:</strong> @Model.OptionD
                         @if(Model.CorrectOption == "D") { <i class="fas fa-check float-end"></i> }
                    </li>
                </ul>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Points</dt>
                    <dd class="col-sm-8">@Model.Points</dd>
                    
                    <dt class="col-sm-4">Quiz</dt>
                    <dd class="col-sm-8">@Model.Quiz?.Name</dd>
                </dl>
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
