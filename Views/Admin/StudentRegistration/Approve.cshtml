@model Symphony.Portal.Web.Models.ExamDetail

@{
    ViewData["Title"] = "Approve Registration";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Approve Registration</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                Assign Exam Details
            </div>
            <div class="card-body">
                <form asp-action="Approve">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="RegistrationId" />

                    <div class="form-group mb-3">
                        <label asp-for="ExamTime" class="control-label">Exam Date & Time</label>
                        <input asp-for="ExamTime" class="form-control" type="datetime-local" value="@DateTime.Now.AddDays(7).ToString("s")" />
                        <span asp-validation-for="ExamTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ExamRoom" class="control-label">Exam Room</label>
                        <input asp-for="ExamRoom" class="form-control" placeholder="e.g. Room A101" />
                        <span asp-validation-for="ExamRoom" class="text-danger"></span>
                    </div>

                     <div class="form-group mb-3">
                        <label asp-for="ExamDescription" class="control-label">Instructions / Description</label>
                        <textarea asp-for="ExamDescription" class="form-control" rows="3">Please bring your ID card and arrive 15 minutes early.</textarea>
                        <span asp-validation-for="ExamDescription" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Approve & Send Email" class="btn btn-success" />
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
