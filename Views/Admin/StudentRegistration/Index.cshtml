@model IEnumerable<Symphony.Portal.Web.Models.StudentRegistration>

@{
    ViewData["Title"] = "Student Registrations";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Student Registrations</h1>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Date</th>
                <th>Status</th>
                <th>Full Name</th>
                <th>Course</th>
                <th>Center</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RegisteredAt.ToString("g")</td>
                    <td>
                        @if (item.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (item.Status == "Approved")
                        {
                             <span class="badge bg-success">Approved</span>
                        }
                         else if (item.Status == "Rejected")
                        {
                             <span class="badge bg-danger">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Status</span>
                        }
                    </td>
                    <td>@item.FullName</td>
                    <td>@item.Course?.Title</td>
                    <td>@item.Center?.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="View Details"><i class="fa-solid fa-eye"></i></a>
                        @if (item.Status == "Pending")
                        {
                            <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Approve"><i class="fa-solid fa-check"></i></a>
                            
                             <form asp-action="Reject" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to reject this registration?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger" title="Reject"><i class="fa-solid fa-xmark"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
