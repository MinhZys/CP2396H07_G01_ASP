@model IEnumerable<Symphony.Portal.Web.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Users</h1>
    <a asp-action="Create" class="btn btn-primary">Create New User</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Search by name or email" value="@ViewData["CurrentFilter"]" />
        <select name="statusFilter" class="form-select" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="active" selected="@(ViewData["StatusFilter"]?.ToString() == "active")">Active</option>
            <option value="inactive" selected="@(ViewData["StatusFilter"]?.ToString() == "inactive")">Inactive</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-outline-danger">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    
                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to change status for this user?');">
                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")">
                            @(item.IsActive ? "Disable" : "Enable")
                        </button>
                    </form>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this user? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
