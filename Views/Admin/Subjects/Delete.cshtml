@model Symphony.Portal.Web.Models.Subject

@{
    ViewData["Title"] = "Delete Subject";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 text-danger">Delete Subject</h1>
</div>

<h3>Are you sure you want to delete this subject?</h3>
<div class="card border-danger mb-3" style="max-width: 40rem;">
  <div class="card-header bg-transparent border-danger">Header</div>
  <div class="card-body text-danger">
    <h5 class="card-title">@Model.Name (ID: @Model.Id)</h5>
    <p class="card-text">
        <strong>Study Time:</strong> @Model.StudyTime hours<br/>
        <strong>Description:</strong> @Model.Description
    </p>
  </div>
   <div class="card-footer bg-transparent border-danger">
       <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
   </div>
</div>
