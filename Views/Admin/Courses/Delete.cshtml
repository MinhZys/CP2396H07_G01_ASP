@model Symphony.Portal.Web.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>

<h3>Are you sure you want to delete this course?</h3>
<div class="row">
    <div class="col-md-6">
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            
            <dt class="col-sm-4">Duration</dt>
            <dd class="col-sm-8">@Model.DurationMonths Months</dd>
            
            <dt class="col-sm-4">Fee</dt>
            <dd class="col-sm-8">$@Model.TuitionFee</dd>
            
            <dt class="col-sm-4">Active?</dt>
            <dd class="col-sm-8">@Model.IsActive</dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>
