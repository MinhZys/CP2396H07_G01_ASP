@using Symphony.Portal.Web.Models.Enums
@model Symphony.Portal.Web.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container mt-4">
    <h2>Edit Course</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Course Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="imageFile" class="form-label">Course Image</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="mt-2">
                            <p>Current Image:</p>
                            <img src="@Model.Image" alt="Course Image" class="img-thumbnail" style="max-height: 150px;" />
                        </div>
                    }
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationMonths" class="form-label">Duration (Months)</label>
                        <input asp-for="DurationMonths" class="form-control" />
                        <span asp-validation-for="DurationMonths" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Level" class="form-label">Level</label>
                        <select asp-for="Level" class="form-select" asp-items="Html.GetEnumSelectList<CourseLevel>()">
                        </select>
                        <span asp-validation-for="Level" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="TuitionFee" class="form-label">Tuition Fee ($)</label>
                        <input asp-for="TuitionFee" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="TuitionFee" class="text-danger"></span>
                    </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Manage Subjects</label>
                    <div class="row">
                        <!-- Available Subjects -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Available Subjects</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text" id="subjectSearch" class="form-control" placeholder="Type to search subjects..." autocomplete="off">
                            </div>
                            <div id="availableList" class="border rounded p-2 bg-white" style="height: 250px; overflow-y: auto;">
                                <!-- Loaded via JS -->
                            </div>
                        </div>

                        <!-- Selected Subjects -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Selected Subjects</label>
                            <div id="selectedList" class="border rounded p-2 bg-light" style="height: 285px; overflow-y: auto;">
                                <p class="text-muted text-center mt-5" id="emptyMsg" style="display: none;">No subjects selected</p>
                                @if (ViewBag.Subjects != null)
                                {
                                    var selectedIds = ViewBag.SelectedSubjectIds as List<string> ?? new List<string>();
                                    foreach (var subject in ViewBag.Subjects)
                                    {
                                        if (selectedIds.Contains(subject.Id))
                                        {
                                            <div class="selected-item d-flex justify-content-between align-items-center p-2 mb-1 border rounded bg-white shadow-sm" 
                                                 data-id="@subject.Id">
                                                <span class="fw-medium">@subject.Name <small class="text-muted">(@subject.StudyTime hrs)</small></span>
                                                <button type="button" class="btn btn-sm btn-danger remove-btn"><i class="fa-solid fa-trash"></i></button>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hidden inputs container -->
                <div id="formHiddenInputs">
                    @if (ViewBag.SelectedSubjectIds != null)
                    {
                        foreach (var id in (List<string>)ViewBag.SelectedSubjectIds)
                        {
                            <input type="hidden" name="selectedSubjectIds" value="@id" />
                        }
                    }
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const availableList = document.getElementById('availableList');
                        const selectedList = document.getElementById('selectedList');
                        const searchInput = document.getElementById('subjectSearch');
                        const hiddenInputs = document.getElementById('formHiddenInputs');
                        const emptyMsg = document.getElementById('emptyMsg');

                        let debounceTimer;

                        checkEmpty();
                        // Initial fetch
                        fetchSubjects('');

                        // AJAX Search Function
                        searchInput.addEventListener('keyup', function() {
                             clearTimeout(debounceTimer);
                            const term = this.value.trim();
                            debounceTimer = setTimeout(() => {
                                fetchSubjects(term);
                            }, 300);
                        });

                        function fetchSubjects(term) {
                            fetch(`/Admin/Courses/SearchSubjects?term=${encodeURIComponent(term)}`)
                                    .then(response => response.json())
                                    .then(data => {
                                        availableList.innerHTML = '';
                                        if (data.length === 0) {
                                             availableList.innerHTML = '<p class="text-muted text-center mt-2 small">No results found</p>';
                                        } else {
                                            const selectedIds = Array.from(selectedList.querySelectorAll('.selected-item')).map(el => el.dataset.id);

                                            data.forEach(subject => {
                                                if(!selectedIds.includes(subject.id)) {
                                                    const div = document.createElement('div');
                                                    div.className = 'subject-item d-flex justify-content-between align-items-center p-2 mb-1 border rounded bg-white';
                                                    div.dataset.id = subject.id;
                                                    div.dataset.name = subject.name;
                                                    div.dataset.time = subject.studyTime;
                                                    div.style.cursor = 'pointer';
                                                    div.style.transition = 'background 0.2s';
                                                    
                                                    div.onmouseover = function() { this.classList.add('bg-light'); };
                                                    div.onmouseout = function() { this.classList.remove('bg-light'); };

                                                    div.innerHTML = `<span>${subject.name} <small class="text-muted">(${subject.studyTime} hrs)</small></span>
                                                                     <button type="button" class="btn btn-sm btn-outline-primary rounded-circle"><i class="fa-solid fa-plus"></i></button>`;
                                                    availableList.appendChild(div);
                                                }
                                            });
                                        }
                                    })
                                    .catch(err => console.error('Error:', err));
                        }

                        // Add Subject
                        availableList.addEventListener('click', function(e) {
                            const item = e.target.closest('.subject-item');
                            if (!item) return;

                            const id = item.dataset.id;
                            const name = item.dataset.name;
                            const time = item.dataset.time;

                            // Move to selected
                            const newItem = document.createElement('div');
                            newItem.className = 'selected-item d-flex justify-content-between align-items-center p-2 mb-1 border rounded bg-white shadow-sm';
                            newItem.dataset.id = id;
                            newItem.innerHTML = `<span class="fw-medium">${name} <small class="text-muted">(${time} hrs)</small></span>
                                                 <button type="button" class="btn btn-sm btn-danger remove-btn"><i class="fa-solid fa-trash"></i></button>`;
                            
                            selectedList.appendChild(newItem);
                            item.remove(); // Remove from available
                            
                            checkEmpty();
                            updateInputs();
                        });

                        // Remove Subject
                        selectedList.addEventListener('click', function(e) {
                            const btn = e.target.closest('.remove-btn');
                            if (btn) {
                                const item = btn.closest('.selected-item');
                                if (!item) return;

                                item.remove();
                                checkEmpty();
                                updateInputs();
                                
                                // Trigger search again to update available list
                                const term = searchInput.value.trim();
                                fetchSubjects(term);
                            }
                        });

                        function checkEmpty() {
                            const count = selectedList.querySelectorAll('.selected-item').length;
                            emptyMsg.style.display = count > 0 ? 'none' : 'block';
                        }

                        function updateInputs() {
                            hiddenInputs.innerHTML = '';
                            const items = selectedList.querySelectorAll('.selected-item');
                            items.forEach(item => {
                                const input = document.createElement('input');
                                input.type = 'hidden';
                                input.name = 'selectedSubjectIds';
                                input.value = item.dataset.id;
                                hiddenInputs.appendChild(input);
                            });
                        }
                    });
                </script>

                <div class="mb-3 form-check form-switch p-3 border rounded bg-light">
                    <input class="form-check-input" asp-for="IsActive" style="transform: scale(1.5); margin-left: -2.5em; margin-right: 1em; cursor: pointer;" />
                    <label class="form-check-label fw-bold" asp-for="IsActive" style="margin-left: 0.5em;">
                        Active <i class="fa-solid fa-eye text-primary"></i>
                    </label>
                    <div class="form-text">
                        If checked, this course will be visible on the Home Page and open for registration.
                    </div>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
