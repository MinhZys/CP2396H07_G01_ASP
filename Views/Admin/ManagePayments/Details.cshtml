@model Symphony.Portal.Web.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<h2>Payment Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Payer</th>
        <td>
            @{
                var payerName = Model.Student?.FullName ?? Model.Guest?.FullName ?? "Guest";
                var payerEmail = Model.Student?.Email ?? Model.Guest?.Email;
                var payerRole = Model.Student != null ? "Student" : (Model.Guest != null ? "Guest" : "Guest");
            }

            <div class="fw-bold">@payerName</div>
            @if (!string.IsNullOrWhiteSpace(payerEmail))
            {
                <small class="text-muted">@payerEmail</small>
            }
            <div class="mt-1">
                <span class="badge bg-secondary">@payerRole</span>
            </div>
        </td>
    </tr>

    <tr>
        <th>Amount</th>
        <td>@Model.Amount.ToString("N0") đ</td>
    </tr>

    <tr>
        <th>Payment Method</th>
        <td>@Model.PaymentMethod</td>
    </tr>

    <tr>
        <th>Purpose</th>
        <td>
            <span class="badge bg-info text-dark">
                @Model.Purpose
            </span>
        </td>
    </tr>

    <tr>
        <th>Registered Item</th>
        <td>
            @if (ViewBag.RegisteredTitle != null)
            {
                <strong>@ViewBag.RegisteredType</strong>
                <br />
                <span class="text-primary">@ViewBag.RegisteredTitle</span>
            }
            else
            {
                <span class="text-muted">N/A</span>
            }
        </td>
    </tr>

    <tr>
        <th>Status</th>
        <td>
            <span class="badge bg-info">
                @Model.Status
            </span>
        </td>
    </tr>

    <tr>
        <th>Payment Date</th>
        <td>
            @(Model.PaymentDate == default ? "-" : Model.PaymentDate.ToString("dd/MM/yyyy HH:mm"))
        </td>
    </tr>

    <tr>
        <th>Receipt Number</th>
        <td>@Model.ReceiptNumber</td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>
