@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.EntranceExam>

@{
    ViewData["Title"] = "Entrance Exams Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-800 mb-1">Entrance Exams</h2>
            <p class="text-slate-500 mb-0">Manage the list of entrance exams.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
            <span class="material-symbols-outlined">add_circle</span>
            Create New Exam
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">error</span>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3 text-secondary text-uppercase small fw-bold">Exam Title</th>
                        <th class="px-4 py-3 text-secondary text-uppercase small fw-bold">Date</th>
                        <th class="px-4 py-3 text-secondary text-uppercase small fw-bold">Subjects</th>
                        <th class="px-4 py-3 text-secondary text-uppercase small fw-bold">Status</th>
                        <th class="px-4 py-3 text-secondary text-uppercase small fw-bold text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <span class="fw-bold text-slate-700">@item.Title</span>
                            </td>
                            <td class="px-4 py-3 text-slate-600">
                                @item.ExamDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-4 py-3">
                                <span class="badge bg-light text-slate-600 border px-3 rounded-pill">@item.Subjects</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 rounded-pill">Inactive</span>
                                }
                                
                                @if (item.IsRegistrationOpen)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 rounded-pill ms-1">Registration Open</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none rounded-pill px-3 hover-bg-danger-subtle">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined display-4 text-slate-200 mb-3">event_busy</span>
                <p class="text-slate-500 mb-0">No entrance exams found.</p>
            </div>
        }
        <partial name="_Pagination" model="Model" />
    </div>
</div>
