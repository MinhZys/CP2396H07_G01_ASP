@model Symphony.Portal.Web.Models.ClassExam

@{
    ViewData["Title"] = "Edit Class Exam";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h3 class="card-title mb-0">Edit Class Exam Assignment</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-3">
                            <label asp-for="ClassId" class="form-label font-weight-bold">Class</label>
                            <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId"></select>
                            <span asp-validation-for="ClassId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CourseId" class="form-label font-weight-bold">Course</label>
                            <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId"></select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExamPaperId" class="form-label font-weight-bold">Exam Paper</label>
                            <select asp-for="ExamPaperId" class="form-select" asp-items="ViewBag.ExamPaperId"></select>
                            <span asp-validation-for="ExamPaperId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExamDate" class="form-label font-weight-bold">Exam Date & Time</label>
                                <input asp-for="ExamDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="ExamDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationOverride" class="form-label font-weight-bold">Duration Override (Mins)</label>
                                <input asp-for="DurationOverride" class="form-control" />
                                <span asp-validation-for="DurationOverride" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label font-weight-bold">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Symphony.Portal.Web.Models.Enums.ClassExamStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-warning px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
