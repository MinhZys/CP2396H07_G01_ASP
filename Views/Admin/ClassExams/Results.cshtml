@model IEnumerable<Symphony.Portal.Web.Models.StudentExamSession>

@{
    ViewData["Title"] = "Exam Results";
    var classExam = ViewBag.ClassExam as Symphony.Portal.Web.Models.ClassExam;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Exam Results</h1>
            <p class="text-muted small">
                Class: <span class="fw-bold">@classExam?.Class?.ClassName</span> | 
                Course: <span class="fw-bold">@classExam?.Course?.Title</span> |
                Topic: <span class="fw-bold">@classExam?.ExamPaper?.Title</span>
            </p>
        </div>
        <div class="d-flex">
            @if (classExam != null && !classExam.IsScorePublished && Model.Any())
            {
                <form asp-action="PublishScore" method="post" class="me-2">
                    <input type="hidden" name="classExamId" value="@classExam.Id" />
                    <button type="submit" class="btn btn-warning" onclick="return confirm('Publish scores now?')">
                        <i class="fas fa-broadcast-tower me-2"></i> Publish Results
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i> Back to Schedule
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Student Scores</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-user-clock fa-3x mb-3"></i>
                    <p>No students have taken this exam yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                        <thead>
                            <tr class="bg-light">
                                <th>Student Name</th>
                                <th>Email</th>
                                <th>Score</th>
                                <th>Status</th>
                                <th>Date Taken</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                                @item.Student?.FullName?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-bold">@item.Student?.FullName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Student?.Email</td>
                                    <td>
                                        <span class="fw-bold text-primary">@item.TotalScore.ToString("0.##")</span>
                                    </td>
                                    <td>
                                        @if (item.Status == Symphony.Portal.Web.Models.Enums.ExamSessionStatus.Finished)
                                        {
                                            <span class="badge bg-success">Finished</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@item.Status</span>
                                        }
                                    </td>
                                    <td>@item.StartTime?.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
