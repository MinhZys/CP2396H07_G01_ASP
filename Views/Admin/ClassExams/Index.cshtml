@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.ClassExam>

@{
    ViewData["Title"] = "Manage Class Exams";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Manage Class Exams (Final Exams)</h2>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Assign New Exam
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Class Name</th>
                            <th>Course</th>
                            <th>Exam Paper</th>
                            <th>Exam Date</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Class?.ClassName</td>
                                <td>@item.Course?.Title</td>
                                <td>@item.ExamPaper?.Title</td>
                                <td>@(item.ExamDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case Symphony.Portal.Web.Models.Enums.ClassExamStatus.Scheduled:
                                            <span class="badge bg-info">Scheduled</span>
                                            break;
                                        case Symphony.Portal.Web.Models.Enums.ClassExamStatus.InProgress:
                                            <span class="badge bg-warning text-dark">In Progress</span>
                                            break;
                                        case Symphony.Portal.Web.Models.Enums.ClassExamStatus.Completed:
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                        case Symphony.Portal.Web.Models.Enums.ClassExamStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Results" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="View Results">
                                            <i class="fas fa-chart-bar"></i>
                                        </a>
                                        
                                        @if (!item.IsScorePublished)
                                        {
                                            <form asp-action="PublishScore" method="post" class="d-inline">
                                                <input type="hidden" name="classExamId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Publish Scores" onclick="return confirm('Are you sure you want to publish scores for this exam?')">
                                                    <i class="fas fa-broadcast-tower"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button disabled class="btn btn-sm btn-success" title="Scores Published">
                                                <i class="fas fa-check-circle"></i>
                                            </button>
                                        }

                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this exam assignment? This action cannot be undone.')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pagination" model="Model" />
        </div>
    </div>
</div>
