@{
    ViewData["Title"] = "AI Quiz Generator";
    var subjects = ViewBag.Subjects as List<SelectListItem> ?? new List<SelectListItem>();
    var isAIAvailable = ViewBag.IsAIAvailable as bool? ?? false;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-gradient text-white rounded p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="fa-solid fa-robot fs-4"></i>
            </div>
            <div>
                <h1 class="h3 mb-0">AI Quiz Generator</h1>
                <p class="text-muted small mb-0">Tự động tạo câu hỏi trắc nghiệm từ nội dung bài học</p>
            </div>
        </div>
        
        <!-- AI Status -->
        <div id="ai-status-badge" class="badge rounded-pill @(isAIAvailable ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-block rounded-circle @(isAIAvailable ? "bg-success" : "bg-danger")" style="width: 8px; height: 8px;"></span>
                <span class="fw-normal">
                    @(isAIAvailable ? "Ollama Online" : "Ollama Offline")
                </span>
            </div>
        </div>
    </div>

    @if (!isAIAvailable)
    {
        <div class="alert alert-danger shadow-sm border-danger-subtle" role="alert">
            <div class="d-flex gap-3">
                <i class="fa-solid fa-circle-exclamation fs-4 text-danger mt-1"></i>
                <div>
                    <h5 class="alert-heading text-danger">Ollama không khả dụng</h5>
                    <p class="mb-2">Để sử dụng AI Quiz Generator, bạn cần:</p>
                    <ol class="small text-secondary mb-3 ps-3">
                        <li>Cài đặt Ollama từ <a href="https://ollama.ai" target="_blank" class="fw-bold">ollama.ai</a></li>
                        <li>Chạy lệnh: <code class="bg-dark text-white px-1 rounded">ollama pull llama3.2</code></li>
                        <li>Đảm bảo Ollama đang chạy (localhost:11434)</li>
                    </ol>
                    <button onclick="checkAIStatus()" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-rotate-right me-1"></i>
                        Kiểm tra lại
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Input Section -->
        <div class="col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-primary"></i>
                        Nội dung bài học
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Subject Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Môn học</label>
                        <select id="subjectSelect" class="form-select">
                            <option value="">-- Chọn môn học --</option>
                            @foreach (var subject in subjects)
                            {
                                <option value="@subject.Value">@subject.Text</option>
                            }
                        </select>
                    </div>

                    <!-- Content Input -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Nội dung văn bản</label>
                        <textarea id="contentInput" 
                                  rows="10" 
                                  placeholder="Dán nội dung bài học vào đây... AI sẽ tự động tạo câu hỏi từ nội dung này."
                                  class="form-control"
                                  style="resize: none;"></textarea>
                        <div class="d-flex justify-content-between mt-1">
                            <small id="charCount" class="text-muted">0 ký tự</small>
                            <small class="text-muted">Tối thiểu 100 ký tự</small>
                        </div>
                    </div>

                    <!-- Options -->
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Số câu hỏi</label>
                            <select id="questionCount" class="form-select">
                                <option value="3">3 câu</option>
                                <option value="5" selected>5 câu</option>
                                <option value="10">10 câu</option>
                                <option value="15">15 câu</option>
                                <option value="20">20 câu</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Độ khó</label>
                            <select id="difficultySelect" class="form-select">
                                <option value="Easy">Dễ</option>
                                <option value="Medium" selected>Trung bình</option>
                                <option value="Hard">Khó</option>
                            </select>
                        </div>
                    </div>

                    <!-- Generate Button -->
                    <button id="generateBtn" 
                            onclick="generateQuestions()" 
                            class="btn btn-primary w-100 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                            @(isAIAvailable ? "" : "disabled")>
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Tạo câu hỏi với AI
                    </button>
                </div>
            </div>
        </div>

        <!-- Results Section -->
        <div class="col-lg-7 col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-list-check text-primary"></i>
                        Câu hỏi được tạo
                    </h5>
                    <span id="questionCountBadge" class="badge bg-primary-subtle text-primary rounded-pill d-none">
                        0 câu
                    </span>
                </div>
                <div class="card-body bg-light rounded-bottom">
                    
                    <!-- Loading State -->
                    <div id="loadingState" class="d-none py-5 text-center">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                        <h6 class="text-dark">AI đang phân tích và tạo câu hỏi...</h6>
                        <p class="text-muted small">Quá trình này có thể mất 15-30 giây</p>
                    </div>

                    <!-- Empty State -->
                    <div id="emptyState" class="text-center py-5">
                        <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fa-regular fa-lightbulb fs-1 text-secondary"></i>
                        </div>
                        <h5 class="text-muted">Chưa có câu hỏi nào</h5>
                        <p class="text-muted small mx-auto" style="max-width: 300px;">
                            Nhập nội dung bài học và nhấn "Tạo câu hỏi" để AI tự động tạo câu hỏi trắc nghiệm
                        </p>
                    </div>

                    <!-- Questions List -->
                    <div id="questionsList" class="d-none overflow-auto pe-2" style="max-height: 600px;">
                        <!-- Questions will be inserted here -->
                    </div>

                    <!-- Save Button -->
                    <div id="saveSection" class="d-none mt-4 pt-3 border-top">
                        <button id="saveBtn" 
                                onclick="saveQuestions()" 
                                class="btn btn-success w-100 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Lưu vào ngân hàng câu hỏi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let generatedQuestions = [];
    let currentSubjectId = '';

    // Character count
    document.getElementById('contentInput').addEventListener('input', function() {
        document.getElementById('charCount').textContent = this.value.length + ' ký tự';
    });

    async function checkAIStatus() {
        try {
            const response = await fetch('/Admin/AIQuiz/CheckStatus');
            const data = await response.json();
            if (data.available) {
                location.reload();
            } else {
                alert('Ollama vẫn chưa khả dụng. Vui lòng kiểm tra lại.');
            }
        } catch (err) {
            console.error('Error checking AI status:', err);
        }
    }

    async function generateQuestions() {
        const content = document.getElementById('contentInput').value.trim();
        const subjectId = document.getElementById('subjectSelect').value;
        const questionCount = parseInt(document.getElementById('questionCount').value);
        const difficulty = document.getElementById('difficultySelect').value;

        // Validation
        if (!subjectId) {
            alert('Vui lòng chọn môn học');
            return;
        }

        if (content.length < 100) {
            alert('Nội dung bài học phải có ít nhất 100 ký tự');
            return;
        }

        // Show loading
        document.getElementById('emptyState').classList.add('d-none');
        document.getElementById('questionsList').classList.add('d-none');
        document.getElementById('saveSection').classList.add('d-none');
        document.getElementById('loadingState').classList.remove('d-none');
        document.getElementById('generateBtn').disabled = true;

        try {
            const response = await fetch('/Admin/AIQuiz/Generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    content: content,
                    subjectId: subjectId,
                    questionCount: questionCount,
                    difficulty: difficulty
                })
            });

            const data = await response.json();

            if (data.success && data.questions && data.questions.length > 0) {
                generatedQuestions = data.questions;
                currentSubjectId = subjectId;
                displayQuestions(data.questions);
            } else {
                alert(data.error || 'Không thể tạo câu hỏi. Vui lòng thử lại.');
                document.getElementById('emptyState').classList.remove('d-none');
            }
        } catch (err) {
            console.error('Error generating questions:', err);
            alert('Đã xảy ra lỗi. Vui lòng thử lại.');
            document.getElementById('emptyState').classList.remove('d-none');
        } finally {
            document.getElementById('loadingState').classList.add('d-none');
            document.getElementById('generateBtn').disabled = false;
        }
    }

    function displayQuestions(questions) {
        const container = document.getElementById('questionsList');
        container.innerHTML = '';

        questions.forEach((q, index) => {
            const questionHtml = `
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary rounded-pill">${index + 1}</span>
                                <span class="badge ${getDifficultyClass(q.difficulty)}">${getDifficultyLabel(q.difficulty)}</span>
                            </div>
                            <button onclick="removeQuestion(${index})" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                        <p class="fw-bold mb-3">${escapeHtml(q.content)}</p>
                        <div class="vstack gap-2">
                            ${q.options.map((opt, i) => `
                                <div class="d-flex align-items-center gap-3 p-2 rounded ${opt.isCorrect ? 'bg-success-subtle border border-success-subtle' : 'bg-light border'}">
                                    <span class="badge ${opt.isCorrect ? 'bg-success' : 'bg-secondary'} rounded-circle" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        ${String.fromCharCode(65 + i)}
                                    </span>
                                    <span class="${opt.isCorrect ? 'text-success fw-bold' : 'text-dark'} small flex-grow-1">${escapeHtml(opt.content)}</span>
                                    ${opt.isCorrect ? '<i class="fa-solid fa-circle-check text-success"></i>' : ''}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
            container.innerHTML += questionHtml;
        });

        document.getElementById('questionsList').classList.remove('d-none');
        document.getElementById('saveSection').classList.remove('d-none');
        document.getElementById('questionCountBadge').classList.remove('d-none');
        document.getElementById('questionCountBadge').textContent = questions.length + ' câu';
    }

    function getDifficultyClass(difficulty) {
        switch(difficulty) {
            case 'Easy': return 'bg-success';
            case 'Medium': return 'bg-warning text-dark';
            case 'Hard': return 'bg-danger';
            default: return 'bg-secondary';
        }
    }

    function getDifficultyLabel(difficulty) {
        switch(difficulty) {
            case 'Easy': return 'Dễ';
            case 'Medium': return 'Trung bình';
            case 'Hard': return 'Khó';
            default: return difficulty;
        }
    }

    function removeQuestion(index) {
        generatedQuestions.splice(index, 1);
        if (generatedQuestions.length === 0) {
            document.getElementById('questionsList').classList.add('d-none');
            document.getElementById('saveSection').classList.add('d-none');
            document.getElementById('questionCountBadge').classList.add('d-none');
            document.getElementById('emptyState').classList.remove('d-none');
        } else {
            displayQuestions(generatedQuestions);
        }
    }

    async function saveQuestions() {
        if (generatedQuestions.length === 0) {
            alert('Không có câu hỏi để lưu');
            return;
        }

        document.getElementById('saveBtn').disabled = true;
        document.getElementById('saveBtn').innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Đang lưu...';

        try {
            const response = await fetch('/Admin/AIQuiz/SaveQuestions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                    subjectId: currentSubjectId,
                    questions: generatedQuestions
                })
            });

            const data = await response.json();

            if (data.success) {
                alert(data.message);
                // Reset
                generatedQuestions = [];
                document.getElementById('questionsList').classList.add('d-none');
                document.getElementById('saveSection').classList.add('d-none');
                document.getElementById('questionCountBadge').classList.add('d-none');
                document.getElementById('emptyState').classList.remove('d-none');
                document.getElementById('contentInput').value = '';
                document.getElementById('charCount').textContent = '0 ký tự';
            } else {
                alert(data.error || 'Không thể lưu câu hỏi');
            }
        } catch (err) {
            console.error('Error saving questions:', err);
            alert('Đã xảy ra lỗi khi lưu câu hỏi');
        } finally {
            document.getElementById('saveBtn').disabled = false;
            document.getElementById('saveBtn').innerHTML = '<i class="fa-solid fa-floppy-disk me-2"></i> Lưu vào ngân hàng câu hỏi';
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
}
