@model Symphony.Portal.Web.Models.Assignment
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "Delete Assignment";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-danger">Are you sure you want to delete this assignment?</h6>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i> 
            <strong>Warning!</strong> This action cannot be undone. Assignments that have been accepted by instructors or have related exam data cannot be deleted.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.AssignmentType</dd>

            <dt class="col-sm-3">Class</dt>
            <dd class="col-sm-9">@(Model.Class?.ClassName ?? "N/A")</dd>

            <dt class="col-sm-3">Instructor</dt>
            <dd class="col-sm-9">@(Model.Instructor?.FullName ?? "Unassigned")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                 @if (Model.Status == AssignmentStatus.Assigned)
                {
                    <span class="badge bg-primary">Assigned</span>
                }
                else if (Model.Status == AssignmentStatus.Received)
                {
                    <span class="badge bg-success">Received</span>
                }
                else
                {
                    <span class="badge bg-danger">Cancelled</span>
                }
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
