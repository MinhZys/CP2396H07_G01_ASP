@model Symphony.Portal.Web.Models.Assignment
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Assignment Details</h6>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.AssignmentType</span>
                    </dd>

                    <dt class="col-sm-4">Term / Exam</dt>
                    <dd class="col-sm-8">@(Model.TermOrExamName ?? "N/A")</dd>

                    <dt class="col-sm-4">Class</dt>
                    <dd class="col-sm-8">@(Model.Class?.ClassName ?? "N/A")</dd>
                    
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@(Model.Class?.ClassCategory?.Name ?? "N/A")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Instructor</dt>
                    <dd class="col-sm-8">@(Model.Instructor?.FullName ?? "Unassigned")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == AssignmentStatus.Assigned)
                        {
                            <span class="badge bg-primary">Assigned</span>
                        }
                        else if (Model.Status == AssignmentStatus.Received)
                        {
                            <span class="badge bg-success">Received</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Created At</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <hr />

        <div class="mt-3">
            <h5>Note</h5>
            <div class="p-3 bg-light border rounded">
                @(string.IsNullOrEmpty(Model.Note) ? "No notes provided." : Model.Note)
            </div>
        </div>

        @if (Model.Status == AssignmentStatus.Cancelled && !string.IsNullOrEmpty(Model.CancellationReason))
        {
            <div class="mt-3">
                <h5 class="text-danger">Cancellation Reason</h5>
                <div class="p-3 bg-light border border-danger rounded text-danger">
                    @Model.CancellationReason
                </div>
            </div>
        }

        <div class="mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        </div>
    </div>
</div>
