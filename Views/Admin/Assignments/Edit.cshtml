@model Symphony.Portal.Web.Models.Assignment
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "Edit Assignment";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Edit Task Assignment</h6>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TermOrExamName" class="control-label"></label>
                <input asp-for="TermOrExamName" class="form-control" />
                <span asp-validation-for="TermOrExamName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="ClassId" class="control-label">Class (Room)</label>
                    <select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">-- Select Class --</option>
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="InstructorId" class="control-label">Instructor</label>
                    <select asp-for="InstructorId" class="form-select" asp-items="ViewBag.Instructors">
                        <option value="">-- Select Instructor --</option>
                    </select>
                    <span asp-validation-for="InstructorId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                 <div class="col-md-6 form-group mb-3">
                    <label asp-for="AssignmentType" class="control-label">Task Type</label>
                    <select asp-for="AssignmentType" class="form-select" asp-items="Html.GetEnumSelectList<AssignmentType>()"></select>
                    <span asp-validation-for="AssignmentType" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="Status" class="control-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AssignmentStatus>()" id="statusSelect"></select>
                     <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3" id="cancellationReasonGroup" style="@(Model.Status == AssignmentStatus.Cancelled ? "" : "display:none;")">
                <label asp-for="CancellationReason" class="control-label">Cancellation Reason</label>
                <textarea asp-for="CancellationReason" class="form-control" rows="2" placeholder="Explain why this task is cancelled..."></textarea>
                <span asp-validation-for="CancellationReason" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Note" class="control-label"></label>
                <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('statusSelect').addEventListener('change', function() {
            var reasonGroup = document.getElementById('cancellationReasonGroup');
            // Cancelled is likely value '2', but check enum order (Assigned=0, Received=1, Cancelled=2)
            // It's safer to check text or assume 2 based on Enum definition order.
            // AssignmentStatus: Assigned, Received, Cancelled
            if (this.value == '2') { 
                reasonGroup.style.display = 'block';
            } else {
                reasonGroup.style.display = 'none';
            }
        });
    </script>
}
