@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2 text-dark">Admin Dashboard</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-download me-1"></i> Export Report
            </button>
        </div>
    </div>
</div>

<!-- Info Cards Row -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                     <h5 class="card-title fw-bold"><i class="fas fa-user-graduate me-2"></i>Students</h5>
                     <h2 class="display-6 fw-bold my-2">--</h2> 
                </div>
                 <p class="card-text small opacity-75">New regs pending approval</p>
                 <a href="/Admin/StudentRegistration/Index" class="stretched-link text-white text-decoration-none small">View All <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                     <h5 class="card-title fw-bold"><i class="fas fa-chalkboard-teacher me-2"></i>Instructors</h5>
                     <h2 class="display-6 fw-bold my-2">--</h2>
                </div>
                <p class="card-text small opacity-75">Active course instructors</p>
                <a href="/Admin/Users/Index" class="stretched-link text-white text-decoration-none small">Manage <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
     <div class="col-md-3">
        <div class="card text-white bg-info h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                     <h5 class="card-title fw-bold"><i class="fas fa-book-open me-2"></i>Courses</h5>
                     <h2 class="display-6 fw-bold my-2">--</h2>
                </div>
                <p class="card-text small opacity-75">Active training courses</p>
                <a href="/Admin/Courses/Index" class="stretched-link text-white text-decoration-none small">View <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                 <div>
                     <h5 class="card-title fw-bold text-dark"><i class="fas fa-calendar-alt me-2"></i>Exams</h5>
                     <h2 class="display-6 fw-bold my-2 text-dark">--</h2>
                </div>
                <p class="card-text small text-dark opacity-75">Upcoming entrance exams</p>
                <a href="/Admin/EntranceExams/Index" class="stretched-link text-dark text-decoration-none small">Check Schedule <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3 text-secondary">Quick Access</h4>

<div class="row g-4">
    <!-- Academic Management -->
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fas fa-university me-2 text-primary"></i> Academic Management
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a href="/Admin/Courses/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-graduation-cap fa-2x text-primary mb-2"></i>
                            <span class="text-dark fw-bold">Courses</span>
                            <small class="text-muted d-block mt-1">Manage Curricula</small>
                        </a>
                    </div>
                     <div class="col-md-4">
                        <a href="/Admin/Lessons/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-chalkboard-teacher fa-2x text-info mb-2"></i>
                            <span class="text-dark fw-bold">Lessons</span>
                            <small class="text-muted d-block mt-1">Manage Content</small>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Admin/Classes/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-users-class fa-2x text-success mb-2"></i>
                            <span class="text-dark fw-bold">Classes</span>
                            <small class="text-muted d-block mt-1">Schedules & Rolls</small>
                        </a>
                    </div>
                     <div class="col-md-4">
                        <a href="/Admin/Subjects/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-book fa-2x text-secondary mb-2"></i>
                            <span class="text-dark fw-bold">Subjects</span>
                            <small class="text-muted d-block mt-1">Subject List</small>
                        </a>
                    </div>
                     <div class="col-md-4">
                        <a href="/Admin/EntranceExams/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-file-signature fa-2x text-warning mb-2"></i>
                            <span class="text-dark fw-bold">Entrance Exams</span>
                            <small class="text-muted d-block mt-1">Admissions</small>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Admin/TeacherAssignment/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-user-tie fa-2x text-danger mb-2"></i>
                            <span class="text-dark fw-bold">Teachers</span>
                            <small class="text-muted d-block mt-1">Assign Duties</small>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/Admin/ClassExams/Index" class="card card-hover text-decoration-none text-center p-3 border-light bg-light h-100">
                            <i class="fas fa-edit fa-2x text-purple-600 mb-2" style="color: #6f42c1;"></i>
                            <span class="text-dark fw-bold">Class Exams</span>
                            <small class="text-muted d-block mt-1">Schedule & Grade</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System & Users -->
    <div class="col-md-4">
         <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold py-3">
                <i class="fas fa-cogs me-2 text-secondary"></i> System & Settings
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <a href="/Admin/Users/Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div><i class="fas fa-users-cog me-2 text-muted"></i> User Management</div>
                        <i class="fas fa-chevron-right small text-muted"></i>
                    </a>
                    <a href="/Admin/CMS/Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div><i class="fas fa-globe me-2 text-muted"></i> Website Content (CMS)</div>
                        <i class="fas fa-chevron-right small text-muted"></i>
                    </a>
                    <a href="/Admin/StudentRegistration/Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                         <div><i class="fas fa-list-alt me-2 text-muted"></i> Registration Logs</div>
                         <i class="fas fa-chevron-right small text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover:hover {
        background-color: #e9ecef !important;
        transform: translateY(-2px);
        transition: all 0.2s;
        border-color: #dee2e6 !important;
    }
</style>
