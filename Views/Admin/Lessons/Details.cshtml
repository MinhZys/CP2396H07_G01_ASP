@model Symphony.Portal.Web.Models.Lesson

@{
    ViewData["Title"] = "Lesson Details";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="fas fa-info-circle me-2"></i>Lesson Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white me-2">
                <i class="fas fa-edit me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Info -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title text-dark fw-bold mb-3">@Model.Title</h3>
                    
                    <div class="mb-4">
                        <span class="badge bg-primary me-2">Course: @Model.Course?.Title</span>
                        <span class="badge bg-success me-2">Subject: @Model.Subject?.Name</span>
                        <span class="badge bg-secondary"><i class="far fa-clock me-1"></i> @Model.DurationMinutes mins</span>
                    </div>

                    <h5 class="text-muted border-bottom pb-2">Description</h5>
                    <p class="card-text text-justify">
                        @Model.Description
                    </p>

                    @if (!string.IsNullOrEmpty(Model.ContentLink))
                    {
                        <div class="alert alert-info mt-4">
                            <h5 class="alert-heading"><i class="fas fa-file-download me-2"></i>Lesson Material</h5>
                            <p>This lesson includes attached material. Click below to view or download.</p>
                            <a href="@Model.ContentLink" target="_blank" class="btn btn-primary">
                                Download / View File
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar / Thumbnail -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">Thumbnail</div>
                <div class="card-body text-center bg-light">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-height: 250px;" />
                    }
                    else
                    {
                        <div class="py-5 text-muted">
                            <i class="fas fa-image fa-4x mb-2"></i>
                            <p>No thumbnail available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
