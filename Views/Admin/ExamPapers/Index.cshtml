@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.ExamPaper>

@{
    ViewData["Title"] = "Manage Exam Papers";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-800 mb-1">Manage Exam Papers</h2>
            <p class="text-slate-500 mb-0">Create and manage entrance exam papers for the system.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Questions" class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
                <span class="material-symbols-outlined">database</span>
                Question Bank
            </a>
            <a asp-action="CreatePaper" class="btn btn-primary d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
                <span class="material-symbols-outlined">add</span>
                Create New Exam Paper
            </a>
        </div>
    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">error</span>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift transition-all">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">@item.Course?.Title</span>
                            <small class="text-slate-400 fw-medium">ID: @item.Id.Substring(0, 8)...</small>
                        </div>
                        <h5 class="fw-bold text-slate-800 mb-0">@item.Title</h5>
                    </div>
                    <div class="card-body px-4">
                        <div class="d-flex flex-column gap-3 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="material-symbols-outlined text-slate-500">schedule</span>
                                </div>
                                <div>
                                    <div class="small text-slate-400">Duration</div>
                                    <div class="fw-bold text-slate-700">@item.Duration minutes</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="material-symbols-outlined text-slate-500">quiz</span>
                                </div>
                                <div>
                                    <div class="small text-slate-400">Number of Questions</div>
                                    <div class="fw-bold text-slate-700">@item.ExamPaperQuestions.Count questions</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-slate-50 border-top-0 p-4">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border rounded-pill px-3 fw-bold text-slate-600 hover-primary">
                                    Details
                                </a>
                                <a asp-action="EditPaper" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                    Edit
                                </a>
                            </div>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold hover-bg-danger-subtle rounded-pill px-3">
                                    Delete Paper
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-slate-200 mb-3">
                    <span class="material-symbols-outlined display-1">description</span>
                </div>
                <h4 class="text-slate-400 fw-bold">No exam papers found</h4>
                <p class="text-slate-400 mb-4">Start by creating a new exam paper.</p>
                <a asp-action="CreatePaper" class="btn btn-primary rounded-pill px-4">Create Paper Now</a>
            </div>
        }
    </div>
    <partial name="_Pagination" model="Model" />
</div>
