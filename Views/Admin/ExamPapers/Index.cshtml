@model IEnumerable<Symphony.Portal.Web.Models.ExamPaper>

@{
    ViewData["Title"] = "Quản lý Đề thi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-800 mb-1">Quản lý Đề thi</h2>
            <p class="text-slate-500 mb-0">Tạo và quản lý các đề thi tuyển sinh của hệ thống.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Questions" class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
                <span class="material-symbols-outlined">database</span>
                Ngân hàng câu hỏi
            </a>
            <a asp-action="CreatePaper" class="btn btn-primary d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
                <span class="material-symbols-outlined">add</span>
                Tạo đề thi mới
            </a>
        </div>
    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">error</span>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift transition-all">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">@item.Subject?.Name</span>
                            <small class="text-slate-400 fw-medium">ID: @item.Id.Substring(0, 8)...</small>
                        </div>
                        <h5 class="fw-bold text-slate-800 mb-0">@item.Title</h5>
                    </div>
                    <div class="card-body px-4">
                        <div class="d-flex flex-column gap-3 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="material-symbols-outlined text-slate-500">schedule</span>
                                </div>
                                <div>
                                    <div class="small text-slate-400">Thời gian làm bài</div>
                                    <div class="fw-bold text-slate-700">@item.Duration phút</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="material-symbols-outlined text-slate-500">quiz</span>
                                </div>
                                <div>
                                    <div class="small text-slate-400">Số lượng câu hỏi</div>
                                    <div class="fw-bold text-slate-700">@item.ExamPaperQuestions.Count câu</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-slate-50 border-top-0 p-4">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border rounded-pill px-3 fw-bold text-slate-600 hover-primary">
                                    Chi tiết
                                </a>
                                <a asp-action="EditPaper" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                    Sửa
                                </a>
                            </div>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề thi này không?')">
                                <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold hover-bg-danger-subtle rounded-pill px-3">
                                    Xóa đề
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-slate-200 mb-3">
                    <span class="material-symbols-outlined display-1">description</span>
                </div>
                <h4 class="text-slate-400 fw-bold">Chưa có đề thi nào</h4>
                <p class="text-slate-400 mb-4">Hãy bắt đầu bằng cách tạo một đề thi mới.</p>
                <a asp-action="CreatePaper" class="btn btn-primary rounded-pill px-4">Tạo đề thi ngay</a>
            </div>
        }
    </div>
</div>
