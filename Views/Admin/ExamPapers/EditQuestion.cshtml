@model Symphony.Portal.Web.Models.Question

@{
    ViewData["Title"] = "Chỉnh sửa câu hỏi";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary p-4 border-0">
                    <h3 class="fw-bold text-white mb-1">Chỉnh sửa câu hỏi</h3>
                    <p class="text-white opacity-75 mb-0">Cập nhật nội dung, điểm số và đáp án cho câu hỏi.</p>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="EditQuestion" asp-route-id="@Model.Id" method="post" id="questionForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 rounded-3 bg-danger-subtle p-3 small border border-danger-subtle"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="SubjectId" class="form-label fw-bold text-slate-700">Môn học</label>
                                <select asp-for="SubjectId" class="form-select rounded-3 px-3 py-2 border-slate-200">
                                    @foreach (var sub in ViewBag.Subjects as List<Symphony.Portal.Web.Models.Subject>)
                                    {
                                        <option value="@sub.Id">@sub.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="SubjectId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-bold text-slate-700">Loại câu hỏi</label>
                                <select asp-for="Type" class="form-select rounded-3 px-3 py-2 border-slate-200" id="typeSelector">
                                    <option value="MultipleChoice">Trắc nghiệm</option>
                                    <option value="Essay">Tự luận</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>


                            <div class="col-12">
                                <label asp-for="Content" class="form-label fw-bold text-slate-700">Nội dung câu hỏi</label>
                                <textarea asp-for="Content" class="form-control rounded-4 border-slate-200 p-3" rows="4" placeholder="Nhập câu hỏi tại đây..."></textarea>
                                <span asp-validation-for="Content" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Score" class="form-label fw-bold text-slate-700">Điểm số</label>
                                <input asp-for="Score" class="form-control rounded-3 px-3 py-2 border-slate-200" type="number" step="0.5" />
                                <span asp-validation-for="Score" class="text-danger small"></span>
                            </div>
                        </div>


                        <!-- MCQ Options Section -->
                        <div id="optionsSection" class="mt-5 pt-4 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-bold text-slate-800 mb-0">Lựa chọn trả lời</h5>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-flex align-items-center gap-1" onclick="addOption()">
                                    <span class="material-symbols-outlined text-base">add</span> Thêm lựa chọn
                                </button>
                            </div>
                            <div id="optionsContainer">
                                <!-- Dynamic Options -->
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined">save</span>
                                Cập nhật câu hỏi
                            </button>
                            <a asp-action="Questions" class="btn btn-light px-4 py-2 rounded-pill fw-bold text-slate-600">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let optionIndex = 0;
        const existingOptions = @Html.Raw(Json.Serialize(Model.Options.Select(o => new { Content = o.Content, IsCorrect = o.IsCorrect })));

        function addOption(content = '', isCorrect = false) {
            const container = document.getElementById('optionsContainer');
            const row = document.createElement('div');
            row.className = 'mb-3 bg-slate-50 p-3 rounded-4 border border-slate-100 option-row animate-in';
            row.innerHTML = `
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <div class="form-check">
                            <input class="form-check-input ms-0 correct-radio" type="radio" name="correctOption" value="${optionIndex}" ${isCorrect ? 'checked' : ''}>
                            <input type="hidden" name="options[${optionIndex}].IsCorrect" value="${isCorrect}" class="is-correct-hidden">
                        </div>
                    </div>
                    <div class="col">
                        <input type="text" name="options[${optionIndex}].Content" value="${content}" class="form-control border-0 bg-white rounded-pill px-3" placeholder="Nhập nội dung lựa chọn..." required>
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-icon btn-light-danger rounded-circle border-0" onclick="this.closest('.option-row').remove()">
                            <span class="material-symbols-outlined text-red-500">delete</span>
                        </button>
                    </div>
                </div>
            `;
            container.appendChild(row);
            optionIndex++;
        }

        // Handle Type Change
        document.getElementById('typeSelector').addEventListener('change', function() {
            const section = document.getElementById('optionsSection');
            section.style.display = this.value === 'MultipleChoice' ? 'block' : 'none';
        });

        // Update IsCorrect hidden fields when radio changes
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('correct-radio')) {
                document.querySelectorAll('.is-correct-hidden').forEach(h => h.value = 'false');
                const selectedRow = e.target.closest('.option-row');
                selectedRow.querySelector('.is-correct-hidden').value = 'true';
            }
        });

        // Initialize with existing options
        window.onload = function() {
            const isMultipleChoice = document.getElementById('typeSelector').value === 'MultipleChoice';
            document.getElementById('optionsSection').style.display = isMultipleChoice ? 'block' : 'none';

            if (isMultipleChoice) {
                if (existingOptions.length > 0) {
                    existingOptions.forEach(opt => addOption(opt.Content, opt.IsCorrect));
                } else {
                    addOption();
                    addOption();
                }
            }
        }

        // Custom Radio logic for Model Binding
        document.getElementById('questionForm').onsubmit = function() {
            const rows = document.querySelectorAll('.option-row');
            rows.forEach((row, idx) => {
                const contentInput = row.querySelector('input[type="text"]');
                const hiddenCorrect = row.querySelector('.is-correct-hidden');
                
                // Update names to match indexed list
                contentInput.name = `options[${idx}].Content`;
                hiddenCorrect.name = `options[${idx}].IsCorrect`;
            });
            return true;
        };
    </script>
}

<style>
.animate-in { animation: slideUp 0.3s ease-out forwards; }
@@keyframes slideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}
.btn-light-danger { background: #fee2e2; }
.btn-light-danger:hover { background: #fecaca; }
.bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
</style>
