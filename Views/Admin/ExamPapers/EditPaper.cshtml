@model Symphony.Portal.Web.Models.ExamPaper

@{
    ViewData["Title"] = "Chỉnh sửa đề thi";
    var selectedIds = ViewBag.SelectedQuestionIds as List<string> ?? new List<string>();
}

<div class="container py-4">
    <form asp-action="EditPaper" asp-route-id="@Model.Id" method="post" id="paperForm">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                    <div class="card-header bg-slate-900 p-4 border-0">
                        <h4 class="fw-bold text-white mb-0">Thông tin đề thi</h4>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tên đề thi</label>
                            <input asp-for="Title" class="form-control rounded-pill px-3" placeholder="Ví dụ: Đề thi Tiếng Anh Kỳ 1 - A1" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SubjectId" class="form-label fw-bold">Môn học</label>
                            <select asp-for="SubjectId" class="form-select rounded-pill px-3" id="subjectFilter">
                                @foreach (var sub in ViewBag.Subjects as List<Symphony.Portal.Web.Models.Subject>)
                                {
                                    <option value="@sub.Id">@sub.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Duration" class="form-label fw-bold">Thời gian làm bài (phút)</label>
                            <input asp-for="Duration" class="form-control rounded-pill px-3" type="number" />
                            <span asp-validation-for="Duration" class="text-danger small"></span>
                        </div>

                        <div class="bg-light rounded-4 p-3 border border-slate-100">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-slate-500 small fw-bold">Tổng số câu hỏi:</span>
                                <span class="fw-bold text-primary" id="selectedCount">@selectedIds.Count</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-slate-500 small fw-bold">Tổng điểm:</span>
                                <span class="fw-bold text-success" id="totalScore">0.0</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold mt-4 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span class="material-symbols-outlined">save</span>
                            Cập nhật đề thi
                        </button>
                        <a asp-action="Index" class="btn btn-link w-100 text-slate-400 text-decoration-none small mt-2">Hủy bỏ</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white p-4 border-0 pb-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold text-slate-800 mb-0">Chọn câu hỏi cho đề thi</h4>
                            <div class="badge bg-primary rounded-pill px-3">Ngân hàng câu hỏi</div>
                        </div>
                        <div class="mt-3">
                            <input type="text" id="qSearch" class="form-control rounded-pill px-3 border-slate-100" placeholder="Tìm câu hỏi..." onkeyup="filterQuestions()">
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 700px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-slate-50 text-slate-500 small text-uppercase fw-bold sticky-top" style="top: 0; z-index: 10;">
                                    <tr>
                                        <th class="ps-4" style="width: 50px;">Chọn</th>
                                        <th>Nội dung câu hỏi</th>
                                        <th>Loại</th>
                                        <th>Độ khó</th>
                                        <th class="pe-4">Điểm</th>
                                    </tr>
                                </thead>
                                <tbody id="questionTable">
                                    @foreach (var q in ViewBag.Questions as List<Symphony.Portal.Web.Models.Question>)
                                    {
                                        var isSelected = selectedIds.Contains(q.Id);
                                        <tr class="question-row" data-subject="@q.SubjectId" data-content="@q.Content.ToLower()">
                                            <td class="ps-4">
                                                <div class="form-check">
                                                    <input class="form-check-input q-checkbox" type="checkbox" name="selectedQuestionIds" value="@q.Id" 
                                                           data-score="@q.Score" onchange="updateStats()" @(isSelected ? "checked" : "")>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="text-slate-800 fw-medium line-clamp-1">@q.Content</div>
                                                <small class="text-slate-400">@q.Subject?.Name</small>
                                            </td>
                                            <td>
                                                <small class="badge @(q.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning-emphasis") rounded-pill">
                                                    @(q.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "TN" : "TL")
                                                </small>
                                            </td>
                                            <td><small class="text-slate-500">@q.Difficulty</small></td>
                                            <td class="pe-4 fw-bold text-primary">@q.Score</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function updateStats() {
            const checkboxes = document.querySelectorAll('.q-checkbox:checked');
            let total = 0;
            checkboxes.forEach(cb => {
                total += parseFloat(cb.getAttribute('data-score')) || 0;
            });
            document.getElementById('selectedCount').innerText = checkboxes.length;
            document.getElementById('totalScore').innerText = total.toFixed(1);
        }

        function filterQuestions() {
            const search = document.getElementById('qSearch').value.toLowerCase();
            const subject = document.getElementById('subjectFilter').value;
            const rows = document.querySelectorAll('.question-row');

            rows.forEach(row => {
                const content = row.getAttribute('data-content');
                const rowSubject = row.getAttribute('data-subject');
                const matchesSearch = content.includes(search);
                const matchesSubject = !subject || rowSubject === subject;

                row.style.display = (matchesSearch && matchesSubject) ? '' : 'none';
            });
        }

        document.getElementById('subjectFilter').onchange = filterQuestions;

        // Initialize display and stats
        window.onload = function() {
            filterQuestions();
            updateStats();
        }
    </script>
}

<style>
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;  
  overflow: hidden;
}
.hover-lift { transform: translateY(0); transition: transform 0.2s; }
.hover-lift:hover { transform: translateY(-3px); }
</style>
