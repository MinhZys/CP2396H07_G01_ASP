@model Symphony.Portal.Web.Models.ExamPaper

@{
    ViewData["Title"] = "Chi tiết đề thi: " + Model.Title;
}

<div class="container py-4">
    <div class="mb-4 d-flex justify-content-between align-items-end">
        <div>
            <a asp-action="Index" class="btn btn-light btn-sm mb-3 d-inline-flex align-items-center gap-2 rounded-pill px-3 shadow-sm text-slate-600">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Quay lại danh sách
            </a>
            <h2 class="fw-bold text-slate-800 mb-1">Đề thi: @Model.Title</h2>
            <p class="text-slate-400 mb-0">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 me-2">@Model.Subject?.Name</span>
                <span class="small"><span class="material-symbols-outlined text-xs align-middle me-1">schedule</span>Thời gian: @Model.Duration phút</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-bold" onclick="window.print()">
                <span class="material-symbols-outlined align-middle me-1">print</span>
                In đề thi
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-slate-50 p-4 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined text-primary">format_list_numbered</span>
                    Cấu trúc đề thi (@Model.ExamPaperQuestions.Count câu hỏi)
                </h5>
                @{
                    double totalScore = Model.ExamPaperQuestions.Sum(epq => epq.Question?.Score ?? 0);
                }
                <div class="badge bg-success rounded-pill px-3 py-2">Tổng điểm: @totalScore.ToString("0.##")</div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @foreach (var epq in Model.ExamPaperQuestions.OrderBy(x => x.Order))
                {
                    <div class="list-group-item p-4 border-slate-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-3">
                                <span class="badge bg-slate-100 text-slate-500 rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">@epq.Order</span>
                                <h6 class="fw-bold text-slate-800 mb-0 pt-1">@epq.Question?.Content</h6>
                            </div>
                            <div class="text-end">
                                <span class="badge @(epq.Question?.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning-emphasis") rounded-pill px-3 small">
                                    @(epq.Question?.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "Trắc nghiệm" : "Tự luận")
                                </span>
                                <div class="small fw-bold text-slate-400 mt-1">@epq.Question?.Score điểm</div>
                            </div>
                        </div>

                        @if (epq.Question?.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice)
                        {
                            <div class="row g-3 ms-4 ps-2">
                                @foreach (var opt in epq.Question.Options)
                                {
                                    <div class="col-md-6">
                                        <div class="p-2 rounded-3 @(opt.IsCorrect ? "bg-success-subtle text-success fw-bold border border-success" : "text-slate-500 border border-transparent") small">
                                            <span class="material-symbols-outlined text-sm align-middle me-1">@(opt.IsCorrect ? "check_circle" : "radio_button_unchecked")</span>
                                            @opt.Content
                                            @if (opt.IsCorrect) { <span class="material-symbols-outlined text-xs ms-1">verified</span> }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="ms-4 ps-2 text-slate-400 small italic">
                                [ Thí sinh trình bày nội dung tự luận ]
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
@@media print {
    .btn, .badge.bg-primary-subtle, .badge.bg-success, .text-slate-400 { display: none !important; }
    .card { shadow: none !important; border: 1px solid #eee !important; }
    body { background: white !important; }
    .bg-slate-50 { background: #f8fafc !important; }
}
</style>

