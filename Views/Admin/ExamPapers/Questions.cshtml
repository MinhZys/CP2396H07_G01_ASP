@model Symphony.Portal.Web.Models.ViewModels.PaginatedList<Symphony.Portal.Web.Models.Question>

@{
    ViewData["Title"] = "Question Bank";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-slate-800 mb-1">Question Bank</h2>
            <p class="text-slate-500 mb-0">Manage multiple-choice and essay questions for subjects.</p>
        </div>
        <a asp-action="CreateQuestion" class="btn btn-success d-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
            <span class="material-symbols-outlined">add_circle</span>
            Add New Question
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">error</span>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center gap-3 mb-4" role="alert">
            <span class="material-symbols-outlined">check_circle</span>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Enhanced Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-body bg-slate-50 p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-slate-500 text-uppercase tracking-wider">Search</label>
                    <div class="input-group input-group-merge">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                            <span class="material-symbols-outlined text-slate-400">search</span>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 rounded-end-pill px-3" placeholder="Enter question content..." value="@Context.Request.Query["search"]">
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-slate-500 text-uppercase tracking-wider">Subject</label>
                    <select name="subjectId" class="form-select rounded-pill px-3">
                        <option value="">All Subjects</option>
                        @foreach (var sub in ViewBag.Subjects as List<Symphony.Portal.Web.Models.Subject>)
                        {
                            <option value="@sub.Id" selected="@(Context.Request.Query["subjectId"] == sub.Id)">@sub.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <span class="material-symbols-outlined text-base">filter_list</span>
                        Filter Results
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-2">
                                <span class="badge @(item.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "bg-info-subtle text-info border border-info-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle") rounded-pill px-3">
                                    @(item.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice ? "Multiple Choice" : "Essay")
                                </span>
                                <span class="badge bg-slate-100 text-slate-600 border border-slate-200 rounded-pill px-3">@item.Subject?.Name</span>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-primary h5 mb-0">@item.Score points</div>
                            </div>
                        </div>
                        <h6 class="fw-bold text-slate-800 mb-4 line-clamp-3" style="min-height: 4.5em;">@item.Content</h6>
                        
                        @if (item.Type == Symphony.Portal.Web.Models.Enums.QuestionType.MultipleChoice)
                        {
                            <div class="bg-slate-50 rounded-3 p-2">
                                @foreach (var opt in item.Options.Take(4))
                                {
                                    <div class="d-flex align-items-center gap-2 p-2 @(opt.IsCorrect ? "text-success fw-bold" : "text-slate-500") small">
                                        <span class="material-symbols-outlined text-sm">@(opt.IsCorrect ? "check_circle" : "radio_button_unchecked")</span>
                                        <span class="text-truncate">@opt.Content</span>
                                    </div>
                                }
                                @if (item.Options.Count > 4)
                                {
                                    <div class="text-center py-1 small text-slate-400">... and @(item.Options.Count - 4) other options</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bg-slate-50 rounded-3 p-3 text-slate-400 small italic text-center">
                                Essay question (Candidate enters text)
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white border-top-0 p-3 text-end">
                         <a asp-action="EditQuestion" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                             <span class="material-symbols-outlined text-sm">edit</span> Edit
                         </a>
                         <form asp-action="DeleteQuestion" asp-route-id="@item.Id" method="post" style="display:inline;">
                             <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none px-3">
                                 <span class="material-symbols-outlined text-sm">delete</span> Delete
                             </button>
                         </form>
                     </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="text-slate-200 mb-3">
                    <span class="material-symbols-outlined display-1">search_off</span>
                </div>
                <h4 class="text-slate-400 fw-bold">No questions found</h4>
                <p class="text-slate-400">Try changing keywords or filters.</p>
            </div>
        }
    </div>
    <partial name="_Pagination" model="Model" />
</div>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;  
  overflow: hidden;
}
</style>

