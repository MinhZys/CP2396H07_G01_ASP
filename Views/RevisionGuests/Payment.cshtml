@model Symphony.Portal.Web.Models.RevisionRegistration

@{
    ViewData["Title"] = "Revision Course Payment";
    var fee = Model.RevisionPackage?.Fee ?? 0;
}

<div class="min-h-screen bg-background-dark py-12 px-4">
    <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- REGISTRATION INFO -->
        <div class="bg-surface-dark border border-slate-800 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-6">Registration Details</h3>

            <div class="space-y-4">
                <div class="flex justify-between">
                    <span class="text-slate-400">Full Name</span>
                    <span class="text-white">@Model.FullName</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Email</span>
                    <span class="text-white">@Model.Email</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Package</span>
                    <span class="text-primary font-bold">@Model.RevisionPackage?.Title</span>
                </div>
            </div>

            <div class="border-t border-slate-700 mt-6 pt-4 flex justify-between">
                <span class="text-slate-400">Total Amount</span>
                <span class="text-3xl font-bold text-white">
                    @fee.ToString("N0")đ
                </span>
            </div>
        </div>

        <!-- PAYMENT METHODS -->
        <div class="bg-surface-dark border border-slate-800 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-6">Payment Method</h3>

            <form asp-action="ConfirmPayment" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="space-y-4 mb-6">
                    <label class="block">
                        <input type="radio" name="paymentMethod" value="Online" checked />
                        <span class="ml-2 text-white">Online Payment (VNPay)</span>
                    </label>

                    <label class="block">
                        <input type="radio" name="paymentMethod" value="Cash" />
                        <span class="ml-2 text-white">Cash Payment</span>
                    </label>
                </div>

                <button type="submit"
                        class="w-full bg-primary text-background-dark font-bold py-3 rounded-lg"
                        onclick="this.disabled=true; this.form.submit();">
                    Confirm Payment
                </button>
            </form>

        </div>
    </div>
</div>
