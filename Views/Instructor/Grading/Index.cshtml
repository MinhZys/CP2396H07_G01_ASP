@model IEnumerable<Symphony.Portal.Web.Models.StudentExamSession>

@{
    ViewData["Title"] = "Chấm điểm thi";
    // Layout = "_InstructorLayout"; // If there is an instructor layout
}

<div class="container-fluid py-4">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold text-slate-800"><span class="material-symbols-outlined align-middle me-2">grade</span>Quản lý Chấm điểm</h1>
            <p class="text-muted mb-0">Danh sách bài thi của thí sinh cần được chấm hoặc thẩm định.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-slate-50 text-slate-500 small text-uppercase fw-bold">
                    <tr>
                        <th class="ps-4">Thí sinh</th>
                        <th>Kỳ thi</th>
                        <th>Đề thi</th>
                        <th>Thời gian nộp</th>
                        <th>Trạng thái</th>
                        <th>Điểm số</th>
                        <th>Xếp loại</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody class="text-slate-600 border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(item.Student?.FullName) ? "?" : item.Student.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block text-slate-800">@item.Student?.FullName</span>
                                        <small class="text-slate-400">@item.Student?.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-slate-100 text-slate-600 border border-slate-200 fw-medium">@item.EntranceExam?.Title</span></td>
                            <td>@item.ExamPaper?.Title</td>
                            <td>@item.EndTime?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case Symphony.Portal.Web.Models.Enums.ExamSessionStatus.Taking:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">Đang thi</span>
                                        break;
                                    case Symphony.Portal.Web.Models.Enums.ExamSessionStatus.Finished:
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">Chờ chấm điểm</span>
                                        break;
                                    case Symphony.Portal.Web.Models.Enums.ExamSessionStatus.Graded:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Đã chấm</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-primary fs-5">@item.TotalScore.ToString("0.##")</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.GradeLevel))
                                {
                                    var colorClass = item.GradeLevel switch
                                    {
                                        "Level A" => "bg-success",
                                        "Level B" => "bg-info",
                                        "Level C" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                    <span class="badge @colorClass rounded-pill px-3">@item.GradeLevel</span>
                                }
                                else
                                {
                                    <span class="text-slate-300">--</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="GradeSession" asp-route-id="@item.Id" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 rounded-pill shadow-sm">
                                    <span class="material-symbols-outlined text-sm">edit_note</span>
                                    @(item.Status == Symphony.Portal.Web.Models.Enums.ExamSessionStatus.Graded ? "Xem lại" : "Chấm điểm")
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-slate-300 mb-2">
                                    <span class="material-symbols-outlined display-4">inbox</span>
                                </div>
                                <p class="text-slate-500">Không có bài thi nào cần chấm điểm.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
