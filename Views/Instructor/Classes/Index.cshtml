@model IEnumerable<Symphony.Portal.Web.Models.Assignment>
@using Symphony.Portal.Web.Models.Enums
@using System.Collections.Generic

@{
    ViewData["Title"] = "My Classroom";
    var studentCounts = ViewBag.StudentCounts as Dictionary<string, int>;
}

<h2>My Classes</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Students</th>
            <th>Term</th>
            <th>Note</th>
            <th>Status</th>
            <th>Assigned At</th>
            <th style="width:260px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var classId = item.ClassId;
            var count = 0;

            if (studentCounts != null && !string.IsNullOrEmpty(classId) && studentCounts.ContainsKey(classId))
            {
                count = studentCounts[classId];
            }

            <tr>
                <td>@item.Class?.ClassName</td>
                <td>@count</td>
                <td>@item.TermOrExamName</td>
                <td>@item.Note</td>
                <td>
                    @item.Status
                    @if (item.Status == AssignmentStatus.Cancelled && !string.IsNullOrWhiteSpace(item.CancellationReason))
                    {
                        <div class="text-danger small">
                            Reason: @item.CancellationReason
                        </div>
                    }
                </td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @* Cancel/Reject *@
                    @if (item.Status != AssignmentStatus.Cancelled)
                    {
                        <a asp-action="Cancel" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger me-1">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <a asp-action="Cancel" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary me-1">
                            View Reason
                        </a>
                    }

                    @* Assign lesson *@
                    <a asp-action="AssignLesson" asp-route-classId="@item.ClassId"
                       class="btn btn-sm btn-outline-primary">
                        Assign Lesson
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
