@model IEnumerable<Symphony.Portal.Web.Models.Class>

@{
    ViewData["Title"] = "My Classes";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">My Assigned Classes</h1>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not been assigned to any classes yet.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-left-primary">
                    <div class="card-body">
                        <h5 class="card-title text-primary fw-bold">
                            @item.Name 
                            <span class="badge bg-secondary text-white float-end" style="font-size: 0.8rem;">@item.Course?.Title</span>
                        </h5>
                        
                        <p class="card-text mt-3">
                            <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                            <strong>Room:</strong> @(item.IsOnline ? "Online" : item.Room)
                        </p>
                        
                        <p class="card-text">
                            <i class="far fa-calendar-alt me-2 text-muted"></i>
                            <strong>Time:</strong> @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                        </p>
                        
                        <p class="card-text">
                            <i class="fas fa-users me-2 text-muted"></i>
                            <strong>Students:</strong> @item.Enrollments.Count Enrolled
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-list-ul me-1"></i> View Student List
                            </a>
                            <a asp-controller="Materials" asp-action="Index" asp-route-classId="@item.Id" class="btn btn-outline-success btn-sm">
                                <i class="fas fa-file-upload me-1"></i> Upload Material
                            </a>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <small class="text-muted">
                            Status: 
                            @if(item.EndDate < DateTime.Now) { <span class="text-danger">Ended</span> }
                            else if(item.StartDate > DateTime.Now) { <span class="text-info">Starting Soon</span> }
                            else { <span class="text-success fw-bold">Ongoing</span> }
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
}
