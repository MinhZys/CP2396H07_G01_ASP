@model IEnumerable<Symphony.Portal.Web.Models.Assignment>
@using Symphony.Portal.Web.Models.Enums
@using System.Collections.Generic

@{
    ViewData["Title"] = "My Classroom";
    var studentCounts = ViewBag.StudentCounts as Dictionary<string, int>;
}

<h2>My Classes</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Class</th>
            <th>Students</th>
            <th>Term</th>
            <th>Note</th>
            <th>Status</th>
            <th>Assigned At</th>
            <th style="width:260px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var classId = item.ClassId;
            var count = 0;

            if (studentCounts != null && !string.IsNullOrEmpty(classId) && studentCounts.ContainsKey(classId))
            {
                count = studentCounts[classId];
            }

            <tr>
                <td>@item.Class?.ClassName</td>
                <td>@count</td>
                <td>@item.TermOrExamName</td>
                <td>@item.Note</td>
                <td>
                    @item.Status
                    @if (item.Status == AssignmentStatus.Cancelled && !string.IsNullOrWhiteSpace(item.CancellationReason))
                    {
                        <div class="text-danger small">
                            Reason: @item.CancellationReason
                        </div>
                    }
                </td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>
                    @* Cancel/Reject *@
                    @if (item.Status != AssignmentStatus.Cancelled)
                    {
                        <a asp-action="Cancel" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger me-1">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <a asp-action="Cancel" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-secondary me-1">
                            View Reason
                        </a>
                    }

                    @if (item.Status == AssignmentStatus.Received && item.Class?.Status != ClassStatus.Completed)
                    {
                         <form asp-action="Complete" asp-route-id="@item.Id" method="post" class="d-inline"
                               onsubmit="return confirm('Are you sure you want to mark this class as COMPLETED? This will notify the Admin to schedule the exam.');">
                            <button type="submit" class="btn btn-sm btn-success text-white">
                                <i class="fas fa-check-circle"></i> Complete
                            </button>
                        </form>
                    }
                    else if (item.Status == AssignmentStatus.Completed || item.Class?.Status == ClassStatus.Completed)
                    {
                        <span class="badge bg-success"><i class="fas fa-check"></i> Done</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
