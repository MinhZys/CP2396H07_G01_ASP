@model IEnumerable<Symphony.Portal.Web.Models.ClassLesson>

@{
    ViewData["Title"] = "Assign Lesson";
    var classId = (string)ViewBag.ClassId;
    var className = (string)ViewBag.ClassName;
}

<h3>Assign Lessons to Class: @className</h3>

<form asp-action="AssignLesson" method="post" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="classId" value="@classId" />

    <div class="col-md-6">
        <select class="form-select" name="lessonId" asp-items="ViewBag.Lessons" required>
            <option value="">-- Select a lesson --</option>
        </select>
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Assign</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

<h5>Assigned Lessons</h5>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Lesson</th>
            <th>Assigned At</th>
            <th style="width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Lesson?.Title</td>
                <td>@item.AssignedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <form asp-action="RemoveLesson" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="classId" value="@classId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
