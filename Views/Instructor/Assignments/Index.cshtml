@model IEnumerable<Symphony.Portal.Web.Models.Assignment>
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "My Assignments";
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">My Task Assignments</h6>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info">You have no tasks assigned at the moment.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Status</th>
                            <th>Title</th>
                            <th>Term / Exam</th>
                            <th>Type</th>
                            <th>Class / Room</th>
                            <th>Assigned Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">View Details</a>
                                </td>
                                <td>
                                     @if (item.Status == AssignmentStatus.Assigned)
                                    {
                                        <span class="badge bg-primary">New!</span>
                                    }
                                    else if (item.Status == AssignmentStatus.Received)
                                    {
                                        <span class="badge bg-success">Received</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>@item.TermOrExamName</td>
                                <td><span class="badge bg-secondary">@item.AssignmentType</span></td>
                                <td>
                                    @if(item.Class != null) {
                                        <strong>@item.Class.ClassName</strong> <br/>
                                        <small class="text-muted">Seats: @item.Class.NumberOfSeats</small>
                                    } else {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
