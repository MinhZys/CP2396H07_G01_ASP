@model Symphony.Portal.Web.Models.Lesson

@{
    ViewData["Title"] = "Edit Lesson";

}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-primary mb-0"><i class="fas fa-edit me-2"></i>Edit Lesson</h2>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <!-- Keep existing image/content if not changed -->
                    <input type="hidden" asp-for="Image" />
                    <input type="hidden" asp-for="ContentLink" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label fw-bold">Lesson Title</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CourseId" class="form-label fw-bold">Course</label>
                            <select asp-for="CourseId" class="form-select" asp-items="ViewBag.CourseId"></select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SubjectId" class="form-label fw-bold">Subject</label>
                            <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId"></select>
                            <span asp-validation-for="SubjectId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="imageFile" class="form-label fw-bold">Lesson Thumbnail</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="mt-2">
                                    <small class="text-muted">Current Image:</small><br />
                                    <img src="@Model.Image" alt="Current" class="img-thumbnail" style="height: 80px;" />
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DurationMinutes" class="form-label fw-bold">Duration (Minutes)</label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" />
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label for="contentFile" class="form-label fw-bold">Lesson Content (File)</label>
                            <input type="file" name="contentFile" class="form-control" />
                            @if (!string.IsNullOrEmpty(Model.ContentLink))
                            {
                                <div class="mt-2 alert alert-info py-2 px-3 d-inline-block">
                                    <i class="fas fa-file-alt me-2"></i>
                                    <a href="@Model.ContentLink" target="_blank" class="text-decoration-none">View Current File</a>
                                </div>
                            }
                            <div class="form-text">Upload new file to replace the current one.</div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning btn-lg text-white">
                            <i class="fas fa-save me-2"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
