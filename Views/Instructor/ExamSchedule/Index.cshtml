@model IEnumerable<Symphony.Portal.Web.Models.Assignment>
@using Symphony.Portal.Web.Models.Enums

@{
    ViewData["Title"] = "Exam Schedule";
}

<div class="container-fluid">
    <h2 class="text-primary">Invigilation Assignments</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Term / Exam Name</th>
                <th>Class</th>
                <th>Instructor</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Action</th> <!-- Thêm cột Action để hiển thị nút cancel -->
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in Model)
            {
                <tr>
                    <td>@assignment.Title</td>
                    <td>@assignment.TermOrExamName</td>
                    <td>@assignment.Class?.ClassName</td> <!-- Hiển thị tên lớp -->
                    <td>@assignment.Instructor?.FullName</td> <!-- Hiển thị tên giảng viên -->
                    <td>@assignment.Status.ToString()</td> <!-- Hiển thị trạng thái bài tập (trạng thái được lấy từ Assignment.Status) -->
                    <td>@assignment.CreatedAt.ToString("yyyy-MM-dd")</td> <!-- Hiển thị ngày tạo -->

                    <!-- Nếu trạng thái chưa bị hủy bỏ, hiển thị nút Cancel -->
                    @if (assignment.Status != AssignmentStatus.Cancelled)
                    {
                        <td>
                            <a href="@Url.Action("Cancel", "ExamSchedule", new { id = assignment.Id })" class="btn btn-danger">
                                Cancel
                            </a>
                        </td>
                    }
                    else
                    {
                        <td>Cancelled</td> <!-- Nếu bài giám sát đã bị hủy, hiển thị "Cancelled" -->
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
