<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Symphony Instructor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="main-header">
        <button class="mobile-menu-toggle" onclick="toggleMobileSidebar()">
            <i class="fas fa-bars fa-lg"></i>
        </button>

        <div class="brand-section">
            <i class="fas fa-chalkboard-teacher brand-icon"></i>
            <span class="brand-text">Symphony Instructor</span>
        </div>

        <div class="header-actions">
            <div class="user-info">
                <div class="user-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <span>Welcome, Instructor</span>
            </div>

            <a class="header-btn" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                <i class="fas fa-external-link-alt me-1"></i>
                <span class="d-none d-md-inline">Go to Site</span>
            </a>

            @* <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline"> *@
            @*     <button type="submit" class="header-btn"> *@
            @*         <i class="fas fa-sign-out-alt me-1"></i> *@
            @*         <span class="d-none d-md-inline">Sign Out</span> *@
            @*     </button> *@
            @* </form> *@
        </div>
    </header>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-toggle" onclick="toggleSidebar()">
            <i class="fas fa-chevron-left"></i>
        </div>

        <ul class="sidebar-nav nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-area="Instructor" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt nav-icon"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <h6 class="sidebar-heading">TEACHING</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Classes" ? "active" : "")"
                   asp-area="Instructor" asp-controller="Classes" asp-action="Index">
                    <i class="fas fa-chalkboard nav-icon"></i>
                    <span class="nav-text">My Classes</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TeachingSchedule" ? "active" : "")"
                   href="/instructor/teaching-schedule">
                    <i class="fas fa-calendar-alt nav-icon"></i>
                    <span class="nav-text">Teaching Schedule</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lessons" ? "active" : "")"
                   asp-area="Instructor" asp-controller="Lessons" asp-action="Index">
                    <i class="fas fa-book-open nav-icon"></i>
                    <span class="nav-text">Lessons</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grading" ? "active" : "")"
                   asp-area="Instructor" asp-controller="Grading" asp-action="Index">
                    <i class="fas fa-user-graduate nav-icon"></i>
                    <span class="nav-text">Grading & Scores</span>
                </a>
            </li>

            <h6 class="sidebar-heading">MANAGEMENT</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ExamSchedule" ? "active" : "")"
                   asp-area="Instructor" asp-controller="ExamSchedule" asp-action="Index">
                    <i class="fas fa-calendar-check nav-icon"></i>
                    <span class="nav-text">Exam Schedule</span>
                </a>
            </li>

            <h6 class="sidebar-heading">ACCOUNT</h6>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                   asp-area=""
                   asp-controller="Profile"
                   asp-action="Index">
                    <i class="fas fa-user-circle nav-icon"></i>
                    <span class="nav-text">My Profile</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/system-notifications.js"></script>

    <script>
        // Show notifications
        document.addEventListener("DOMContentLoaded", function () {
            SystemNotification.showMessages(
                '@Html.Raw(TempData["Success"])',
                '@Html.Raw(TempData["Error"])'
            );
            SystemNotification.setupDeleteConfirmations();
        });

        // Toggle sidebar collapse
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');

            const icon = sidebar.querySelector('.sidebar-toggle i');
            icon.classList.toggle('fa-chevron-left');
            icon.classList.toggle('fa-chevron-right');

            // Save state to localStorage
            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        // Toggle mobile sidebar
        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('mobile-open');
        }

        // Close mobile sidebar when clicking outside
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.querySelector('.mobile-menu-toggle');

            if (window.innerWidth <= 768 &&
                !sidebar.contains(event.target) &&
                !toggle.contains(event.target) &&
                sidebar.classList.contains('mobile-open')) {
                sidebar.classList.remove('mobile-open');
            }
        });

        // Restore sidebar state
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById('sidebar');
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';

            if (isCollapsed) {
                sidebar.classList.add('collapsed');
                const icon = sidebar.querySelector('.sidebar-toggle i');
                icon.classList.remove('fa-chevron-left');
                icon.classList.add('fa-chevron-right');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>