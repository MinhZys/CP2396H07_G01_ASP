<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="hero-overlay"></div>
    <div class="container hero-content fade-in-up">
        <h1 class="hero-title">Nâng tầm sự nghiệp CNTT cùng Symphony</h1>
        <p class="hero-subtitle mb-4">Mở khóa tiềm năng của bạn với các khóa học Lập trình, Mạng và Cơ sở dữ liệu chuẩn quốc tế.</p>
        
        <div class="d-flex justify-content-center gap-3 mb-5">
            <a href="#courses" class="btn btn-primary-custom">Xem khóa học</a>
            <a href="#contact" class="btn btn-outline-custom">Tư vấn miễn phí</a>
        </div>

        <!-- Search Bar -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="search-container d-flex gap-2">
                    <input type="text" class="form-control form-control-custom flex-grow-1" placeholder="Bạn muốn học gì hôm nay? (VD: Java, SQL...)">
                    <select class="form-select form-select-custom w-25 d-none d-md-block">
                        <option value="">Tất cả danh mục</option>
                        <option value="software">Software Dev</option>
                        <option value="network">Networking</option>
                        <option value="db">Database</option>
                    </select>
                    <button class="btn btn-primary-custom px-4"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5 fade-in-up">
            <h2 class="section-title">Tại sao chọn Symphony?</h2>
        </div>
        <div class="row">
            <div class="col-md-3 mb-4 fade-in-up">
                <div class="feature-box h-100">
                    <i class="fa-solid fa-medal feature-icon"></i>
                    <h4>Chứng chỉ Quốc tế</h4>
                    <p class="text-muted">Chương trình đào tạo chuẩn global, được công nhận bởi các tập đoàn lớn.</p>
                </div>
            </div>
            <div class="col-md-3 mb-4 fade-in-up">
                <div class="feature-box h-100">
                    <i class="fa-solid fa-chalkboard-user feature-icon"></i>
                    <h4>Giảng viên Chuyên gia</h4>
                    <p class="text-muted">Đội ngũ giảng viên giàu kinh nghiệm thực chiến từ doanh nghiệp.</p>
                </div>
            </div>
             <div class="col-md-3 mb-4 fade-in-up">
                <div class="feature-box h-100">
                    <i class="fa-solid fa-laptop-code feature-icon"></i>
                    <h4>Thực hành 70%</h4>
                    <p class="text-muted">Hệ thống phòng Lab hiện đại, cam kết thời lượng thực hành lên đến 70%.</p>
                </div>
            </div>
             <div class="col-md-3 mb-4 fade-in-up">
                <div class="feature-box h-100">
                    <i class="fa-solid fa-briefcase feature-icon"></i>
                    <h4>Hỗ trợ Việc làm</h4>
                    <p class="text-muted">Kết nối doanh nghiệp, hỗ trợ phỏng vấn và tư vấn career path trọn đời.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses -->
<section id="courses" class="section-padding">
    <div class="container">
        <div class="text-center mb-5 fade-in-up">
            <h2 class="section-title">Khóa học Nổi bật</h2>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4 fade-in-up">
                    <div class="course-card">
                        <div class="course-img-wrapper">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="@item.Title" class="course-img">
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/800x600?text=No+Image" alt="@item.Title" class="course-img">
                                }
                            </a>
                            @if (item.Level == CourseLevel.Advanced)
                            {
                                <span class="badge badge-custom badge-hot">HOT</span>
                            }
                            else if (item.Level == CourseLevel.Beginner)
                            {
                                <span class="badge badge-custom badge-new">NEW</span>
                            }
                        </div>
                        <div class="course-body">
                            <h5 class="course-title">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Title</a>
                            </h5>
                            <div class="course-meta d-flex justify-content-between">
                                <span><i class="fa-regular fa-clock"></i> @item.DurationMonths Tháng</span>
                                <span><i class="fa-solid fa-layer-group"></i> @item.Level</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="course-rating">
                                    <i class="fa-solid fa-star text-warning"></i>
                                    <i class="fa-solid fa-star text-warning"></i>
                                    <i class="fa-solid fa-star text-warning"></i>
                                    <i class="fa-solid fa-star text-warning"></i>
                                    <i class="fa-solid fa-star text-warning"></i>
                                    <small class="text-muted">(5.0)</small>
                                </div>
                                <div class="course-price">$@item.TuitionFee.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4 fade-in-up">
             <a href="#" class="btn btn-outline-dark rounded-pill px-5 py-2">Xem toàn bộ khóa học</a>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="section-padding bg-dark text-white text-center">
    <div class="container fade-in-up">
        <h2 class="section-title text-white">Sẵn sàng bắt đầu hành trình của bạn?</h2>
        <p class="mb-5 lead">Đừng bỏ lỡ cơ hội trở thành chuyên gia công nghệ được săn đón hàng đầu.</p>
        <a href="#" class="btn btn-primary-custom btn-lg">Đăng ký tư vấn ngay</a>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js"></script>
}
