            <div class="col-md-4 mb-4 fade-in-up">
                <div class="course-card">
                    <div class="course-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1579403124614-197669d231e8?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="DevOps" class="course-img">
                    </div>
                    <div class="course-body">
                        <h5 class="course-title">DevOps Engineering</h5>
