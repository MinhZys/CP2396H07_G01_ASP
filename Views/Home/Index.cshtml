                             <div class="course-rating">
                                 <i class="fa-solid fa-star"></i>
                                 <i class="fa-solid fa-star"></i>
                                 <i class="fa-solid fa-star"></i>
                                 <i class="fa-solid fa-star"></i>
                                 <i class="fa-regular fa-star"></i>
                                 <small class="text-muted">(4.3)</small>
                             </div>
                             <div class="course-price">$4,275</div>
