@model IEnumerable<Symphony.Portal.Web.Models.Course>
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <style>
        .cyber-card {
            border: 1px solid rgba(0, 200, 255, 0.1);
            background: #1e2633;
        }
        .cyber-card:active {
            border-color: #00c8ff;
            background: rgba(0, 200, 255, 0.05);
        }
    </style>
}

<!-- Hero Section -->
<header class="relative overflow-hidden">
    <div class="relative z-10 px-6 py-16 md:py-32 max-w-7xl mx-auto">
        <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                </span>
                Next cohort starts in 4 days
            </div>
            <h1 class="font-display text-5xl md:text-7xl font-bold leading-[1.1] tracking-tight mb-6">
                <span data-i18n="hero.title">Master Technology Today</span>
            </h1>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-10 max-w-md leading-relaxed" data-i18n="hero.subtitle">
                Unlock your potential with industry-leading IT certifications and expert-led mentorship in cloud, security, and dev.
            </p>
            <div class="flex flex-wrap gap-4">
                <button class="bg-primary text-background-dark px-8 py-4 rounded-lg font-bold font-display hover:opacity-90 transition-all flex items-center gap-2" onclick="window.location.href='/Courses'">
                    <span data-i18n="hero.explore_btn">Explore Courses</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
                <button class="bg-white/5 border border-white/10 dark:bg-surface-dark px-8 py-4 rounded-lg font-bold font-display hover:bg-white/10 transition-all"
                        onclick="location.href='@Url.Action("Index", "Lessons", new { area = "Student" })'">
                    <span data-i18n="View Lessons">View Lessons</span>
                </button>

                <button class="bg-white/5 border border-white/10 dark:bg-surface-dark px-8 py-4 rounded-lg font-bold font-display hover:bg-white/10 transition-all" onclick="window.location.href='/Mentors'">
                    <span data-i18n="hero.view_mentors_btn">View Mentors</span>
                </button>
            </div>
        </div>
    </div>
    <!-- Background Decorative Element -->
    <div class="absolute top-0 right-0 w-full h-full -z-0 opacity-20 dark:opacity-40">
        <div class="absolute inset-0 bg-gradient-to-t from-background-dark to-transparent"></div>
        <div class="w-full h-full bg-[url('https://placeholder.pics/svg/1200')] bg-cover bg-center" data-alt="High-tech server room with glowing blue lights"></div>
    </div>
</header>

<!-- Featured Courses Section -->
<section class="py-12 px-4 max-w-7xl mx-auto" id="courses">
    <div class="flex items-end justify-between mb-8 px-2">
        <div>
            <p class="text-primary font-bold text-xs uppercase tracking-[0.2em] mb-2">Curated Paths</p>
            <h2 class="font-display text-3xl font-bold" data-i18n="nav.courses">Featured Courses</h2>
        </div>
        <a class="text-sm font-bold text-primary flex items-center gap-1 hover:underline" asp-controller="Courses" asp-action="Index">
            View All <span class="material-symbols-outlined text-sm">open_in_new</span>
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        @foreach (var item in Model.Take(3)) {
            <!-- Card -->
            <div class="cyber-card rounded-xl overflow-hidden group cursor-pointer" onclick="window.location.href='@Url.Action("Details", "Courses", new { id = item.Id })'">
                <div class="relative aspect-video overflow-hidden">
                    <div class="absolute inset-0 bg-cover bg-center group-hover:scale-105 transition-transform duration-500" style="background-image: url('@(string.IsNullOrEmpty(item.Image) ? "https://placeholder.pics/svg/600" : item.Image)');"></div>
                    <div class="absolute top-3 left-3 bg-background-dark/80 backdrop-blur-md px-2 py-1 rounded text-[10px] font-bold text-primary uppercase">
                        @(item.Category?.Name ?? "Featured")
                    </div>
                </div>
                <div class="p-5">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="font-display font-bold text-lg group-hover:text-primary transition-colors">@item.Title</h3>
                        <span class="text-primary font-bold">$@item.TuitionFee.ToString("N0")</span>
                    </div>

                    @* Rating Section *@
                    <div class="flex items-center gap-2 mb-3">
                         <div class="flex text-yellow-500 text-xs">
                             @{
                                 var avgRating = item.CourseReviews.Any() ? item.CourseReviews.Average(r => r.Rating) : 0;
                                 var reviewCount = item.CourseReviews.Count;
                                 
                                 for(int i=1; i<=5; i++) {
                                     if(avgRating >= i) { <span class="material-symbols-outlined text-sm fill-current">star</span> }
                                     else if(avgRating >= i - 0.5) { <span class="material-symbols-outlined text-sm">star_half</span> }
                                     else { <span class="material-symbols-outlined text-sm text-slate-600">star</span> }
                                 }
                             }
                        </div>
                        <span class="text-xs text-slate-500">(@reviewCount)</span>
                    </div>

                    <p class="text-slate-400 text-sm mb-4 line-clamp-2">@item.Description</p>
                    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-slate-500 text-sm">schedule</span>
                            <span class="text-xs text-slate-500">@(item.DurationMonths * 4) Hour</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-slate-500 text-sm">bar_chart</span>
                            <span class="text-xs text-slate-500">@item.Level</span>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

<!-- About Us Section -->
<section class="py-16 px-4 bg-slate-100 dark:bg-surface-dark/30 -mx-6 md:-mx-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12 px-6">
        <div class="w-full md:w-1/2">
            <div class="relative">
                <div class="absolute -top-4 -left-4 w-24 h-24 bg-primary/20 rounded-xl -z-10"></div>
                <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden border-2 border-primary/30">
                    <img class="w-full h-full object-cover" data-alt="Team of professional IT instructors in a modern office" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCN9RLC-eQk0IaHAaqlJ6SS8rErqf1YW3c_PUXLeS_kC8OSStfBX3Jht3TSLsw92gpmaVUQ2bDdmXa28v7x_CMIJmPEQw6gqPyis0UrBIOZXNFkTttqqIxC0Oue_eepeiX1WuzMfHVxNWKwByfzeKVvcBeRzMbEGe79z0Oy9R7AfCS9YG8_bm36NnBMjr_AiZAQv8aCjWu1nBJ7X4F8anW2l36a_0KUbfw7WE-4L3qyw0chnO9lAgbVdUoc_Rt3YEL2O6T-7JOQsZI"/>
                </div>
                <div class="absolute -bottom-6 -right-6 bg-primary p-6 rounded-xl hidden md:block">
                    <p class="text-background-dark font-display font-black text-4xl">15+</p>
                    <p class="text-background-dark font-bold text-xs uppercase tracking-tighter leading-tight">Years of<br/>Excellence</p>
                </div>
            </div>
        </div>
        <div class="w-full md:w-1/2">
            <p class="text-primary font-bold text-xs uppercase tracking-[0.2em] mb-4">Our Mission</p>
            <h2 class="font-display text-4xl font-bold mb-6">Shaping the Future of IT Professionals</h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg mb-8 leading-relaxed">
                We don't just teach code; we build careers. Our training center bridges the gap between theoretical knowledge and industry demands through hands-on labs and direct mentorship from Fortune 500 engineers.
            </p>
            <div class="space-y-4">
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">verified</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-lg">Industry Certification</h4>
                        <p class="text-sm text-slate-500">Get prepared for globally recognized IT certifications.</p>
                    </div>
                </div>
                <div class="flex gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">group</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-lg">Expert Mentorship</h4>
                        <p class="text-sm text-slate-500">Direct access to professionals currently working in the field.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
