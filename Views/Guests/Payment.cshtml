@model Symphony.Portal.Web.Models.Guest
@{
    ViewData["Title"] = "Entrance Exam Fee Payment";
    var examFee = Model.SelectedEntranceExam?.Fee ?? 0;
}

<div class="min-h-screen bg-background-light dark:bg-background-dark py-12 px-4">
    <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Order Summary -->
        <div class="bg-surface-dark border border-slate-800 rounded-2xl p-8 shadow-2xl h-fit">
            <h3 class="font-display text-xl font-bold text-white mb-6 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary">receipt_long</span>
                Registration Information
            </h3>
            
            <div class="space-y-4 mb-8">
                <div class="flex justify-between p-4 bg-background-dark rounded-xl border border-slate-800">
                    <span class="text-slate-400">Profile ID</span>
                    <span class="font-mono text-white font-bold">#@Model.Id.Substring(0, 8)</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-slate-400">Full Name</span>
                    <span class="text-white font-medium">@Model.FullName</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-slate-400">Email</span>
                    <span class="text-white font-medium">@Model.Email</span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-slate-400">Exam</span>
                    <span class="text-primary font-bold">@Model.SelectedEntranceExam?.Title</span>
                </div>
            </div>

            <div class="border-t border-slate-700 pt-6">
                <div class="flex justify-between items-end">
                    <span class="text-slate-400 mb-1">Total Payment</span>
                    <span class="text-4xl font-bold text-white">@examFee.ToString("N0")<span class="text-xl text-slate-500">$</span></span>
                </div>
            </div>
        </div>

        <!-- Payment Method -->
        <div class="bg-surface-dark border border-slate-800 rounded-2xl p-8 shadow-2xl">
            <h3 class="font-display text-xl font-bold text-white mb-6 flex items-center gap-3">
                <span class="material-symbols-outlined text-primary">credit_card</span>
                Payment Method
            </h3>

            <form asp-action="ConfirmPayment" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="space-y-4 mb-8">
                    <!-- Option 1: QR Code -->
                    <label class="block relative cursor-pointer group">
                        <input type="radio" name="paymentMethod" value="Online" checked class="peer sr-only" />
                        <div class="p-4 rounded-xl border border-slate-700 bg-background-dark hover:border-primary peer-checked:border-primary peer-checked:bg-primary/5 transition-all flex items-center gap-4">
                            <div class="w-12 h-12 rounded-lg bg-white p-2 flex items-center justify-center">
                                <img src="https://img.icons8.com/color/48/qr-code.png" alt="QR" class="w-full h-full object-contain">
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-white group-hover:text-primary transition-colors">QR Code Transfer</h4>
                                <p class="text-xs text-slate-500">Scan VietQR (Auto-confirm)</p>
                            </div>
                            <div class="w-6 h-6 rounded-full border-2 border-slate-600 peer-checked:border-primary peer-checked:bg-primary peer-checked:after:content-[''] peer-checked:after:block peer-checked:after:w-2 peer-checked:after:h-2 peer-checked:after:bg-white peer-checked:after:rounded-full peer-checked:after:mx-auto peer-checked:after:mt-1"></div>
                        </div>
                    </label>

                    <!-- Option 2: Cash -->
                    <label class="block relative cursor-pointer group">
                        <input type="radio" name="paymentMethod" value="Cash" class="peer sr-only" />
                        <div class="p-4 rounded-xl border border-slate-700 bg-background-dark hover:border-primary peer-checked:border-primary peer-checked:bg-primary/5 transition-all flex items-center gap-4">
                            <div class="w-12 h-12 rounded-lg bg-slate-700 p-2 flex items-center justify-center text-white">
                                <span class="material-symbols-outlined">payments</span>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-white group-hover:text-primary transition-colors">Cash at center</h4>
                                <p class="text-xs text-slate-500">Pay directly at the front desk</p>
                            </div>
                             <div class="w-6 h-6 rounded-full border-2 border-slate-600 peer-checked:border-primary peer-checked:bg-primary peer-checked:after:content-[''] peer-checked:after:block peer-checked:after:w-2 peer-checked:after:h-2 peer-checked:after:bg-white peer-checked:after:rounded-full peer-checked:after:mx-auto peer-checked:after:mt-1"></div>
                        </div>
                    </label>
                </div>

                <div class="alert alert-info bg-primary/10 border border-primary/20 rounded-lg p-4 mb-6 flex gap-3">
                    <span class="material-symbols-outlined text-primary">info</span>
                    <p class="text-sm text-slate-300">After payment, your profile will be sent to Admin for approval. Results will be sent via email.</p>
                </div>

                <button type="submit" class="w-full bg-primary text-background-dark font-bold py-4 rounded-lg hover:opacity-90 transition-all shadow-lg shadow-primary/25 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">check_circle</span>
                    Confirm Payment
                </button>
            </form>
        </div>
    </div>
</div>
