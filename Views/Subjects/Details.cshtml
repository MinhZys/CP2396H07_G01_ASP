@model Symphony.Portal.Web.Models.Subject
@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-4xl mx-auto px-6 py-12">
    <!-- Back Button -->
    <a asp-action="Index" class="inline-flex items-center gap-2 text-slate-500 hover:text-primary transition-colors mb-8 text-sm font-bold uppercase tracking-wider">
        <span class="material-symbols-outlined text-lg">arrow_back</span>
        Back to Subjects
    </a>

    <!-- Header Section -->
    <div class="grid md:grid-cols-3 gap-8 mb-12">
        <!-- Image -->
        <div class="aspect-square md:aspect-auto md:h-64 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white/5 relative group">
            <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                 style="background-image: url('@(string.IsNullOrEmpty(Model.Image) ? "https://placeholder.pics/svg/400" : Model.Image)');">
            </div>
        </div>
        
        <!-- Info -->
        <div class="md:col-span-2 flex flex-col justify-center">
            <h1 class="font-display text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">@Model.Name</h1>
            
            <div class="flex items-center gap-4 mb-6">
                <div class="flex items-center gap-2 bg-primary/10 px-3 py-1.5 rounded-lg text-primary text-sm font-bold">
                    <span class="material-symbols-outlined text-lg">schedule</span>
                    <span>@Model.StudyTime hours</span>
                </div>
                <div class="flex items-center gap-2 bg-slate-100 dark:bg-white/5 px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 text-sm font-bold">
                    <span class="material-symbols-outlined text-lg">menu_book</span>
                    <span>Subject</span>
                </div>
            </div>

            <p class="text-slate-600 dark:text-slate-400 text-lg leading-relaxed">
                @Model.Description
            </p>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="grid md:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="md:col-span-2 space-y-8">
            @if (!string.IsNullOrEmpty(Model.LearningRoadmap))
            {
                <section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800 rounded-2xl p-8">
                    <h2 class="font-display text-2xl font-bold mb-6 flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">map</span>
                        Learning Roadmap
                    </h2>
                    
                    @{
                        List<string> steps = new List<string>();
                        try {
                            if (Model.LearningRoadmap.Trim().StartsWith("[")) {
                                steps = System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.LearningRoadmap) ?? new List<string>();
                            } else {
                                steps.Add(Model.LearningRoadmap);
                            }
                        } catch {
                            steps.Add(Model.LearningRoadmap);
                        }
                    }

                    <div class="space-y-0">
                        @for (int i = 0; i < steps.Count; i++)
                        {
                            <div class="flex gap-4 group">
                                <div class="flex-shrink-0 flex flex-col items-center">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm border border-primary/20 group-hover:bg-primary group-hover:text-background-dark transition-colors">
                                        @(i + 1)
                                    </div>
                                    @if(i < steps.Count - 1) {
                                        <div class="w-px h-full bg-slate-200 dark:bg-slate-700 my-2 group-hover:bg-primary/50 transition-colors"></div>
                                    }
                                </div>
                                <div class="pb-8 pt-1">
                                    <p class="text-slate-700 dark:text-slate-300 font-medium text-lg leading-tight">@steps[i]</p>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- CTA -->
            <div class="bg-gradient-to-br from-primary/20 to-transparent border border-primary/20 rounded-2xl p-8 text-center">
                <h3 class="font-display text-xl font-bold mb-2">Ready to master this subject?</h3>
                <p class="text-slate-500 dark:text-slate-400 mb-6">Check out our courses that include this subject!</p>
                <a asp-controller="Courses" asp-action="Index" asp-route-searchString="@Model.Name" 
                   class="inline-flex items-center gap-2 bg-primary text-background-dark px-6 py-3 rounded-lg font-bold hover:brightness-110 transition-all">
                    Find Courses
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="bg-slate-50 border border-slate-200 dark:bg-white/5 dark:border-white/10 rounded-xl p-6">
                <h3 class="font-bold text-sm uppercase tracking-wider text-slate-500 mb-4">Quick Stats</h3>
                <ul class="space-y-4">
                    <li class="flex justify-between items-center">
                         <span class="text-slate-600 dark:text-slate-400 text-sm">Type</span>
                         <span class="font-bold text-slate-900 dark:text-white text-sm">Core Module</span>
                    </li>
                    <li class="flex justify-between items-center">
                         <span class="text-slate-600 dark:text-slate-400 text-sm">Duration</span>
                         <span class="font-bold text-slate-900 dark:text-white text-sm">@Model.StudyTime Hours</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
