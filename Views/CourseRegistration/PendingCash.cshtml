@model Symphony.Portal.Web.Models.Payment
@{
    Layout = "_Layout";
}

<section class="max-w-[900px] mx-auto px-6 py-10">
    <div class="bg-surface-dark border border-slate-800 rounded-xl p-8">
        <h1 class="font-display text-3xl font-bold mb-2">Pending Cash Payment</h1>
        <p class="text-slate-400 mb-8">Your registration has been recorded. Please make the cash payment at the center.</p>

        <div class="bg-[#0b0f16] border border-slate-800 rounded-xl p-6">
            <p class="text-slate-300"><b>Receipt:</b> @Model.ReceiptNumber</p>
            <p class="text-slate-300"><b>Amount:</b> @Model.Amount.ToString("N0")đ</p>
            <p class="text-slate-300"><b>Status:</b> @Model.Status</p>
            <p class="text-slate-500 text-sm mt-2">Staff will confirm once payment is received.</p>
        </div>

        <div class="pt-6">
            <a asp-controller="Courses" asp-action="Index"
               class="inline-block px-6 py-3 rounded-lg border border-slate-700 text-slate-300 font-bold hover:text-white hover:border-slate-500 transition">
                Back to Courses
            </a>
        </div>
    </div>
</section>
