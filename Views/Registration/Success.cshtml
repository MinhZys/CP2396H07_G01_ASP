@{
    ViewData["Title"] = "Registration Successful";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-success mb-4">
                <i class="fa-regular fa-circle-check fa-5x"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3">Registration Received!</h1>
            <p class="lead text-muted mb-5">
                Thank you for registering with Symphony Training Academy. 
                <br />
                We have received your application. Our team will review it and send you an email with the exam schedule shortly.
            </p>
            
            <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">Back to Home</a>
                <a href="#" class="btn btn-outline-secondary btn-lg px-4">Contact Support</a>
            </div>
        </div>
    </div>
</div>
