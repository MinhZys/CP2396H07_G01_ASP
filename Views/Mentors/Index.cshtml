@model IEnumerable<Symphony.Portal.Web.Models.InstructorProfile>
@{
    ViewData["Title"] = "Mentors";
}

@section Styles {
    <style type="text/tailwindcss">
        .cyber-card {
            border: 1px solid rgba(0, 200, 255, 0.1);
            background: #1e2633;
        }
        .cyber-card:hover {
            border-color: #00c8ff;
            background: rgba(0, 200, 255, 0.05);
        }
    </style>
}

<header class="py-12 border-b border-slate-200 dark:border-slate-800 bg-white/5 -mx-6 md:-mx-8 px-6 md:px-8 mb-8">
    <div class="max-w-[1600px] mx-auto">
        <h1 class="font-display text-4xl font-bold mb-2">Expert <span class="text-primary">Mentors</span></h1>
        <p class="text-slate-400 max-w-2xl">Learn directly from industry leaders who have built the systems you use every day.</p>
    </div>
</header>

<div class="max-w-[1600px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var item in Model) {
            <div class="cyber-card rounded-xl overflow-hidden group transition-all duration-300 hover:-translate-y-1 cursor-pointer" onclick="window.location.href='/Mentors/Details/@item.Id'">
                <div class="relative aspect-square overflow-hidden bg-surface-dark">
                     <img src="@(string.IsNullOrEmpty(item.AvatarUrl) ? $"https://ui-avatars.com/api/?name={item.FullName}&background=00c8ff&color=fff" : item.AvatarUrl)" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="@item.FullName">
                    <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-background-dark to-transparent p-4">
                        <h3 class="font-display font-bold text-lg text-white">@item.FullName</h3>
                        <p class="text-primary text-sm font-bold">@item.Specialization</p>
                    </div>
                </div>
                <div class="p-4">
                    <p class="text-slate-400 text-sm line-clamp-2">@(string.IsNullOrEmpty(item.Bio) ? "Experienced IT Professional" : item.Bio)</p>
                </div>
            </div>
        }
        @if (!Model.Any()) {
             <div class="col-span-4 text-center py-12 text-slate-500">
                <p>No mentors found.</p>
             </div>
        }
    </div>
</div>
