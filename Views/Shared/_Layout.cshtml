<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Symphony Portal</title>
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CP2396H07_G01.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark box-shadow fixed-top">
            <div class="container">
                <a class="navbar-brand font-weight-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-layer-group text-primary"></i> Symphony Ltd
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#courses">Khóa học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#certs">Chứng chỉ</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-white" href="#schedule">Lịch khai giảng</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-white" href="#instructors">Giảng viên</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-white" href="#news">Tin tức</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="#contact">Liên hệ</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                         @if (User.Identity.IsAuthenticated)
                        {
                             <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                    <button type="submit" class="nav-link btn btn-link text-white">Logout (@User.Identity.Name)</button>
                                </form>
                            </li>
                             @if (User.IsInRole("Admin"))
                            {
                                 <li class="nav-item"><a class="nav-link text-warning" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Area</a></li>
                            }
                             @if (User.IsInRole("Instructor"))
                            {
                                 <li class="nav-item"><a class="nav-link text-warning" asp-area="Instructor" asp-controller="Dashboard" asp-action="Index">Instructor Area</a></li>
                            }
                        } 
                        else 
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm ms-2 rounded-pill px-4" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Symphony Portal - <a asp-area="" asp-controller="Public" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
