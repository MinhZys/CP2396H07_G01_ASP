@{
    ViewData["Title"] = "Access Denied";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">
    <h1 class="text-danger display-4">Access Denied</h1>
    <h3 class="text-secondary mb-4">You do not have permission to view this resource.</h3>
    <p class="lead text-center mb-5">
        It seems you are trying to access a page that is restricted. 
        <br />
        Please contact your administrator if you believe this is a mistake.
    </p>
    <div>
        <a href="/" class="btn btn-primary btn-lg">Back to Home</a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg ms-2">Go Back</a>
    </div>
</div>
