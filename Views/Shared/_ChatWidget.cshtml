<!-- Chat Widget Floating Button Group -->
<div id="chat-widget-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 items-end">
    
    <!-- AI Chat Button -->
    <button id="ai-toggle-btn" class="bg-purple-600 text-white p-3 rounded-full shadow-lg hover:rotate-12 transition-all group relative">
        <span class="material-symbols-outlined text-2xl">smart_toy</span>
        <span class="absolute right-full mr-2 top-1/2 -translate-y-1/2 bg-purple-900 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
            Hỏi trợ lý AI
        </span>
    </button>

    <!-- Support Chat Button -->
    <button id="support-toggle-btn" class="bg-primary text-background-dark p-4 rounded-full shadow-lg hover:scale-105 transition-all group relative">
        <span class="material-symbols-outlined text-2xl">support_agent</span>
        <span class="absolute right-full mr-2 top-1/2 -translate-y-1/2 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
            Chat với Admin
        </span>
    </button>

    <!-- AI Chat Box -->
    <div id="ai-chat-box" class="hidden absolute bottom-20 right-0 w-80 sm:w-96 bg-surface-dark border border-purple-500/30 rounded-2xl shadow-2xl overflow-hidden flex flex-col" style="height: 450px;">
        <div class="bg-purple-900/40 p-3 border-b border-purple-500/30 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-400">smart_toy</span>
                <span class="font-bold text-white text-sm">AI Assistant</span>
            </div>
            <button onclick="document.getElementById('ai-chat-box').classList.add('hidden')" class="text-slate-400 hover:text-white">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="ai-messages" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar bg-purple-900/10">
            <div class="text-center text-[10px] text-slate-500 my-2">AI sẽ hỗ trợ bạn thông tin và lời khuyên</div>
        </div>
        <div id="ai-typing" class="hidden px-4 py-1 text-[10px] text-purple-400 italic">AI đang trả lời...</div>
        <div class="p-3 border-t border-slate-700 bg-surface-dark">
            <div class="flex gap-2">
                <input type="text" id="ai-input" placeholder="Hỏi AI..." class="flex-1 bg-background-dark border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-purple-500">
                <button id="ai-send-btn" class="bg-purple-600 text-white p-2 rounded-lg hover:bg-purple-500 transition-colors">
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Support Chat Box -->
    <div id="support-chat-box" class="hidden absolute bottom-20 right-0 w-80 sm:w-96 bg-surface-dark border border-slate-700 rounded-2xl shadow-2xl overflow-hidden flex flex-col" style="height: 450px;">
        <div class="bg-primary/10 p-3 border-b border-slate-700 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">support_agent</span>
                <span class="font-bold text-white text-sm">Support Chat</span>
            </div>
            <button onclick="document.getElementById('support-chat-box').classList.add('hidden')" class="text-slate-400 hover:text-white">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="support-messages" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar bg-background-dark/50">
            <div class="text-center text-[10px] text-slate-500 my-2">Nói chuyện trực tiếp với Admin</div>
        </div>
        <div class="p-3 border-t border-slate-700 bg-surface-dark">
            <div id="guest-name-area" class="mb-2 hidden">
                <input type="text" id="support-guest-name" placeholder="Tên của bạn..." class="w-full bg-background-dark border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white">
            </div>
            <div class="flex gap-2">
                <input type="text" id="support-input" placeholder="Aa..." class="flex-1 bg-background-dark border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-primary">
                <button id="support-send-btn" class="bg-primary text-background-dark p-2 rounded-lg hover:bg-primary/90 transition-colors">
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SignalR Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="~/js/chat.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Setup ---
        const aiBox = document.getElementById('ai-chat-box');
        const supportBox = document.getElementById('support-chat-box');
        let isGuest = @(User.Identity.IsAuthenticated ? "false" : "true");
        let currentUserId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "Guest")";
        
        // Separate Session IDs
        let supportSid = getCookie("support_sid");
        let aiSid = getCookie("ai_sid");
        
        if (!supportSid) { supportSid = crypto.randomUUID(); setCookie("support_sid", supportSid, 1); }
        if (!aiSid) { aiSid = crypto.randomUUID(); setCookie("ai_sid", aiSid, 1); }

        // --- Event Listeners ---
        document.getElementById('ai-toggle-btn').addEventListener('click', () => {
            aiBox.classList.toggle('hidden');
            supportBox.classList.add('hidden');
            loadHistory(aiSid, 'ai-messages');
        });
        document.getElementById('support-toggle-btn').addEventListener('click', () => {
            supportBox.classList.toggle('hidden');
            aiBox.classList.add('hidden');
            if (isGuest && !getCookie("chat_guest_name")) document.getElementById('guest-name-area').classList.remove('hidden');
            loadHistory(supportSid, 'support-messages');
            if (window.connection && window.connection.state === "Connected") joinChatGroup("Session_" + supportSid);
        });

        document.getElementById('ai-send-btn').addEventListener('click', () => sendMsg('ai'));
        document.getElementById('support-send-btn').addEventListener('click', () => sendMsg('support'));
        document.getElementById('ai-input').onkeypress = (e) => { if(e.key === 'Enter') sendMsg('ai'); };
        document.getElementById('support-input').onkeypress = (e) => { if(e.key === 'Enter') sendMsg('support'); };

        // --- SignalR ---
        const waitForConn = setInterval(() => {
            if (window.connection && window.connection.state === "Connected") {
                clearInterval(waitForConn);
                joinChatGroup("Session_" + supportSid);
                joinChatGroup("Session_" + aiSid);

                window.connection.on("ReceiveAIMessage", (msg, time) => {
                    appendUI('ai-messages', msg, 'ai', time);
                });
                window.connection.on("AITyping", (t) => {
                    document.getElementById('ai-typing').classList.toggle('hidden', !t);
                });
                window.connection.on("ReceiveMessage", (sId, name, msg, sid, time) => {
                    // Prevent duplicate if it's our own message we already appended
                    if (sId === connection.connectionId) return;

                    // Route message to correct box
                    if (sid === supportSid) appendUI('support-messages', msg, 'other', time);
                    if (sid === aiSid && name !== "AI Assistant") appendUI('ai-messages', msg, 'other', time);
                });
            }
        }, 500);

        // --- Helpers ---
        async function loadHistory(sid, containerId) {
            const div = document.getElementById(containerId);
            try {
                const res = await fetch(`/Chat/GetHistory?sessionId=${sid}`);
                if (!res.ok) return;
                const msgs = await res.json();
                if (msgs.length > 0) div.innerHTML = '';
                const myId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")";
                msgs.forEach(m => {
                    let type = 'other';
                    if (m.senderValidName === 'AI Assistant') type = 'ai';
                    else if (isGuest) {
                        const gName = getCookie("chat_guest_name");
                        if (m.senderId === null && gName && m.senderValidName === gName) type = 'self';
                    } else if (m.senderId === myId) type = 'self';
                    appendUI(containerId, m.content, type, m.time);
                });
            } catch(e) {}
        }

        function sendMsg(mode) {
            const input = document.getElementById(mode + '-input');
            const msg = input.value.trim();
            if (!msg) return;

            let name = "@(User.Identity.Name ?? "")";
            if (isGuest) {
                name = getCookie("chat_guest_name") || document.getElementById('support-guest-name').value.trim();
                if (!name) { alert("Vui lòng nhập tên!"); return; }
                setCookie("chat_guest_name", name, 1);
                document.getElementById('guest-name-area').classList.add('hidden');
            }

            appendUI(mode + '-messages', msg, 'self', 'Now');
            input.value = '';

            if (mode === 'ai') {
                window.connection.invoke("AskAI", msg, aiSid, name);
            } else {
                sendMessageToHub("", msg, name, supportSid);
            }
        }

        function appendUI(cid, text, type, time) {
            const div = document.createElement('div');
            const cont = document.getElementById(cid);
            if (type === 'ai') {
                div.className = 'flex flex-col items-start';
                div.innerHTML = `<div class="flex items-start gap-1 max-w-[85%]"><div class="w-5 h-5 rounded-full bg-purple-600 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-[8px] text-white">smart_toy</span></div><div class="px-2 py-1.5 rounded-lg text-xs bg-purple-900/40 text-purple-100 rounded-tl-none border border-purple-500/20">${text.replace(/\n/g, '<br>')}</div></div><span class="text-[8px] text-slate-500 mt-0.5 ml-6">${time}</span>`;
            } else {
                const isSelf = type === 'self';
                div.className = isSelf ? 'flex flex-col items-end' : 'flex flex-col items-start';
                div.innerHTML = `<div class="max-w-[80%] px-3 py-1.5 rounded-lg text-xs ${isSelf ? 'bg-primary text-background-dark rounded-tr-none' : 'bg-slate-700 text-white rounded-tl-none'}">${text}</div><span class="text-[8px] text-slate-500 mt-0.5">${time}</span>`;
            }
            cont.appendChild(div);
            cont.scrollTop = cont.scrollHeight;
        }

        function setCookie(n,v,d){var e="";if(d){var t=new Date();t.setTime(t.getTime()+d*864e5);e="; expires="+t.toUTCString()}document.cookie=n+"="+(v||"")+e+"; path=/"}
        function getCookie(n){var e=n+"=",t=document.cookie.split(";");for(var r=0;r<t.length;r++){for(var i=t[r];" "==i.charAt(0);)i=i.substring(1,i.length);if(0==i.indexOf(e))return i.substring(e.length,i.length)}return null}
    });
</script>
