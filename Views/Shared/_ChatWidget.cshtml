<!-- Chat Widget Floating Button -->
<div id="chat-widget-container" class="fixed bottom-6 right-6 z-50">
    <button id="chat-toggle-btn" class="bg-primary text-background-dark p-4 rounded-full shadow-lg hover:scale-105 transition-transform">
        <span class="material-symbols-outlined text-2xl">chat</span>
    </button>

    <!-- Chat Box (Hidden by default) -->
    <div id="chat-box" class="hidden absolute bottom-16 right-0 w-96 bg-surface-dark border border-slate-700 rounded-2xl shadow-2xl overflow-hidden flex flex-col" style="height: 500px;">
        <!-- Header -->
        <div class="bg-primary/10 p-4 border-b border-slate-700">
            <div class="flex justify-between items-center">
                <h3 class="font-bold text-white">Online Support</h3>
                <button id="chat-close-btn" class="text-slate-400 hover:text-white">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <!-- AI Mode Toggle -->
            <div class="flex items-center gap-2 mt-2">
                <button id="ai-mode-btn" class="flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-medium transition-all bg-slate-700 text-slate-300 hover:bg-purple-600 hover:text-white">
                    <span class="material-symbols-outlined text-sm">smart_toy</span>
                    <span id="ai-mode-text">Chat với AI</span>
                </button>
                <span id="ai-status" class="text-xs text-slate-500 hidden">
                    <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-1 animate-pulse"></span>
                    AI Online
                </span>
            </div>
        </div>

        <!-- Messages Area -->
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar bg-background-dark/50">
            <!-- Messages will start here -->
            <div class="text-center text-xs text-slate-500 my-2">Start a conversation</div>
        </div>

        <!-- AI Typing Indicator -->
        <div id="ai-typing-indicator" class="hidden px-4 py-2 bg-purple-900/20 border-t border-purple-500/30">
            <div class="flex items-center gap-2 text-purple-300 text-sm">
                <span class="material-symbols-outlined animate-pulse">smart_toy</span>
                <span>AI đang suy nghĩ</span>
                <span class="flex gap-1">
                    <span class="w-1.5 h-1.5 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
                    <span class="w-1.5 h-1.5 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
                    <span class="w-1.5 h-1.5 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
                </span>
            </div>
        </div>

        <!-- Input Area -->
        <div class="p-3 border-t border-slate-700 bg-surface-dark">
            <!-- Guest Name Input (Only shown if guest and name not set) -->
            <div id="guest-name-input" class="mb-2 hidden">
                <input type="text" id="chat-guest-name" placeholder="Enter your name..." class="w-full bg-background-dark border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-primary">
            </div>

            <div class="flex gap-2">
                <input type="text" id="chat-input" placeholder="Type a message..." class="flex-1 bg-background-dark border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-primary">
                <button id="chat-send-btn" class="bg-primary text-background-dark p-2 rounded-lg hover:bg-primary/90">
                    <span class="material-symbols-outlined">send</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SignalR Library (CDN) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="~/js/chat.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggleBtn = document.getElementById('chat-toggle-btn');
        const closeBtn = document.getElementById('chat-close-btn');
        const chatBox = document.getElementById('chat-box');
        const sendBtn = document.getElementById('chat-send-btn');
        const input = document.getElementById('chat-input');
        const messagesDiv = document.getElementById('chat-messages');
        const guestNameInput = document.getElementById('guest-name-input');
        const guestNameField = document.getElementById('chat-guest-name');
        const aiModeBtn = document.getElementById('ai-mode-btn');
        const aiModeText = document.getElementById('ai-mode-text');
        const aiStatus = document.getElementById('ai-status');
        const aiTypingIndicator = document.getElementById('ai-typing-indicator');

        let isGuest = @(User.Identity.IsAuthenticated ? "false" : "true");
        let currentUserId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "Guest")";
        let isAIMode = false;
        
        let sessionId = getCookie("chat_session_id");
        let lastUserId = getCookie("chat_last_user_id");

        // If user changed (e.g. logged out or logged in as someone else), clear session
        if (lastUserId && lastUserId !== currentUserId) {
            deleteCookie("chat_session_id");
            deleteCookie("chat_guest_name");
            sessionId = null;
        }
        setCookie("chat_last_user_id", currentUserId, 1);

        if (!sessionId) {
            sessionId = crypto.randomUUID();
            setCookie("chat_session_id", sessionId, 1);
        }

        // Wait for connections and Load History
        if (sessionId) {
            loadHistory(sessionId);
        }

        const waitForConn = setInterval(() => {
            if (window.connection && window.connection.state === "Connected") {
                clearInterval(waitForConn);
                console.log("Widget: SignalR Ready");
                
                // Setup AI message handlers
                window.connection.on("ReceiveAIMessage", function(message, time) {
                    appendMessage(message, 'ai', time);
                });

                window.connection.on("AITyping", function(isTyping) {
                    if (isTyping) {
                        aiTypingIndicator.classList.remove('hidden');
                    } else {
                        aiTypingIndicator.classList.add('hidden');
                    }
                });

                if (isGuest && sessionId) {
                    console.log("Joining Session: " + sessionId);
                    joinChatGroup("Session_" + sessionId);
                }
            }
        }, 500);

        // AI Mode Toggle
        aiModeBtn.addEventListener('click', () => {
            isAIMode = !isAIMode;
            if (isAIMode) {
                aiModeBtn.classList.remove('bg-slate-700', 'text-slate-300');
                aiModeBtn.classList.add('bg-purple-600', 'text-white');
                aiModeText.textContent = 'AI Mode ON';
                aiStatus.classList.remove('hidden');
                input.placeholder = 'Hỏi AI bất cứ điều gì...';
            } else {
                aiModeBtn.classList.add('bg-slate-700', 'text-slate-300');
                aiModeBtn.classList.remove('bg-purple-600', 'text-white');
                aiModeText.textContent = 'Chat với AI';
                aiStatus.classList.add('hidden');
                input.placeholder = 'Type a message...';
            }
        });

        // Toggle Chat
        toggleBtn.addEventListener('click', () => {
            chatBox.classList.toggle('hidden');
            if (isGuest && !getCookie("chat_guest_name")) {
                guestNameInput.classList.remove('hidden');
            } else {
                guestNameInput.classList.add('hidden');
            }
        });

        closeBtn.addEventListener('click', () => chatBox.classList.add('hidden'));

        // Send Message
        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        async function loadHistory(sid) {
             try {
                const response = await fetch(`/Chat/GetHistory?sessionId=${sid}`);
                if (!response.ok) return;
                const messages = await response.json();
                
                // Clear initial placeholder if history exists
                if(messages.length > 0) messagesDiv.innerHTML = '';
                
                const myId = "@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")";

                messages.forEach(m => {
                    // Check if it's an AI message
                    if (m.senderValidName === 'AI Assistant' || m.senderId === 'AI_ASSISTANT') {
                        appendMessage(m.content, 'ai', m.time);
                        return;
                    }
                    
                    let isSelf = false;
                    if (isGuest) {
                        isSelf = (m.senderId === null); 
                    } else {
                        isSelf = (m.senderId === myId);
                    }
                    
                    appendMessage(m.content, isSelf ? 'self' : 'other', m.time);
                });
            } catch (err) {
                console.error("Error loading history", err);
            }
        }

        function sendMessage() {
            const msg = input.value.trim();
            if (!msg) return;

            let senderName = "@(User.Identity.Name ?? "")";
            
            if (isGuest) {
                let storedName = getCookie("chat_guest_name");
                if (!storedName) {
                    const nameVal = guestNameField.value.trim();
                    if (!nameVal) {
                        alert("Please enter your name to start chatting!");
                        return;
                    }
                    setCookie("chat_guest_name", nameVal, 1);
                    senderName = nameVal;
                    guestNameInput.classList.add('hidden');
                } else {
                    senderName = storedName;
                }
            }

            // Append local message
            appendMessage(msg, 'self', 'Now');
            input.value = '';

            if (isAIMode) {
                // Send to AI via SignalR
                if (window.connection && window.connection.state === "Connected") {
                    window.connection.invoke("AskAI", msg, sessionId, senderName)
                        .catch(err => {
                            console.error("Error asking AI:", err);
                            appendMessage("Không thể kết nối với AI. Vui lòng thử lại.", 'ai', 'Now');
                        });
                }
            } else {
                // Send to Admin via SignalR
                sendMessageToHub("", msg, senderName, sessionId);
            }
        }

        // Listen for new messages
        document.addEventListener('chatMessageReceived', (e) => {
            const data = e.detail;
            if (data.senderId !== connection.connectionId) { 
                 appendMessage(data.message, 'other', data.time);
            }
        });

        function appendMessage(text, type, time) {
            const div = document.createElement('div');
            
            if (type === 'ai') {
                // AI message style
                div.className = 'flex flex-col items-start';
                div.innerHTML = `
                    <div class="flex items-start gap-2 max-w-[85%]">
                        <div class="w-6 h-6 rounded-full bg-purple-600 flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-xs text-white">smart_toy</span>
                        </div>
                        <div class="px-3 py-2 rounded-xl text-sm bg-purple-900/40 text-purple-100 rounded-tl-none border border-purple-500/30">
                            ${formatAIMessage(text)}
                        </div>
                    </div>
                    <span class="text-[10px] text-slate-500 mt-1 ml-8">${time}</span>
                `;
            } else if (type === 'self') {
                div.className = 'flex flex-col items-end';
                div.innerHTML = `
                    <div class="max-w-[80%] px-3 py-2 rounded-xl text-sm bg-primary text-background-dark rounded-tr-none">
                        ${text}
                    </div>
                    <span class="text-[10px] text-slate-500 mt-1">${time}</span>
                `;
            } else {
                div.className = 'flex flex-col items-start';
                div.innerHTML = `
                    <div class="max-w-[80%] px-3 py-2 rounded-xl text-sm bg-slate-700 text-white rounded-tl-none">
                        ${text}
                    </div>
                    <span class="text-[10px] text-slate-500 mt-1">${time}</span>
                `;
            }
            
            messagesDiv.appendChild(div);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function formatAIMessage(text) {
            // Simple formatting for AI responses
            return text
                .replace(/\n/g, '<br>')
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>');
        }

        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days*24*60*60*1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "")  + expires + "; path=/";
        }
        function getCookie(name) {
            var nameEQ = name + "=";
            var ca = document.cookie.split(';');
            for(var i=0;i < ca.length;i++) {
                var c = ca[i];
                while (c.charAt(0)==' ') c = c.substring(1,c.length);
                if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
            }
            return null;
        }
        function deleteCookie(name) {
            document.cookie = name + '=; Max-Age=-99999999; path=/';
        }
    });
</script>

