@model Symphony.Portal.Web.Models.Course
@using System.Text.Json;
@{
    Layout = "_Layout";
    // Fetch via CourseInstructors if available, or fallback to Class Instructor for backward compatibility or if not eager loaded
    // Controller eager loads: .Include(c => c.CourseInstructors).ThenInclude(ci => ci.Instructor) needs to be checked in Controller Details action
    
    // We need to update Controller Details to include CourseInstructors
    // Assuming Controller updated (I will check next step or do it now), let's write view logic to use it
    var instructors = Model.CourseInstructors?.Select(ci => ci.Instructor).Where(i => i != null).ToList() ?? new List<Symphony.Portal.Web.Models.User>();
    

    var scheduleClasses = new List<Symphony.Portal.Web.Models.Class>(); // Placeholder empty list
}

@section Styles {
    <style>
        .timeline-line::before {
            content: '';
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #1e293b;
            z-index: 0;
        }
        .timeline-dot {
            z-index: 10;
            box-shadow: 0 0 0 4px #0e121b;
        }
        /* Custom Star Rating Logic */
        .star-rating-group {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
        }
        .star-rating-group input {
            display: none;
        }
        .star-rating-group label {
            cursor: pointer;
            color: #475569; /* slate-600 */
            transition: color 0.15s ease-in-out;
        }
        /* CHECKED STATE: Color the checked star and all subsequent siblings (visually previous) */
        .star-rating-group input:checked ~ label {
            color: #eab308; /* yellow-500 */
        }
        /* HOVER STATE: Color the hovered star and all subsequent siblings */
        .star-rating-group label:hover,
        .star-rating-group label:hover ~ label {
            color: #eab308;
        }
        /* HOVER RESET: When hovering the group, suppress the checked styling so hover takes precedence */
        .star-rating-group:hover input:checked ~ label {
            color: #475569;
        }
        /* HOVER OVERRIDE: Ensure the hovered selection is always yellow, even if we suppressed the checked state */
        .star-rating-group label:hover,
        .star-rating-group label:hover ~ label {
            color: #eab308 !important;
        }
    </style>
}

    <!-- Notification Toast (Legacy support if needed, though Layout handles TempData["Success"]) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="toast-success" class="fixed top-24 right-5 z-[100] flex items-center w-full max-w-xs p-4 space-x-4 text-white bg-surface-dark rounded-lg shadow-xl border border-primary/20 animate-bounce-in" role="alert">
            <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-primary bg-primary/20 rounded-lg">
                <span class="material-symbols-outlined text-sm">check</span>
            </div>
            <div class="ml-3 text-sm font-normal">@TempData["SuccessMessage"]</div>
            <button type="button" class="ml-auto -mx-1.5 -my-1.5 bg-transparent text-slate-400 hover:text-white rounded-lg focus:ring-2 focus:ring-slate-600 p-1.5 hover:bg-slate-700 inline-flex h-8 w-8" data-dismiss-target="#toast-success" aria-label="Close" onclick="document.getElementById('toast-success').remove()">
                <span class="material-symbols-outlined text-base">close</span>
            </button>
        </div>
        <script>
            setTimeout(function() {
                var toast = document.getElementById('toast-success');
                if(toast) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(100%)';
                    toast.style.transition = 'all 0.5s ease';
                    setTimeout(function() { toast.remove(); }, 500);
                }
            }, 5000); // Auto close after 5s
        </script>
        <style>
            @("@")keyframes slideInRight {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            .animate-bounce-in {
                animation: slideInRight 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            }
        </style>
    }

<!-- Hero Section -->
<header class="relative pt-12 pb-24 border-b border-slate-800 bg-[#0b0f16]">
    <div class="max-w-[1240px] mx-auto px-6">
        <div class="text-primary font-bold text-xs uppercase tracking-widest mb-4">
            <a href="/Courses" class="hover:underline">Courses</a> / <span class="text-slate-400">@Model.Category?.Name</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold mb-8">@Model.Title</h1>

        <div class="flex items-center gap-8 text-sm text-slate-400">
             <div class="flex items-center gap-2">
                <span class="flex text-yellow-500">
                     @{
                         double avgHeader = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : 0;
                         for(int i=1; i<=5; i++) {
                             if(avgHeader >= i) { <span class="material-symbols-outlined text-lg fill-current">star</span> }
                             else if(avgHeader >= i - 0.5) { <span class="material-symbols-outlined text-lg">star_half</span> }
                             else { <span class="material-symbols-outlined text-lg text-slate-600">star</span> }
                         }
                     }
                </span>
                <span class="font-bold text-white">@(ViewBag.AverageRating != null ? ((double)ViewBag.AverageRating).ToString("0.0") : "0.0")</span>
                <span>(@(ViewBag.ReviewCount ?? 0) Reviews)</span>
             </div>
             <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">schedule</span>
                <span>@(Model.DurationMonths * 4) Weeks</span>
             </div>
             <div class="flex items-center gap-2">
                 <span class="material-symbols-outlined">group</span>
                 <span>Beginner Friendly</span>
             </div>
        </div>
    </div>
</header>

<main class="max-w-[1240px] mx-auto px-6 -mt-16 pb-20 relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column (Main Content) -->
    <div class="lg:col-span-2 space-y-12">
        
        <!-- Video / Image Placeholder -->
        <div class="rounded-2xl overflow-hidden border border-slate-800 bg-surface-dark relative aspect-video group">
            <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('@(string.IsNullOrEmpty(Model.Image) ? "https://placeholder.pics/svg/800" : Model.Image)');"></div>
        </div>

        <!-- Learning Path (Timeline) -->
        <div class="flex items-center justify-between gap-3 mb-8 border-l-4 border-primary pl-4">
            <h2 class="font-display text-2xl font-bold">Detailed Curriculum</h2>
        </div>
            
            <div class="relative timeline-line space-y-8 pl-5">
                @if (Model.CourseSubjects.Any())
                {
                    int index = 1;
                    foreach (var cs in Model.CourseSubjects)
                    {
                        <div class="relative pl-8">
                            <div class="absolute left-0 top-0 w-10 h-10 rounded-full bg-surface-dark border-2 border-primary flex items-center justify-center text-primary font-bold timeline-dot">
                                @index
                            </div>
                            <div class="bg-surface-dark border border-slate-800 rounded-xl p-6 hover:border-primary/50 transition-colors">
                                <span class="text-primary text-xs font-bold uppercase tracking-wider mb-2 block">Phase @index.ToString("D2")</span>
                                <h3 class="font-display text-xl font-bold mb-3">@cs.Subject?.Name</h3>
                                <p class="text-slate-400 text-sm mb-4">@cs.Subject?.Description</p>
                                
                                @* Display Learning Roadmap *@
                                @if (!string.IsNullOrEmpty(cs.Subject?.LearningRoadmap))
                                {
                                    try 
                                    {
                                        var steps = JsonSerializer.Deserialize<List<string>>(cs.Subject.LearningRoadmap);
                                        if (steps != null && steps.Any())
                                        {
                                            <ul class="space-y-3 mt-4 ml-1 pl-4 border-l border-slate-700">
                                                @{ int stepIndex = 1; }
                                                @foreach (var step in steps)
                                                {
                                                    <li class="text-sm text-slate-300 flex items-start gap-3 relative">
                                                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/20 text-primary border border-primary/50 flex items-center justify-center text-xs font-bold">@stepIndex</span>
                                                        <span class="mt-0.5">@step</span>
                                                    </li>
                                                    stepIndex++;
                                                }
                                            </ul>
                                        }
                                    }
                                    catch 
                                    { /* Ignore json errors */ }
                                }
                                else
                                {
                                     <div class="w-full bg-slate-800 h-1 rounded-full overflow-hidden mt-2">
                                         <div class="bg-primary h-full" style="width: @(new Random().Next(30, 90))%"></div>
                                     </div>
                                }
                            </div>
                        </div>
                        index++;
                    }
                }
                else
                {
                    <p class="text-slate-500 italic pl-8">Detailed syllabus is being updated.</p>
                }
            </div>

        <!-- Instructor Section -->
        <div>
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Instructors</h2>
            </div>
            
            @if (instructors.Any())
            {
                foreach (var inst in instructors)
                {
                    <div class="bg-surface-dark border border-slate-800 rounded-xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start mb-6 last:mb-0">
                        <div class="w-32 h-32 rounded-xl bg-slate-800 flex-shrink-0 overflow-hidden">
                           <img src="https://ui-avatars.com/api/?name=@(inst.FullName)&background=00c8ff&color=fff&size=128" alt="Instructor" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-display text-2xl font-bold mb-1">@inst.FullName</h3>
                            <p class="text-primary font-bold text-sm mb-4">Course Instructor</p>
                            <p class="text-slate-400 text-sm italic mb-6">"Expert with years of experience in IT and training."</p>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex items-center gap-2">
                                     <span class="material-symbols-outlined text-primary text-lg">work</span>
                                     <div class="text-xs">
                                         <p class="font-bold text-white">Expert</p>
                                         <p class="text-slate-500">Industry Leader</p>
                                     </div>
                                </div>
                                 <div class="flex items-center gap-2">
                                     <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                     <div class="text-xs">
                                         <p class="font-bold text-white">Certified</p>
                                         <p class="text-slate-500">Top Rated</p>
                                     </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                 <p class="text-slate-500 italic">Instructor information is being updated.</p>
            }
        </div>

        <!-- Reviews Section -->
         <div id="reviews">
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Reviews & Comments</h2>
            </div>
            
            <div class="bg-surface-dark border border-slate-800 rounded-xl p-8">
                <!-- Summary -->
                <div class="flex flex-col md:flex-row gap-10 items-center mb-10 pb-10 border-b border-slate-800">
                     <div class="text-center">
                         <h3 class="text-5xl font-bold text-white mb-2">@(ViewBag.AverageRating != null ? ((double)ViewBag.AverageRating).ToString("0.0") : "0.0")</h3>
                         <div class="flex text-yellow-500 justify-center mb-2">
                             @{
                                 double avg = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : 0;
                                 for(int i=1; i<=5; i++) {
                                     if(avg >= i) { <span class="material-symbols-outlined text-xl fill-current">star</span> }
                                     else if(avg >= i - 0.5) { <span class="material-symbols-outlined text-xl">star_half</span> }
                                     else { <span class="material-symbols-outlined text-xl text-slate-600">star</span> }
                                 }
                             }
                         </div>
                         <p class="text-slate-400 text-sm">(@(ViewBag.ReviewCount ?? 0) reviews)</p>
                     </div>
                     
                     <div class="flex-1 w-full space-y-2">
                         @for(int i=5; i>=1; i--) {
                             var count = Model.CourseReviews.Count(r => r.Rating == i);
                             var total = Model.CourseReviews.Count;
                             var percent = total > 0 ? (count * 100 / total) : 0;
                             
                             <div class="flex items-center gap-3 text-sm">
                                 <span class="w-12 text-slate-400 whitespace-nowrap">@i stars</span>
                                 <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden">
                                     <div class="h-full bg-yellow-500 rounded-full" style="width: @percent%"></div>
                                 </div>
                                 <span class="w-8 text-right text-slate-500">@percent%</span>
                             </div>
                         }
                     </div>
                </div>

                <!-- Review List -->
                <div class="space-y-8">
                    @if (Model.CourseReviews != null && Model.CourseReviews.Any())
                    {
                        foreach (var review in Model.CourseReviews.OrderByDescending(r => r.ReviewDate))
                        {
                             <div class="flex gap-4">
                                <div class="w-12 h-12 rounded-full bg-slate-700 flex-shrink-0 overflow-hidden">
                                    <img src="https://ui-avatars.com/api/?name=@(review.Student?.FullName ?? "User")&background=random" alt="User" class="w-full h-full object-cover">
                                </div>
                                <div>
                                    <h4 class="font-bold text-white mb-1">@(review.Student?.FullName ?? "Unknown User")</h4>
                                    <div class="flex items-center gap-2 mb-2">
                                        <div class="flex text-yellow-500 text-xs">
                                            @for(int r=1; r<=5; r++) {
                                                <span class="material-symbols-outlined text-sm @(r <= review.Rating ? "fill-current" : "")">star</span>
                                            }
                                        </div>
                                        <span class="text-slate-500 text-xs">@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <p class="text-slate-300 text-sm leading-relaxed">@review.ReviewText</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-slate-500 italic">No reviews yet. Be the first one!</p>
                    }
                </div>

                <!-- Review Form -->
                <div class="mt-12 pt-10 border-t border-slate-800">
                    <h4 class="font-bold text-lg text-white mb-6">Write your review</h4>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="PostReview" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-4">
                                <label class="block text-slate-400 text-sm mb-2">Your rating</label>
                                <div class="star-rating-group gap-1 w-fit">
                                    @for(int s=5; s>=1; s--) {
                                        <input type="radio" name="rating" id="rating-star-@s" value="@s" required />
                                        <label for="rating-star-@s" class="material-symbols-outlined text-3xl p-1">star</label>
                                    }
                                </div>
                            </div>
                            <div class="mb-4">
                                <textarea name="reviewText" rows="4" class="w-full bg-background-dark border border-slate-700 rounded-lg p-4 text-white placeholder-slate-500 focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Share your thoughts about this course..."></textarea>
                            </div>
                            <button type="submit" class="bg-primary text-background-dark font-bold px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">
                                Submit Review
                            </button>
                        </form>
                    }
                    else
                    {
                         <div class="bg-slate-800/50 rounded-lg p-6 text-center">
                            <p class="text-slate-400 mb-4">Please login to write a review.</p>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="inline-block border border-primary text-primary font-bold px-6 py-2 rounded-lg hover:bg-primary hover:text-background-dark transition-all">
                                Login Now
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Schedule Section -->
        <div>
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Upcoming Schedule</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-xs font-bold uppercase text-slate-500 border-b border-slate-800">
                            <th class="py-4 px-4">Start Date</th>
                            <th class="py-4 px-4">Schedule</th>
                            <th class="py-4 px-4">Format</th>
                            <th class="py-4 px-4 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        @if (scheduleClasses.Any()) {
                            // Placeholder
                        } else {
                             <tr class="border-b border-slate-800/50">
                                <td colspan="4" class="py-4 px-4 text-center text-slate-500 text-xs uppercase">No new schedule available</td>
                             </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Right Column (Sticky Sidebar) -->
    <div class="lg:col-span-1">
        <div class="sticky top-28 space-y-6">
            <!-- Price Card -->
            <div class="bg-surface-dark border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-50">
                    <span class="material-symbols-outlined text-6xl text-slate-700">payments</span>
                </div>
                <div class="relative z-10">
                    <div class="flex items-end gap-2 mb-2">
                        <h2 class="text-3xl font-bold text-white">@Model.TuitionFee.ToString("N0")<span class="text-lg underline align-top">đ</span></h2>
                         <span class="text-slate-500 line-through text-sm mb-1">@( (Model.TuitionFee * 1.2m).ToString("N0") )đ</span>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="CourseRegistration"
                           asp-action="Confirm"
                           asp-route-courseId="@Model.Id"
                           class="block w-full text-center bg-primary text-background-dark font-bold py-4 rounded-lg hover:opacity-90 transition-all mb-3 shadow-lg shadow-primary/25">
                            Register Now
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Guests"
                           asp-action="Register"
                           class="block w-full text-center bg-primary text-background-dark font-bold py-4 rounded-lg hover:opacity-90 transition-all mb-3 shadow-lg shadow-primary/25">
                            Register Now
                        </a>
                    }

                </div>
            </div>

            <!-- Consultation Box -->
            <div class="bg-[#0b0f16] border border-slate-800 rounded-xl p-6">
                <p class="text-xs font-bold uppercase text-slate-500 mb-2">Need more advice?</p>
                <div class="flex items-center gap-3 mb-6">
                     <span class="material-symbols-outlined text-primary text-2xl">headset_mic</span>
                     <div>
                         <h4 class="font-bold text-white">Hotline 24/7</h4>
                         <p class="text-primary font-mono">1900 6789</p>
                     </div>
                </div>
                 <button class="w-full border border-slate-700 text-slate-300 font-bold py-3 rounded-lg hover:text-white hover:border-slate-500 transition-all text-sm">
                    Contact via Zalo
                </button>
            </div>
        </div>
    </div>
</main>


