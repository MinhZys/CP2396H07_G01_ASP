<!-- Hero Section -->
<header class="relative pt-12 pb-24 border-b border-slate-800 bg-[#0b0f16]">
    <div class="max-w-[1240px] mx-auto px-6">
        <div class="text-primary font-bold text-xs uppercase tracking-widest mb-4">
            <a href="/Courses" class="hover:underline">Courses</a> / <span class="text-slate-400">@Model.Category?.Name</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold mb-2">@Model.Title</h1>
        <p class="text-2xl text-primary font-display font-medium mb-8">Professional Certification</p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-3 mb-10">
            @foreach (var skill in new[] { "Technical Sklls", "Project Management", "Team Leadership" })
            {
                 <span class="bg-surface-dark border border-slate-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2">
                    <span class="material-symbols-outlined text-base text-primary">check_circle</span>
                    @skill
                </span>
            }
        </div>

        <div class="flex items-center gap-8 text-sm text-slate-400">
             <div class="flex items-center gap-2">
                <span class="flex text-yellow-500">
                    @for(int i=0; i<5; i++) { <span class="material-symbols-outlined text-lg">star</span> }
                </span>
                <span class="font-bold text-white">4.9</span>
                <span>(1.5k Reviews)</span>
             </div>
             <div class="flex items-center gap-2">
                <span class="material-symbols-outlined">schedule</span>
                <span>@(Model.DurationMonths * 4) Weeks</span>
             </div>
             <div class="flex items-center gap-2">
                 <span class="material-symbols-outlined">group</span>
                 <span>Beginner Friendly</span>
             </div>
        </div>
    </div>
</header>

<main class="max-w-[1240px] mx-auto px-6 -mt-16 pb-20 relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column (Main Content) -->
    <div class="lg:col-span-2 space-y-12">
        
        <!-- Video / Image Placeholder -->
        <div class="rounded-2xl overflow-hidden border border-slate-800 bg-surface-dark relative aspect-video group">
            <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('@(string.IsNullOrEmpty(Model.Image) ? "https://placeholder.pics/svg/800" : Model.Image)');"></div>
            <div class="absolute inset-0 bg-black/50 flex items-center justify-center group-hover:bg-black/40 transition-colors cursor-pointer">
                <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur flex items-center justify-center border border-white/20">
                    <span class="material-symbols-outlined text-4xl text-white">play_arrow</span>
                </div>
            </div>
            <div class="absolute bottom-6 left-6 right-6">
                <span class="bg-primary text-background-dark text-xs font-bold px-2 py-1 rounded mb-2 inline-block">PREVIEW CONTENT</span>
                <h3 class="text-xl font-bold text-white">Introduction to @Model.Title</h3>
            </div>
        </div>

        <!-- Learning Path (Timeline) -->
        <div>
            <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Lộ trình học tập chi tiết</h2>
            </div>
            
            <div class="relative timeline-line space-y-8 pl-5">
                @if (Model.CourseSubjects.Any())
                {
                    int index = 1;
                    foreach (var cs in Model.CourseSubjects)
                    {
                        <div class="relative pl-8">
                            <div class="absolute left-0 top-0 w-10 h-10 rounded-full bg-surface-dark border-2 border-primary flex items-center justify-center text-primary font-bold timeline-dot">
                                @index
                            </div>
                            <div class="bg-surface-dark border border-slate-800 rounded-xl p-6 hover:border-primary/50 transition-colors">
                                <span class="text-primary text-xs font-bold uppercase tracking-wider mb-2 block">Giai đoạn @index.ToString("D2")</span>
                                <h3 class="font-display text-xl font-bold mb-3">@cs.Subject?.Name</h3>
                                <p class="text-slate-400 text-sm mb-4">@cs.Subject?.Description</p>
                                
                                @* Display Learning Roadmap *@
                                @if (!string.IsNullOrEmpty(cs.Subject?.LearningRoadmap))
                                {
                                    try 
                                    {
                                        var steps = JsonSerializer.Deserialize<List<string>>(cs.Subject.LearningRoadmap);
                                        if (steps != null && steps.Any())
                                        {
                                            <ul class="space-y-3 mt-4 ml-1 pl-4 border-l border-slate-700">
                                                @{ int stepIndex = 1; }
                                                @foreach (var step in steps)
                                                {
                                                    <li class="text-sm text-slate-300 flex items-start gap-3 relative">
                                                        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/20 text-primary border border-primary/50 flex items-center justify-center text-xs font-bold">@stepIndex</span>
                                                        <span class="mt-0.5">@step</span>
                                                    </li>
                                                    stepIndex++;
                                                }
                                            </ul>
                                        }
                                    }
                                    catch 
                                    { /* Ignore json errors */ }
                                }
                                else
                                {
                                     <div class="w-full bg-slate-800 h-1 rounded-full overflow-hidden mt-2">
                                         <div class="bg-primary h-full" style="width: @(new Random().Next(30, 90))%"></div>
                                     </div>
                                }
                            </div>
                        </div>
                        index++;
                    }
                }
                else
                {
                    <p class="text-slate-500 italic pl-8">Detailed syllabus is being updated.</p>
                }
            </div>
        </div>

        <!-- Instructor Section -->
        <div>
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Giảng viên phụ trách</h2>
            </div>
            
            @if (instructors.Any())
            {
                foreach (var inst in instructors)
                {
                    <div class="bg-surface-dark border border-slate-800 rounded-xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start mb-6 last:mb-0">
                        <div class="w-32 h-32 rounded-xl bg-slate-800 flex-shrink-0 overflow-hidden">
                           <img src="https://ui-avatars.com/api/?name=@(inst.FullName)&background=00c8ff&color=fff&size=128" alt="Instructor" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-display text-2xl font-bold mb-1">@inst.FullName</h3>
                            <p class="text-primary font-bold text-sm mb-4">Course Instructor</p>
                            <p class="text-slate-400 text-sm italic mb-6">"Chuyên gia với nhiều năm kinh nghiệm trong lĩnh vực IT và đào tạo."</p>
                            
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex items-center gap-2">
                                     <span class="material-symbols-outlined text-primary text-lg">work</span>
                                     <div class="text-xs">
                                         <p class="font-bold text-white">Expert</p>
                                         <p class="text-slate-500">Industry Leader</p>
                                     </div>
                                </div>
                                 <div class="flex items-center gap-2">
                                     <span class="material-symbols-outlined text-primary text-lg">verified</span>
                                     <div class="text-xs">
                                         <p class="font-bold text-white">Certified</p>
                                         <p class="text-slate-500">Top Rated</p>
                                     </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                 <p class="text-slate-500 italic">Thông tin giảng viên đang được cập nhật.</p>
            }
        </div>

        <!-- Reviews Section -->
         <div id="reviews">
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Đánh giá & Nhận xét</h2>
            </div>
            
            <div class="bg-surface-dark border border-slate-800 rounded-xl p-8">
                <!-- Summary -->
                <div class="flex flex-col md:flex-row gap-10 items-center mb-10 pb-10 border-b border-slate-800">
                     <div class="text-center">
                         <h3 class="text-5xl font-bold text-white mb-2">@(ViewBag.AverageRating != null ? ((double)ViewBag.AverageRating).ToString("0.0") : "0.0")</h3>
                         <div class="flex text-yellow-500 justify-center mb-2">
                             @{
                                 double avg = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : 0;
                                 for(int i=1; i<=5; i++) {
                                     if(avg >= i) { <span class="material-symbols-outlined text-xl fill-current">star</span> }
                                     else if(avg >= i - 0.5) { <span class="material-symbols-outlined text-xl">star_half</span> }
                                     else { <span class="material-symbols-outlined text-xl">star</span> }
                                 }
                             }
                         </div>
                         <p class="text-slate-400 text-sm">(@(ViewBag.ReviewCount ?? 0) đánh giá)</p>
                     </div>
                     
                     <div class="flex-1 w-full space-y-2">
                         @for(int i=5; i>=1; i--) {
                             var count = Model.CourseReviews.Count(r => r.Rating == i);
                             var total = Model.CourseReviews.Count;
                             var percent = total > 0 ? (count * 100 / total) : 0;
                             
                             <div class="flex items-center gap-3 text-sm">
                                 <span class="w-12 text-slate-400 whitespace-nowrap">@i sao</span>
                                 <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden">
                                     <div class="h-full bg-yellow-500 rounded-full" style="width: @percent%"></div>
                                 </div>
                                 <span class="w-8 text-right text-slate-500">@percent%</span>
                             </div>
                         }
                     </div>
                </div>

                <!-- Review List -->
                <div class="space-y-8">
                    @if (Model.CourseReviews != null && Model.CourseReviews.Any())
                    {
                        foreach (var review in Model.CourseReviews.OrderByDescending(r => r.ReviewDate))
                        {
                             <div class="flex gap-4">
                                <div class="w-12 h-12 rounded-full bg-slate-700 flex-shrink-0 overflow-hidden">
                                    <img src="https://ui-avatars.com/api/?name=@(review.Student?.FullName ?? "User")&background=random" alt="User" class="w-full h-full object-cover">
                                </div>
                                <div>
                                    <h4 class="font-bold text-white mb-1">@(review.Student?.FullName ?? "Unknown User")</h4>
                                    <div class="flex items-center gap-2 mb-2">
                                        <div class="flex text-yellow-500 text-xs">
                                            @for(int r=1; r<=5; r++) {
                                                <span class="material-symbols-outlined text-sm @(r <= review.Rating ? "fill-current" : "")">star</span>
                                            }
                                        </div>
                                        <span class="text-slate-500 text-xs">@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <p class="text-slate-300 text-sm leading-relaxed">@review.ReviewText</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-slate-500 italic">Chưa có đánh giá nào. Hãy là người đầu tiên!</p>
                    }
                </div>

                <!-- Review Form -->
                <div class="mt-12 pt-10 border-t border-slate-800">
                    <h4 class="font-bold text-lg text-white mb-6">Viết đánh giá của bạn</h4>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="PostReview" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-4">
                                <label class="block text-slate-400 text-sm mb-2">Đánh giá của bạn</label>
                                <div class="star-rating-group gap-1 w-fit">
                                    @for(int s=5; s>=1; s--) {
                                        <input type="radio" name="rating" id="rating-star-@s" value="@s" required />
                                        <label for="rating-star-@s" class="material-symbols-outlined text-3xl p-1">star</label>
                                    }
                                </div>
                            </div>
                            <div class="mb-4">
                                <textarea name="reviewText" rows="4" class="w-full bg-background-dark border border-slate-700 rounded-lg p-4 text-white placeholder-slate-500 focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Chia sẻ cảm nhận của bạn về khóa học này..."></textarea>
                            </div>
                            <button type="submit" class="bg-primary text-background-dark font-bold px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">
                                Gửi đánh giá
                            </button>
                        </form>
                    }
                    else
                    {
                         <div class="bg-slate-800/50 rounded-lg p-6 text-center">
                            <p class="text-slate-400 mb-4">Vui lòng đăng nhập để viết đánh giá.</p>
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="inline-block border border-primary text-primary font-bold px-6 py-2 rounded-lg hover:bg-primary hover:text-background-dark transition-all">
                                Đăng nhập ngay
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Schedule Section -->
        <div>
             <div class="flex items-center gap-3 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-display text-2xl font-bold">Lịch khai giảng sắp tới</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-xs font-bold uppercase text-slate-500 border-b border-slate-800">
                            <th class="py-4 px-4">Ngày bắt đầu</th>
                            <th class="py-4 px-4">Lịch học</th>
                            <th class="py-4 px-4">Hình thức</th>
                            <th class="py-4 px-4 text-right">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        @if (scheduleClasses.Any()) {
                            // Placeholder
                        } else {
                             <tr class="border-b border-slate-800/50">
                                <td colspan="4" class="py-4 px-4 text-center text-slate-500 text-xs uppercase">Chưa có lịch khai giảng mới</td>
                             </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Right Column (Sticky Sidebar) -->
    <div class="lg:col-span-1">
        <div class="sticky top-28 space-y-6">
            <!-- Price Card -->
            <div class="bg-surface-dark border border-slate-800 rounded-xl p-6 shadow-xl relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-50">
                    <span class="material-symbols-outlined text-6xl text-slate-700">payments</span>
                </div>
                <div class="relative z-10">
                    <div class="flex items-end gap-2 mb-2">
                        <h2 class="text-3xl font-bold text-white">@Model.TuitionFee.ToString("N0")<span class="text-lg underline align-top">đ</span></h2>
                         <span class="text-slate-500 line-through text-sm mb-1">@( (Model.TuitionFee * 1.2m).ToString("N0") )đ</span>
                    </div>
                    <a asp-controller="Guests" asp-action="Register" class="block w-full text-center bg-primary text-background-dark font-bold py-4 rounded-lg hover:opacity-90 transition-all mb-3 shadow-lg shadow-primary/25">
                        Đăng ký ngay
                    </a>
                </div>
            </div>

            <!-- Consultation Box -->
            <div class="bg-[#0b0f16] border border-slate-800 rounded-xl p-6">
                <p class="text-xs font-bold uppercase text-slate-500 mb-2">Cần tư vấn thêm?</p>
                <div class="flex items-center gap-3 mb-6">
                     <span class="material-symbols-outlined text-primary text-2xl">headset_mic</span>
                     <div>
                         <h4 class="font-bold text-white">Hotline 24/7</h4>
                         <p class="text-primary font-mono">1900 6789</p>
                     </div>
                </div>
                 <button class="w-full border border-slate-700 text-slate-300 font-bold py-3 rounded-lg hover:text-white hover:border-slate-500 transition-all text-sm">
                    Liên hệ qua Zalo
                </button>
            </div>
        </div>
    </div>
</main>

<footer class="pb-24 md:pb-12 pt-16 px-6 border-t border-slate-200 dark:border-slate-800 mt-20 bg-background-light dark:bg-background-dark">
    <div class="max-w-[1600px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-10">
    <div class="col-span-2 md:col-span-1">
    <div class="flex items-center gap-2 mb-6">
    <div class="bg-primary p-1.5 rounded-lg flex items-center justify-center">
    <span class="material-symbols-outlined text-background-dark text-xl font-bold">terminal</span>
    </div>
    <h2 class="font-display text-xl font-bold tracking-tight">IT Academy</h2>
    </div>
    <p class="text-slate-500 text-sm leading-relaxed">
                        Nâng tầm thế hệ kiến trúc sư số và chuyên gia bảo mật với chương trình đào tạo thực chiến.
                    </p>
    </div>
    <div>
    <h5 class="font-bold mb-4 uppercase text-xs tracking-widest text-primary">Tài nguyên</h5>
    <ul class="space-y-3 text-sm text-slate-500">
    <li><a class="hover:text-primary transition-colors" asp-controller="Courses" asp-action="Index">Khóa học</a></li>
    <li><a class="hover:text-primary transition-colors" href="#">Lộ trình nghề nghiệp</a></li>
    <li><a class="hover:text-primary transition-colors" asp-controller="Mentors" asp-action="Index">Giảng viên</a></li>
    <li><a class="hover:text-primary transition-colors" href="#">Học bổng</a></li>
    </ul>
    </div>
    <div>
    <h5 class="font-bold mb-4 uppercase text-xs tracking-widest text-primary">Hỗ trợ</h5>
    <ul class="space-y-3 text-sm text-slate-500">
    <li><a class="hover:text-primary transition-colors" href="#">Câu hỏi thường gặp</a></li>
    <li><a class="hover:text-primary transition-colors" href="#">Liên hệ</a></li>
    <li><a class="hover:text-primary transition-colors" href="#">Điều khoản dịch vụ</a></li>
    <li><a class="hover:text-primary transition-colors" href="#">Chính sách bảo mật</a></li>
    </ul>
    </div>
    <div>
    <h5 class="font-bold mb-4 uppercase text-xs tracking-widest text-primary">Bản tin</h5>
    <div class="flex">
    <input class="w-full bg-slate-200 dark:bg-surface-dark border-none rounded-l-lg text-sm focus:ring-1 focus:ring-primary" placeholder="Email của bạn" type="email"/>
    <button class="bg-primary px-3 rounded-r-lg">
    <span class="material-symbols-outlined text-background-dark">send</span>
    </button>
    </div>
    </div>
    </div>
    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 text-center text-slate-600 dark:text-slate-500 text-xs">
                © 2024 IT Academy. All rights reserved.
            </div>
</footer>

</body>
</html>
