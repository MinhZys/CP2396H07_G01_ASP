@model IEnumerable<Symphony.Portal.Web.Models.Course>
@{
    ViewData["Title"] = "Courses";
    var currentCategories = ViewBag.CurrentCategories as string[];
    var currentLevel = ViewBag.CurrentLevel as string;
    var currentSort = ViewBag.CurrentSort as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

@section Styles {
    <style type="text/tailwindcss">
        .cyber-card {
            border: 1px solid rgba(0, 200, 255, 0.1);
            background: #1e2633;
        }
        .cyber-card:hover {
            border-color: #00c8ff;
            background: rgba(0, 200, 255, 0.05);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #1e2633;
            border-radius: 10px;
        }
    </style>
}

<header class="py-12 border-b border-slate-200 dark:border-slate-800 bg-white/5 -mx-6 md:-mx-8 px-6 md:px-8 mb-8">
    <div class="max-w-[1600px] mx-auto">
        <h1 class="font-display text-4xl font-bold mb-2">Explore <span class="text-primary">Courses</span></h1>
        <p class="text-slate-400 max-w-2xl">Elevate your technical prowess with our industry-aligned curriculum designed by leading experts.</p>
    </div>
</header>

<div class="flex flex-col md:flex-row gap-8">
    <aside class="w-full md:w-64 flex-shrink-0">
        <form method="get" action="@Url.Action("Index")" id="filterForm">
            <div class="sticky top-28 space-y-8">
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-widest text-primary mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">filter_list</span> Categories
                    </h3>
                    <div class="space-y-2">
                        @if (ViewBag.Categories != null)
                        {
                            foreach (string category in ViewBag.Categories)
                            {
                                <label class="flex items-center gap-3 p-2 rounded hover:bg-white/5 cursor-pointer">
                                    <input class="rounded border-slate-700 bg-transparent text-primary focus:ring-primary" type="checkbox" name="categories" value="@category" 
                                        @(currentCategories != null && currentCategories.Contains(category) ? "checked" : "") onchange="this.form.submit()" />
                                    <span class="text-sm">@category</span>
                                </label>
                            }
                        }
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-widest text-primary mb-4">Level</h3>
                    <div class="space-y-2">
                        @foreach (var level in Enum.GetNames(typeof(Symphony.Portal.Web.Models.Enums.CourseLevel)))
                        {
                            <label class="flex items-center gap-3 p-2 rounded hover:bg-white/5 cursor-pointer">
                                <input class="border-slate-700 bg-transparent text-primary focus:ring-primary" name="level" type="radio" value="@level" 
                                    @(currentLevel == level ? "checked" : "") onchange="this.form.submit()" />
                                <span class="text-sm">@level</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="pt-6 border-t border-slate-800">
                    <a href="@Url.Action("Index")" class="block w-full text-center py-3 bg-white/5 border border-white/10 rounded-lg text-sm font-bold hover:bg-white/10 transition-all">
                        Reset Filters
                    </a>
                </div>
            </div>
            <input type="hidden" name="sort" value="@currentSort" />
        </form>
    </aside>

    <div class="flex-grow">
        <div class="flex items-center justify-between mb-8">
            <span class="text-sm text-slate-500">Showing @Model.Count() courses</span>
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase text-slate-500">Sort By:</span>
                <form method="get" action="@Url.Action("Index")" style="display:inline;">
                    @if(currentCategories != null) { foreach(var c in currentCategories) { <input type="hidden" name="categories" value="@c" /> } }
                    @if(!string.IsNullOrEmpty(currentLevel)) { <input type="hidden" name="level" value="@currentLevel" /> }
                    <select name="sort" class="bg-surface-dark border-none text-sm rounded-lg focus:ring-primary py-1 pr-8" onchange="this.form.submit()">
                        <!option value="Most Popular" @(currentSort == "Most Popular" ? "selected" : "")>Most Popular</!option>
                        <!option value="Newest" @(currentSort == "Newest" ? "selected" : "")>Newest</!option>
                        <!option value="Price: Low to High" @(currentSort == "Price: Low to High" ? "selected" : "")>Price: Low to High</!option>
                        <!option value="Price: High to Low" @(currentSort == "Price: High to Low" ? "selected" : "")>Price: High to Low</!option>
                    </select>
                </form>
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

        @foreach (var item in Model) {
            <div class="cyber-card rounded-xl overflow-hidden group transition-all duration-300 hover:-translate-y-1 cursor-pointer" onclick="window.location.href='@Url.Action("Details", "Courses", new { id = item.Id })'">
                <div class="relative aspect-video overflow-hidden">
                    <div class="absolute inset-0 bg-cover bg-center group-hover:scale-105 transition-transform duration-500" style="background-image: url('@(string.IsNullOrEmpty(item.Image) ? "https://placeholder.pics/svg/400" : item.Image)');"></div>
                    <div class="absolute top-3 left-3 bg-background-dark/80 backdrop-blur-md px-2 py-1 rounded text-[10px] font-bold text-primary uppercase">@(item.Category?.Name ?? "Course")</div>
                </div>
                <div class="p-4">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="font-display font-bold text-base group-hover:text-primary transition-colors leading-tight">@item.Title</h3>
                    </div>
                    
                    @* Rating Section *@
                    <div class="flex items-center gap-2 mb-3">
                         <div class="flex text-yellow-500 text-xs">
                             @{
                                 var avgRating = item.CourseReviews.Any() ? item.CourseReviews.Average(r => r.Rating) : 0;
                                 var reviewCount = item.CourseReviews.Count;
                                 
                                 for(int i=1; i<=5; i++) {
                                     if(avgRating >= i) { <span class="material-symbols-outlined text-sm fill-current">star</span> }
                                     else if(avgRating >= i - 0.5) { <span class="material-symbols-outlined text-sm">star_half</span> }
                                     else { <span class="material-symbols-outlined text-sm text-slate-600">star</span> }
                                 }
                             }
                        </div>
                        <span class="text-xs text-slate-500">(@reviewCount)</span>
                    </div>

                    <p class="text-slate-400 text-xs mb-4 line-clamp-2">@item.Description</p>
                    <div class="flex items-center justify-between pt-3 border-t border-slate-800/50">
                        <span class="text-primary font-bold">$@item.TuitionFee.ToString("N0")</span>
                        <div class="flex items-center gap-1">
                            <span class="material-symbols-outlined text-slate-500 text-xs">bar_chart</span>
                            <span class="text-[10px] text-slate-500 uppercase">@item.Level</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        </div>
        <div class="mt-12 flex justify-center gap-2">
            @if (totalPages > 1) {
                for (int i = 1; i <= totalPages; i++) {
                     <a href="@Url.Action("Index", new { page = i, sort = currentSort, level = currentLevel, categories = currentCategories })" 
                        class="w-10 h-10 rounded-lg flex items-center justify-center border border-slate-800 @(i == currentPage ? "bg-surface-dark text-primary" : "hover:bg-white/5 transition-colors")">
                        @i
                     </a>
                }
            }
        </div>
    </div>
</div>
