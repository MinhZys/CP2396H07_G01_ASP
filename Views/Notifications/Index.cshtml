@model List<Symphony.Portal.Web.Models.Notification>
@{
    ViewData["Title"] = "Thông báo của tôi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🔔 Thông báo</h2>
        <form asp-action="MarkAllAsRead" method="post">
            <button type="submit" class="btn btn-outline-primary btn-sm">Đánh dấu tất cả đã đọc</button>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action @(item.IsRead ? "bg-light text-muted" : "fw-bold")" onclick="markAsRead(@item.Id, this)">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@item.Title</h5>
                        <small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <p class="mb-1">@item.Message</p>
                    @if (!item.IsRead)
                    {
                        <small class="text-primary status-text">Mới</small>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Bạn chưa có thông báo nào.
        </div>
    }
</div>

@section Scripts {
    <script>
        function markAsRead(id, element) {
