@model Symphony.Portal.Web.Models.ViewModels.AboutFaqViewModel

@{
    ViewData["Title"] = Model.AboutPage.Title;
    Layout = "_Layout";
}

<header class="py-12 border-b border-slate-200 dark:border-slate-800 bg-white/5 -mx-6 md:-mx-8 px-6 md:px-8 mb-10">
    <div class="max-w-[1600px] mx-auto">
        <h1 class="font-display text-4xl font-bold mb-2 text-slate-100">@Model.AboutPage.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model.AboutPage.FeaturedImage))
        {
            <img src="@Model.AboutPage.FeaturedImage"
                 alt="@Model.AboutPage.Title"
                 class="mt-6 w-full rounded-2xl object-cover"
                 style="max-height:420px;" />
        }
    </div>
</header>

<div class="max-w-5xl mx-auto space-y-14 px-4 md:px-0">

    <!-- ABOUT -->
    <section class="space-y-6">
        <div class="prose-wrapper max-w-none">
            @Html.Raw(Model.AboutPage.Content)
        </div>
    </section>

    <!-- FAQ -->
    <section class="space-y-6">
        <div class="flex items-end justify-between gap-4">
            <h2 class="font-display text-2xl font-bold text-slate-100">FAQ</h2>
            <p class="text-sm text-slate-400">Frequently Asked Questions</p>
        </div>

        @if (Model.FAQs == null || !Model.FAQs.Any())
        {
            <div class="text-slate-400">No questions have been asked yet..</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var f in Model.FAQs)
                {
                    <!-- chuyển class cyber-card lên details để đè nền trắng triệt để -->
                    <details class="cyber-card">
                        <summary class="faq-summary">
                            <span>@f.Question</span>
                            <span class="faq-icon material-symbols-outlined text-primary">expand_more</span>
                        </summary>

                        <div class="faq-answer">
                            @Html.Raw(Html.Encode(f.Answer ?? "").Replace("\r\n", "\n").Replace("\n", "<br />"))
                        </div>
                    </details>
                }
            </div>
        }
    </section>

</div>

<style>
    /* NỀN ĐEN TOÀN TRANG */
    body {
        background: #020617 !important;
    }

    /* ABOUT CONTENT: GIỮ XUỐNG DÒNG */
    .prose-wrapper {
        white-space: pre-wrap;
        line-height: 1.75;
        color: #cbd5f5;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /* FAQ CARD: NỀN ĐEN + BORDER CYBER */
    details.cyber-card {
        background: #020617 !important;
        border: 1px solid rgba(34, 211, 238, 0.22) !important;
        border-radius: 16px !important;
        padding: 12px 12px !important;
        box-shadow: 0 18px 40px rgba(0,0,0,.55) !important;
        color: #e5e7eb !important;
        overflow: hidden;
    }

        /* SUMMARY */
        details.cyber-card > summary.faq-summary {
            cursor: pointer;
            list-style: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 18px;
            padding: 10px 10px !important;
            margin: 0 !important;
            color: #e5e7eb !important;
            background: transparent !important;
        }

            details.cyber-card > summary.faq-summary::-webkit-details-marker {
                display: none;
            }

    /* ICON XOAY */
    .faq-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid rgba(34,211,238,0.35);
        background: rgba(34,211,238,0.12);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform .15s ease;
        flex: 0 0 auto;
    }

    details[open] .faq-icon {
        transform: rotate(180deg);
    }

    /* ANSWER: GIỮ XUỐNG DÒNG + CHỐNG TRÀN */
    .faq-answer {
        margin-top: 10px !important;
        padding: 0 10px 12px !important;
        color: #cbd5f5 !important;
        line-height: 1.8;
        white-space: pre-wrap !important;
        overflow-wrap: anywhere !important;
        word-break: break-word !important;
        background: transparent !important;
    }
</style>
