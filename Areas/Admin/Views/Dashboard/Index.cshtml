@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>Admin Dashboard</h1>
            <p class="lead">Welcome, Administrator! Manage your system below.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary"><i class="bi bi-book"></i> Courses</h5>
                    <p class="card-text">Manage training courses, tuition fees, and descriptions.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">Manage Courses</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body text-center">
                    <h5 class="card-title text-success"><i class="bi bi-file-earmark-text"></i> Admission Exams</h5>
                    <p class="card-text">Schedule entrance exams and manage fees.</p>
                    <a asp-controller="AdmissionExams" asp-action="Index" class="btn btn-success">Manage Exams</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-warning">
                <div class="card-body text-center">
                    <h5 class="card-title text-warning"><i class="bi bi-people"></i> Users & Classes</h5>
                    <p class="card-text">Manage students, instructors, and class assignments.</p>
                    <a href="#" class="btn btn-warning disabled">Coming Soon</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
         <a asp-action="Logout" asp-controller="Account" asp-area="" class="btn btn-danger">Sign Out</a>
    </div>
</div>
